{
  "_comment": [
    "來源資料沒有開放時間、但館方官網有公告的場館。每一組都附官網網址與查核日期，",
    "頁面會把出處與查核日期一起印出來；館方改了時間就要回來改這裡。",
    "match 是對場館名稱的正規表示式（整個名稱要吻合），exceptions 以完整場館名稱覆蓋。",
    "只收館方公告的一般時段；國定假日、選舉日等休館日寫進 text，不寫進 spec。",
    "ingest/venue-hours.mjs 有解析器的規則每週自動重查（ops/refresh-venue-hours.sh）；失敗時保留舊值、寫 source.stale。"
  ],
  "rules": [
    {
      "id": "taichung-city-library",
      "match": "^臺中市立圖書館[^-－]+(?:分館|親子館)$",
      "city": "臺中市",
      "source": {
        "name": "臺中市立圖書館官網「開放時間」",
        "url": "https://www.library.taichung.gov.tw/content/index?Parser=1%2C3%2C72%2C32",
        "checkedAt": "2026-09-27"
      },
      "default": {
        "text": "週二至週六 08:30-21:00\n週日 08:30-17:30\n週一、國定假日、選舉日、公民投票日休館",
        "spec": [
          { "days": ["Tu", "We", "Th", "Fr", "Sa"], "opens": "08:30", "closes": "21:00" },
          { "days": ["Su"], "opens": "08:30", "closes": "17:30" }
        ]
      },
      "exceptions": {
        "臺中市立圖書館大墩分館": {
          "text": "週二至週日 08:30-21:00\n週一、國定假日、選舉日、公民投票日休館（部分國定假日配合文化中心開館）",
          "spec": [{ "days": ["Tu", "We", "Th", "Fr", "Sa", "Su"], "opens": "08:30", "closes": "21:00" }]
        },
        "臺中市立圖書館大肚瑞井分館": { "ref": "short" },
        "臺中市立圖書館石岡分館": { "ref": "short" },
        "臺中市立圖書館梧棲親子館": { "ref": "short" },
        "臺中市立圖書館新社分館": { "ref": "short" },
        "臺中市立圖書館龍井山頂分館": { "ref": "short" },
        "臺中市立圖書館龍井龍津分館": { "ref": "short" },
        "臺中市立圖書館豐原南嵩分館": {
          "text": "週二至週日 08:30-12:30、13:30-17:30\n週一、國定假日、選舉日、公民投票日休館",
          "spec": [
            { "days": ["Tu", "We", "Th", "Fr", "Sa", "Su"], "opens": "08:30", "closes": "12:30" },
            { "days": ["Tu", "We", "Th", "Fr", "Sa", "Su"], "opens": "13:30", "closes": "17:30" }
          ]
        }
      },
      "variants": {
        "short": {
          "text": "週二至週日 08:30-17:30\n週一、國定假日、選舉日、公民投票日休館",
          "spec": [{ "days": ["Tu", "We", "Th", "Fr", "Sa", "Su"], "opens": "08:30", "closes": "17:30" }]
        }
      }
    }
  ]
}
