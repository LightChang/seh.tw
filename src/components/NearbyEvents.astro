---
// 活動頁的「同場地／同縣市近期活動」（資料由 src/lib/nearby-events.mjs 挑好）。
import { catVar } from '../lib/format.mjs';
import { leadText } from '../lib/day-lists.mjs';
const { items, city, venueName, now } = Astro.props;
const onlyVenue = items.every((d) => d.near === 'venue');
const heading = onlyVenue && venueName ? `${venueName}近期活動` : city ? `${city}近期活動` : '近期活動';
---
{items.length > 0 && (
  <section class="nearby">
    <h2 class="h-near">{heading}</h2>
    <ol class="ev-list">
      {items.map((d) => (
        <li><a href={`/event/${d.slug}`}>
          <time class="ev-lead tabular" datetime={d.at}>{leadText(d, now)}</time>
          <span class="ev-body"><span class="ev-t">{d.title}{d.isFree === true && <span class="tag-free">免費</span>}</span>
            {d.venue && <span class="ev-m">{d.near === 'venue' ? d.venue : [d.district, d.venue].filter(Boolean).join('　')}</span>}</span>
          <span class="ev-cat" data-cat={d.cat || ''} style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>
        </a></li>
      ))}
    </ol>
    {city && <p class="more-near"><a href={`/city/${city}`}>{city}所有近期活動</a></p>}
  </section>
)}
<style>
  .nearby { margin-top: var(--space-8); }
  .h-near { font-family: var(--font-body); font-size: var(--text-lg); font-weight: 800; color: var(--text-primary);
            border-top: 2px solid var(--seh-ink); padding-top: var(--space-3); }
  .nearby .ev-list { margin: var(--space-4) 0 0; }
  .more-near { margin-top: var(--space-4); font-size: var(--text-sm); }
  .more-near a { color: var(--color-link); text-decoration: none; font-weight: 700; }
</style>
