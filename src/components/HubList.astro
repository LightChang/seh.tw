---
// 搜尋需求頁（/weekend、/free）的活動列。欄位與全站 .ev-list 一致：第一欄時間、中間標題與場地、右邊類型；
// 來源標了免費的另外標出來。行數上限由頁面決定，這裡照給的列全部印。
import { catVar } from '../lib/format.mjs';
interface Row { slug: string; title: string; cat?: string; venue?: string; district?: string; city?: string; isFree?: boolean; at: string }
// 手機上只先顯示前 6 列，其餘按「顯示更多」才展開（內容仍在 HTML 裡，搜尋引擎看得到）。
// 「這週末」「免費」這類頁一組十幾列、好幾組，手機上整頁要捲三萬 px。
interface Props { rows: Row[]; lead: (r: Row) => string; showCity?: boolean; showCat?: boolean }
const { rows, lead, showCity = false, showCat = true } = Astro.props;
const fold = 6;   // 與 site.css 的 li:nth-child(n+7) 對應
const folded = rows.length > fold + 2;
---
<ol class="ev-list" data-fold={folded ? fold : undefined}>
  {rows.map((d) => (
    <li><a href={`/event/${encodeURIComponent(d.slug)}`}>
      <time class="ev-lead tabular" datetime={d.at}>{lead(d)}</time>
      <span class="ev-body"><span class="ev-t">{d.title}{d.isFree === true && <span class="tag-free">免費</span>}</span>
        <span class="ev-m">{[d.venue, showCity ? d.city : d.district].filter(Boolean).join('　')}</span></span>
      <span class="ev-side">
        {showCat && d.cat && <span class="ev-cat" data-cat={d.cat || ''} style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>}
      </span>
    </a></li>
  ))}
</ol>
{folded && <button type="button" class="fold-btn" data-fold-btn>顯示另外 {rows.length - fold} 個</button>}
<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-fold-btn]')) {
    b.addEventListener('click', () => { b.previousElementSibling?.removeAttribute('data-fold'); b.remove(); });
  }
</script>
<style>
  .ev-side { display: inline-flex; gap: 0.8rem; align-items: baseline; }
</style>
