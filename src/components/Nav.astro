---
const { current } = Astro.props;
const items = [
  { k: 'today', label: '今天', href: '/today' },
  { k: 'tonight', label: '今晚', href: '/tonight' },
  { k: 'weekend', label: '這週末', href: '/weekend' },
  { k: 'free', label: '免費活動', href: '/free' },
  { k: 'city', label: '縣市', href: '/city' },
  { k: 'venues', label: '場館', href: '/venues' },
  { k: 'heritage', label: '文化資產', href: '/heritage' },
  { k: 'nearby', label: '附近', href: '/nearby' },
  { k: 'map', label: '地圖', href: '/map' },
  { k: 'search', label: '搜尋', href: '/search' },
];
---
<nav class="nav" aria-label="主要導覽">
  <a class="brand" href="/">seh<span>.tw</span></a>
  <ul>
    {items.map((i) => (
      <li><a href={i.href} class={current === i.k ? 'on' : ''} aria-current={current === i.k ? 'page' : undefined}>{i.label}</a></li>
    ))}
  </ul>
</nav>
<style>
  /* 導覽固定在頂端：列表頁動輒幾十列，捲下去之後還要找得到「今晚／這週末／地圖」。
     底色不透明，捲動的內容從下面過去時不會透出來。 */
  .nav {
    position: sticky; top: 0; z-index: 40;
    display: flex; align-items: center; gap: var(--space-6);
    background: var(--bg-base);
    border-bottom: 2px solid var(--seh-ink);
  }
  .brand { font-family: var(--font-display); font-weight: 800; font-size: var(--text-lg);
           text-decoration: none; letter-spacing: -0.01em; flex: none; }
  .brand span { color: var(--seh-terracotta); font-weight: 400; }
  .nav ul { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); list-style: none; margin: 0; padding: 0; }
  .nav ul a {
    display: flex; align-items: center; min-height: 56px;
    text-decoration: none; font-size: var(--text-sm); font-weight: 600; color: var(--text-secondary);
    border-bottom: 4px solid transparent; margin-bottom: -2px; padding-top: 4px;
  }
  .nav ul a:hover { color: var(--color-link); border-bottom-color: var(--border-subtle); }
  /* 目前所在的區塊：粗底線＋主色，一眼看得出「我在哪」 */
  .nav ul a.on { color: var(--color-link); font-weight: 800; border-bottom-color: var(--color-link); }
  /* 手機上換行會疊成三排、吃掉約四分之一個首屏；改成一排可橫向滑動 */
  @media (max-width: 760px) {
    .nav { gap: var(--space-4); }
    .nav ul { flex-wrap: nowrap; gap: var(--space-4); min-width: 0; overflow-x: auto; scrollbar-width: none; }
    .nav ul::-webkit-scrollbar { display: none; }
    .nav li { flex: none; }
    .nav ul a { min-height: 48px; }
  }
</style>
