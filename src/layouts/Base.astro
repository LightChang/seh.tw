---
import '../styles/site.css';
import { GA_MEASUREMENT_ID, GA_HOSTS, GSC_VERIFICATION } from '../site.config.mjs';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbList } from '../lib/jsonld/index.mjs';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonical?: string;
  /** 本頁的 JSON-LD 節點（src/lib/jsonld 產生），可為單一物件或陣列 */
  jsonld?: object | object[] | null;
  /** crumbTrail() 的結果；同一份交給 <Breadcrumb>，這裡輸出 BreadcrumbList */
  breadcrumbs?: { name: string; href?: string }[];
}
const { title, description, noindex = false, canonical, jsonld, breadcrumbs } = Astro.props;
const ldNodes = [...[jsonld ?? []].flat(), breadcrumbList(breadcrumbs)];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
// build.format 是 'file'，Astro.url.pathname 會帶 `.html`（首頁是 `/index.html`）。
// 對外網址不帶副檔名，canonical 與 og:url 要拿掉。
const pathname = Astro.url.pathname.replace(/(?:^\/index)?\.html$/, '') || '/';
const url = canonical ?? `${site}${pathname}`;
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />

    <!-- favicon.ico 給預設就去要 /favicon.ico 的舊瀏覽器與 RSS 閱讀器，裡面 16px 是簡化版 -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- 跟頁面底色（--bg-base 的 fallback）一致；原本的深藍會在手機網址列畫出一條不搭的深色帶 -->
    <meta name="theme-color" content="#f5f6f8" />

    <!-- 不載網路字型：全用系統字（src/styles/site.css 的 --font-*）。
         原本的 Google Fonts CSS 是一個擋渲染的外部請求，而 Archivo 沒有中文字，標題實際上一直是中文字型在撐。 -->

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="zh_TW" />

    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    <JsonLd nodes={ldNodes} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    {GA_MEASUREMENT_ID && (
      <script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, gaHosts: GA_HOSTS }}>
        // 主機名對不上就什麼都不做——連 gtag.js 的請求都不發出去
        if (gaHosts.indexOf(location.hostname) !== -1) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', gaId);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          // 目標事件：帶 data-goal 的連結被點時送出，比 GA 自動的外連 click 準（那個連頁尾連結也算）
          document.addEventListener('click', function (ev) {
            var a = ev.target.closest && ev.target.closest('[data-goal]');
            if (a) window.gtag('event', a.dataset.goal, { method: a.dataset.method, link_url: a.href, transport_type: 'beacon' });
          });
        }
      </script>
    )}
  </body>
</html>
