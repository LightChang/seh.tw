---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubList from '../../components/HubList.astro';
import { crumbTrail, eventItemList } from '../../lib/jsonld/index.mjs';
import { catVar, fmtNum, WD } from '../../lib/format.mjs';
import { iconSvg, catIcon } from '../../lib/icons.mjs';
import { flatSessions, builtHubs, builtCatCities, indexableEvent } from '../../lib/build-data.mjs';
import { weekendOf, nextWeekendOf, eventsIn, weekendLead, groupByCat, titleWords, cityShort } from '../../lib/hubs.mjs';

// 「週末活動 台北」這類搜尋：/weekend 是全台，/weekend/<縣市> 是單一縣市。網址固定，
// 內容是 build 當下的「這週末」（週六、週日當天就是本週末），每次建置重算日期與清單。
// 建頁的縣市與縣市頁相同（builtHubs），週末場次少時照樣建，改帶下週末預覽並 noindex。
export async function getStaticPaths() {
  const { weekend } = await builtHubs();
  return [{ params: { city: undefined }, props: { city: '' } },
    ...weekend.map((city) => ({ params: { city }, props: { city } }))];
}
const { city } = Astro.props;
const buildNow = Date.now();
const all = await flatSessions();
const rows = city ? all.filter((d) => d.city === city) : all;
const keep = await indexableEvent();
const wk = weekendOf(buildNow), nx = nextWeekendOf(buildNow);
const list = eventsIn(rows, wk.from, wk.to, keep);
const next = eventsIn(rows, nx.from, nx.to, keep);
const groups = groupByCat(list);
const hubs = await builtHubs();
const catCities = await builtCatCities();
const place = city ? cityShort(city) : '全台';
const words = titleWords(list);
const freeN = list.filter((e) => e.isFree === true).length;
const fresh = list.filter((e) => !e.running).length;
// 兩個週末加起來不到 5 個活動就不請搜尋引擎收錄：頁面照樣在（縣市頁會連），但內容太薄
const thin = list.length + next.length < 5;
const CAP = city ? 30 : 15;

const title = city
  ? `${place}這週末有什麼活動（${wk.label}）｜${(words.length ? words : ['展覽', '演出']).join('、')}`
  : `這週末有什麼活動（${wk.label}）｜全台${(words.length ? words : ['展覽', '演出']).join('、')}`;
const description = `${wk.label} 週末${city ? city : '全台'}有 ${list.length} 個活動`
  + (groups.length ? `：${groups.slice(0, 4).map(([c, l]) => `${c} ${l.length}`).join('、')}` : '')
  + (freeN ? `，其中 ${freeN} 個免費` : '') + '。依類型分組，附時間與場地，每天更新。';
const trail = city
  ? crumbTrail([{ name: '這週末', href: '/weekend' }], `${place}這週末`)
  : crumbTrail([], '這週末');
// ItemList：畫面上列出來的活動（每組前 CAP 個），依組別順序
const shown = groups.flatMap(([, l]) => l.slice(0, CAP));
const ld = eventItemList(shown.slice(0, 100), `${wk.sat} 至 ${wk.sun} ${city || '台灣'}的文化活動`);
const catHref = (c) => (city ? (catCities.has(`${c}|${city}`) ? `/category/${c}/${city}` : `/city/${city}`) : `/category/${c}`);
const cityCounts = city ? [] : [...list.reduce((m, e) => (e.city ? m.set(e.city, (m.get(e.city) ?? 0) + 1) : m), new Map())]
  .filter(([c]) => hubs.weekend.includes(c)).sort((a, b) => b[1] - a[1]);
const yearLinks = hubs.year.filter((p) => p.year === hubs.thisYear && (city ? p.city === city : !p.city));
// 日曆撕頁用：月、日、星期分開
const calDay = (t) => { const d = new Date(`${t}T12:00:00+08:00`); return { m: d.getUTCMonth() + 1, d: d.getUTCDate(), w: WD[d.getUTCDay()] }; };
const gid = (i) => `g${i}`;
const day = (t) => `${+t.slice(5, 7)}/${+t.slice(8)}（${WD[new Date(`${t}T12:00:00+08:00`).getUTCDay()]}）`;
---
<Base title={title} description={description} breadcrumbs={trail} jsonld={ld} noindex={thin}>
  <div class="shell">
    <Nav current="weekend" />
    <header class="wk-hd">
      <Breadcrumb trail={trail} />
      <div class="wk-top">
        <div class="wk-title">
          <p class="kicker">週末不無聊</p>
          <h1>{place}這週末</h1>
          <p class="sub">{day(wk.sat)}–{day(wk.sun)}　<strong class="tabular">{fmtNum(list.length)}</strong> 個活動</p>
        </div>
        <div class="cal" aria-hidden="true">
          {[wk.sat, wk.sun].map((t) => { const c = calDay(t); return (
            <span class="cal-page"><span class="cal-m">{c.m} 月</span><span class="cal-d tabular">{c.d}</span><span class="cal-w">週{c.w}</span></span>
          ); })}
        </div>
      </div>

      {list.length > 0 && (
        <ul class="stats">
          <li class="stat main"><span class="stat-ico" set:html={iconSvg('compass')} /><b class="tabular">{fmtNum(list.length)}</b><span>個活動</span></li>
          <li class="stat"><span class="stat-ico" set:html={iconSvg('calendar')} /><b class="tabular">{fmtNum(fresh)}</b><span>週末當天開始</span></li>
          <li class="stat"><span class="stat-ico" set:html={iconSvg('frame')} /><b class="tabular">{fmtNum(list.length - fresh)}</b><span>展期中，週末看得到</span></li>
          <li class="stat free"><a href={city && !hubs.free.has(city) ? '/free' : city ? `/free/${city}` : '/free'}><span class="stat-ico" set:html={iconSvg('gift')} /><b class="tabular">{fmtNum(freeN)}</b><span>免費 →</span></a></li>
        </ul>
      )}
      <p class="lead">
        {list.length
          ? <>{fresh ? `週末當天開始的有 ${fresh} 個` : '週末當天開始的場次還沒有收錄'}{list.length - fresh ? `，展期跨到週末、週末去看得到的有 ${list.length - fresh} 個（少數週六就結束，清單會標「展至週六」）` : ''}{freeN ? `；來源標示免費的 ${freeN} 個` : ''}。</>
          : <>這個週末{city || '全台'}還沒有收錄到活動，下面先列下週末的。</>}
      </p>
    </header>

    {cityCounts.length > 0 && (
      <section class="cities" aria-labelledby="city-h">
        <h2 class="mini-h" id="city-h">依縣市</h2>
        <p class="rowlinks">{cityCounts.map(([c, n], i) => <a class={i < 3 ? 'top' : ''} href={`/weekend/${c}`}>{cityShort(c)}<b class="tabular">{n}</b></a>)}</p>
      </section>
    )}

    {groups.length > 1 && (
      <nav class="jump" aria-label="依類型跳到">
        {groups.map(([c, l], i) => <a href={`#${gid(i)}`} class="jump-a"><span data-cat={c} style={`color:var(${catVar(c)})`}>{c}</span><b class="tabular">{l.length}</b></a>)}
      </nav>
    )}

    {groups.map(([c, l], i) => (
      <section class="grp" id={gid(i)}>
        <h2 class="grp-h">
          <span class="grp-ico" style={`color:var(${catVar(c)})`} set:html={iconSvg(catIcon(c))} />
          <span>{c}</span><span class="tabular badge">{l.length}</span>
        </h2>
        <HubList rows={l.slice(0, CAP)} lead={weekendLead} showCity={!city} showCat={false} />
        {l.length > CAP && <p class="more">另有 {l.length - CAP} 個，<a href={catHref(c)}>看全部{c}</a></p>}
      </section>
    ))}

    {next.length > 0 && (
      <section class="grp">
        <h2 class="grp-h">
          <span class="grp-ico" set:html={iconSvg('calendar')} />
          <span>下週末 {day(nx.sat)}–{day(nx.sun)}</span><span class="tabular badge">{next.length}</span>
        </h2>
        <HubList rows={next.filter((e) => !e.running).slice(0, 12)} lead={weekendLead} showCity={!city} />
        {next.filter((e) => e.running).length > 0 && <p class="more">另有 {next.filter((e) => e.running).length} 個展期中的活動下週末也看得到。</p>}
      </section>
    )}

    <nav class="also" aria-label="相關頁面">
      {city && <a href={`/city/${city}`}>{city}所有近期活動</a>}
      {(city ? hubs.free.has(city) : true) && <a href={city ? `/free/${city}` : '/free'}>{place}免費活動</a>}
      {yearLinks.map((p) => <a href={`/year/${p.year}/${p.group.key}${city ? `/${city}` : ''}`}>{p.year} {place === '全台' ? '' : place}{p.group.label}時間表</a>)}
      {city && <a href="/weekend">全台這週末</a>}
      {city && <a href={`/today/${city}`}>{place}今天</a>}
      <a href="/today">今天</a>
    </nav>
  </div>
</Base>
<style>
  /* 頁首：標題＋日曆撕頁 */
  .wk-hd { padding-block: var(--space-5) var(--space-4); }
  .wk-top { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-6); margin-top: var(--space-4); }
  .kicker { color: var(--seh-coral-deep); }
  .wk-title h1 { margin-top: var(--space-2); font-size: var(--text-3xl); letter-spacing: -0.02em; }
  .wk-title .sub { margin-top: var(--space-2); color: var(--text-secondary); font-size: var(--text-sm); }
  .wk-title .sub strong { font-size: var(--text-lg); color: var(--text-primary); }
  .cal { display: flex; gap: var(--space-3); flex: none; }
  .cal-page {
    display: grid; justify-items: center; width: 7.5rem; overflow: hidden;
    background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow);
  }
  .cal-page:first-child { transform: rotate(-3deg); }
  .cal-page:last-child { transform: rotate(2deg); }
  .cal-m { width: 100%; text-align: center; padding: 0.3em 0; background: var(--seh-coral); color: var(--seh-ink); font-size: var(--text-xs); font-weight: 800; }
  .cal-d { font-size: var(--text-2xl); font-weight: 800; line-height: 1.15; color: var(--seh-forest); }
  .cal-w { padding-bottom: 0.4em; font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); }

  /* 四格數字 */
  .stats { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
  .stat, .stat a { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto; column-gap: var(--space-3); align-items: center; }
  .stat { padding: var(--space-4); border-radius: var(--seh-radius); background: var(--seh-card); box-shadow: var(--seh-shadow); }
  .stat.free { padding: 0; }
  .stat a { height: 100%; padding: var(--space-4); border-radius: var(--seh-radius); text-decoration: none; color: inherit; transition: background-color 0.15s; }
  .stat a:hover { background: var(--seh-forest-weak); }
  .stat-ico { grid-row: 1 / 3; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--bg-surface); color: var(--seh-forest); }
  .stat-ico :global(svg) { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .stat b { font-size: var(--text-xl); font-weight: 800; line-height: 1.1; }
  .stat span:not(.stat-ico) { font-size: var(--text-xs); color: var(--text-secondary); }
  .stat.main { background: var(--seh-forest); color: var(--seh-card); }
  .stat.main .stat-ico { background: oklch(1 0 0 / 0.14); color: var(--seh-sun); }
  .stat.main span:not(.stat-ico) { color: var(--seh-forest-weak); }
  .stat.free .stat-ico { background: var(--seh-forest-weak); }
  .lead { margin-top: var(--space-4); font-size: var(--text-xs); color: var(--text-muted); max-width: var(--measure); }

  /* 縣市 */
  .cities { margin-top: var(--space-6); }
  .mini-h { font-family: var(--font-body); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.06em; color: var(--text-secondary); }
  .rowlinks { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); max-width: none; }
  .rowlinks a {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.5rem 0 1rem;
    text-decoration: none; font-size: var(--text-xs); font-weight: 700;
    background: var(--seh-card); border: var(--hairline) solid var(--border-subtle); border-radius: 999px; transition: border-color 0.15s;
  }
  .rowlinks a:hover { border-color: var(--seh-ink); }
  .rowlinks b { min-width: 2.2em; padding: 0.1em 0.5em; border-radius: 999px; text-align: center; font-weight: 700; background: var(--bg-surface); color: var(--text-secondary); }
  .rowlinks a.top { border-color: var(--seh-forest); }
  .rowlinks a.top b { background: var(--seh-forest); color: var(--seh-card); }

  /* 類型捷徑：捲動時固定在導覽列下方 */
  .jump {
    position: sticky; top: 61px; z-index: 30; display: flex; gap: var(--space-2); overflow-x: auto; scrollbar-width: none;
    margin: var(--space-6) calc(-1 * var(--space-2)) 0; padding: var(--space-3) var(--space-2);
    background: var(--bg-base); border-bottom: var(--hairline) solid var(--border-subtle);
  }
  .jump::-webkit-scrollbar { display: none; }
  .jump-a {
    flex: none; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.9rem;
    text-decoration: none; font-size: var(--text-xs); font-weight: 700; white-space: nowrap;
    background: var(--seh-card); border-radius: 999px; box-shadow: var(--seh-shadow);
  }
  .jump-a b { font-weight: 600; color: var(--text-muted); }
  .grp { margin-top: var(--space-7); scroll-margin-top: 140px; }
  .grp-h {
    display: flex; align-items: center; gap: var(--space-3); padding-top: var(--space-4);
    border-top: 2px solid var(--seh-ink); font-family: var(--font-body); font-size: var(--text-lg); font-weight: 800;
  }
  .grp-ico { display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--seh-radius-sm); background: var(--seh-card); box-shadow: var(--seh-shadow); color: var(--seh-forest); }
  .grp-ico :global(svg) { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .badge { padding: 0.1em 0.7em; border-radius: 999px; background: var(--seh-coral-weak); color: var(--seh-coral-deep); font-size: var(--text-xs); font-weight: 800; }
  .grp .ev-list { margin: var(--space-3) 0 var(--space-4); }
  .more { font-size: var(--text-sm); color: var(--text-muted); }
  .more a { color: var(--seh-forest); font-weight: 700; }
  .also { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin: var(--space-8) 0 var(--space-9);
          padding-top: var(--space-5); border-top: var(--hairline) solid var(--border-subtle); font-size: var(--text-sm); }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .wk-top { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .wk-title h1 { font-size: var(--text-2xl); }
    .cal-page { width: 5.5rem; }
    .cal-d { font-size: var(--text-xl); }
    .stat { padding: var(--space-3); }
    .stat a { padding: var(--space-3); }
    .stat-ico { width: 40px; height: 40px; }
    .stat-ico :global(svg) { width: 22px; height: 22px; }
    .jump { top: 53px; }
    /* 22 個縣市在手機上會佔滿一整個畫面，改成一排橫向滑動 */
    .rowlinks { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
    .rowlinks::-webkit-scrollbar { display: none; }
    .rowlinks a { flex: none; }
  }
</style>
