---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import { iconSvg } from '../lib/icons.mjs';
// 不知道要打什麼的人，給幾個常見的起點
const SUGGEST = ['台中歌劇院', '展覽', '親子', '市集', '音樂會', '手作', '免費', '高雄'];
---
<Base title="搜尋｜seh" description="搜尋台灣的文化活動、場館與城市。" noindex={true}>
  <div class="shell">
    <Nav current="search" />
    <PageHero kicker="已經知道要找什麼" title="搜尋" icon="search" tone="sun" art="活動・場館">
      <form class="sform" id="f" role="search" action="/search" method="get">
        <span class="s-ico" set:html={iconSvg('search')} />
        <input id="q" name="q" type="search" autocomplete="off" placeholder="活動名稱、場館、城市⋯" aria-label="搜尋" />
      </form>
      <p class="ssub" id="sub">輸入關鍵字開始搜尋</p>
      <p class="suggest"><span>試試看</span>{SUGGEST.map((w) => <a href={`/search?q=${encodeURIComponent(w)}`} data-q={w}>{w}</a>)}</p>
    </PageHero>
    <ul class="vlist" id="vlist" aria-label="場館"></ul>
    <ol class="ev-list" id="list"></ol>
  </div>
</Base>

<script>
  import { fmtNum, catVar, esc } from '../lib/format.mjs';
  import { loadSessions } from '../lib/index-client.mjs';
  import { upcomingSessions, pastSessions, leadText } from '../lib/day-lists.mjs';
  import { cssVar } from '../lib/dom.mjs';
  // 臺／台視為同一個字：來源兩種都寫，搜尋的人也兩種都打
  const fold = (s) => String(s ?? '').replaceAll('臺', '台').replace(/\s+/g, '').toLowerCase();
  const [sessions, names] = await Promise.all([
    loadSessions(),
    fetch('/venue-names.json').then((r) => r.json()).catch(() => []),
  ]);
  const now = Date.now();
  // 結果順序：進行中與還沒開始的在前（快結束、快開始的先），已結束的放後面（最近結束的先）。
  // 以前依開始時刻由舊到新，前 40 筆常是多年前的展覽。
  const all = [...upcomingSessions(sessions, now), ...pastSessions(sessions, now)]
    .map((d) => ({ ...d, hay: fold(`${d.title}${d.venue ?? ''}${d.city ?? ''}${d.cat ?? ''}`) }));
  // 別名 → 正式名稱：「台中歌劇院」要找得到場地寫成「臺中國家歌劇院大劇院」的場次
  const aliasPairs = names.flatMap(([name, , aliases]) => aliases.map((a) => [fold(a), fold(name)]))
    .sort((a, b) => b[0].length - a[0].length);
  const venues = names.map(([name, slug, aliases]) => ({ name, slug, keys: [name, ...aliases].map(fold) }));
  const q = document.getElementById('q'), sub = document.getElementById('sub'),
    list = document.getElementById('list'), vlist = document.getElementById('vlist');

  function variants(v) {
    const out = new Set([v]);
    for (const [a, name] of aliasPairs) if (v.includes(a)) out.add(v.replace(a, name));
    return [...out];
  }

  function run(raw) {
    const v = fold(raw);
    if (!v) { sub.textContent = '輸入關鍵字開始搜尋'; list.innerHTML = ''; vlist.innerHTML = ''; return 0; }
    const vs = variants(v);
    const hits = all.filter((d) => vs.some((x) => d.hay.includes(x)));
    const vhits = venues.filter((x) => x.keys.some((k) => k.includes(v) || (v.length >= 2 && v.includes(k)))).slice(0, 6);
    vlist.innerHTML = (vhits.length ? '<li class="vl">相關場館</li>' : '') + vhits.map((x) => `<li><a href="/venue/${encodeURIComponent(x.slug)}">${esc(x.name)}</a></li>`).join('');
    sub.innerHTML = hits.length ? `找到 <strong class="tabular">${fmtNum(hits.length)}</strong> 場` : `找不到「${esc(raw)}」的活動，換個說法試試`;
    list.innerHTML = hits.slice(0, 40).map((d) => `
      <li class="${(d.tsEnd ?? d.ts) < now ? 'past' : ''}"><a href="/event/${encodeURIComponent(d.slug)}">
        <time class="ev-lead tabular" datetime="${d.at}">${leadText(d, now)}</time>
        <span class="ev-body"><span class="ev-t">${esc(d.title)}${d.isFree ? '<span class="tag-free">免費</span>' : ''}</span>
          <span class="ev-m">${esc([d.venue, d.city].filter(Boolean).join('　'))}</span></span>
        <span class="ev-cat" data-cat="${esc(d.cat ?? '')}" style="color:${cssVar(catVar(d.cat))}">${esc(d.cat ?? '')}</span>
      </a></li>`).join('');
    return hits.length;
  }

  // 搜尋詞寫進網址（?q=），結果頁可以分享、上一頁回得來；
  // 停手 1.2 秒或按 Enter 才送 GA4 的 search 事件，逐字送會把「台」「台中」「台中歌」都記成一次搜尋。
  let lastSent = '';
  let timer = 0;
  function track(term, count) {
    if (!term || term === lastSent) return;
    lastSent = term;
    window.gtag?.('event', 'search', { search_term: term });
    window.gtag?.('event', 'view_search_results', { search_term: term, results_count: count });
  }
  function update(term, { push = false, now: immediate = false } = {}) {
    const count = run(term);
    const url = new URL(location.href);
    if (term) url.searchParams.set('q', term); else url.searchParams.delete('q');
    if (url.href !== location.href) history[push ? 'pushState' : 'replaceState'](null, '', url);
    clearTimeout(timer);
    if (immediate) track(term, count);
    else timer = setTimeout(() => track(term, count), 1200);
  }
  q.addEventListener('input', () => update(q.value.trim()));
  document.querySelectorAll<HTMLAnchorElement>('.suggest a').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); q.value = a.dataset.q!; update(q.value, { push: true, now: true });
  }));
  document.getElementById('f').addEventListener('submit', (e) => {
    e.preventDefault();
    update(q.value.trim(), { push: true, now: true });
  });
  addEventListener('popstate', () => {
    const t = new URLSearchParams(location.search).get('q') ?? '';
    q.value = t;
    run(t.trim());
  });
  const pre = new URLSearchParams(location.search).get('q');
  if (pre) { q.value = pre; update(pre.trim(), { now: true }); }
  q.focus();
</script>

<style>
  .sform { grid-column: 1 / -1; position: relative; margin-top: var(--space-5); }
  .s-ico { position: absolute; left: 1.2rem; top: 50%; transform: translateY(-50%); color: var(--seh-forest); pointer-events: none; display: flex; }
  .s-ico :global(svg) { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .sform input {
    width: 100%; min-height: 68px; font: inherit; font-size: var(--text-lg); padding: 0 1.4rem 0 3.6rem;
    background: var(--seh-card); border: 2px solid var(--border-subtle); border-radius: 999px; color: var(--text-primary);
    box-shadow: var(--seh-shadow);
  }
  .ssub { grid-column: 1 / -1; margin-top: var(--space-3); font-size: var(--text-sm); color: var(--text-secondary); }
  .ssub :global(strong) { font-size: var(--text-lg); color: var(--seh-forest); }
  .suggest { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: var(--space-3); max-width: none; }
  .suggest span { font-size: var(--text-xs); color: var(--text-muted); margin-right: var(--space-1); }
  .suggest a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 0.9rem; font-size: var(--text-xs); font-weight: 700;
    text-decoration: none; color: var(--seh-forest); background: var(--seh-forest-weak); border-radius: 999px; }
  .suggest a:hover { background: var(--seh-forest); color: var(--seh-card); }
  .vlist { list-style: none; padding: 0; margin: var(--space-4) 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .vlist a { font-size: var(--text-sm); }
  .vlist .vl { font-size: var(--text-sm); color: var(--text-muted); }
  .sform input:focus { outline: 3px solid var(--seh-coral-weak); outline-offset: 0; border-color: var(--seh-coral); }
</style>
