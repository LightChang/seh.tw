---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---
<Base title="地圖｜seh" description="台灣文化活動地圖，看全台正在發生什麼。" noindex={true}>
  <div class="shell">
    <Nav current="map" />
    <div class="wrap">
      <div class="mapcol">
        <svg id="map" role="img" aria-label="全台活動分布"></svg>
      </div>
      <aside class="side">
        <div class="mhd">
          <p class="mk">文化探索地圖</p>
          <h1>看看哪裡最熱鬧</h1>
          <p class="mstat"><b class="tabular" id="n">—</b><span>個 30 天內看得到的活動，點類型篩選</span></p>
          <nav class="chips" id="chips" aria-label="類型篩選"></nav>
        </div>
        <div class="sel" id="sel"><p class="hint">滑過地圖上的點看活動</p></div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { select } from 'd3-selection';
  import { geoMercator, geoPath } from 'd3-geo';
  import { relTime, catVar, esc } from '../lib/format.mjs';
  import { upcomingSessions } from '../lib/day-lists.mjs';
  import { loadSessions } from '../lib/index-client.mjs';
  import { cssVar } from '../lib/dom.mjs';
  const [geo, all] = await Promise.all([
    fetch('/tw-counties.json').then((r) => r.json()),
    loadSessions(),
  ]);
  const now = Date.now();
  // 「正在發生」：還沒結束、30 天內看得到的場次，一個活動一個點（以前連 1998 年的展覽都畫上去）。
  // upcomingSessions 一律以台灣時間解析（new Date(d.at) 會用訪客時區）。
  const seen = new Set();
  const pts = upcomingSessions(all.filter((d) => d.lat && d.lng), now)
    .filter((d) => d.ts < now + 30 * 86400000 && !seen.has(d.slug) && seen.add(d.slug));
  document.getElementById('n').textContent = pts.length.toLocaleString('en-US');

  const el = document.getElementById('map');
  const box = el.getBoundingClientRect();
  const W = Math.round(box.width) || 560, H = Math.round(box.height) || 760;
  const svg = select(el).attr('viewBox', `0 0 ${W} ${H}`);
  const main = { type: 'FeatureCollection',
    features: geo.features.filter((f) => !['金門縣', '連江縣'].includes(f.properties.name)) };
  const proj = geoMercator().fitExtent([[20, 16], [W - 20, H - 16]], main);

  svg.append('g').selectAll('path').data(geo.features).join('path')
    .attr('d', geoPath(proj)).attr('fill', cssVar('--bg-surface'))
    // 縣市界線跟網站字體一樣粗細感（原本 0.8 太細，像技術圖）
    .attr('stroke', cssVar('--seh-forest')).attr('stroke-opacity', 0.55)
    .attr('stroke-width', 2).attr('stroke-linejoin', 'round');

  const layer = svg.append('g');
  // pick：null＝全部；未分類是空字串，不能拿空字串當「全部」
  let pick = null;
  function draw() {
    const rows = pick === null ? pts : pts.filter((d) => (d.cat || '') === pick);
    layer.selectAll('circle').data(rows, (d) => d.slug).join(
      (en) => en.append('circle').attr('r', 0),
      (up) => up, (ex) => ex.remove()
    )
      .attr('cx', (d) => proj([d.lng, d.lat])?.[0] ?? -9)
      .attr('cy', (d) => proj([d.lng, d.lat])?.[1] ?? -9)
      .attr('fill', (d) => cssVar(catVar(d.cat)))
      .attr('fill-opacity', 0.6).attr('r', 4)
      .style('cursor', 'pointer')
      .on('mouseenter', (e, d) => show(d))
      .on('click', (e, d) => { location.href = `/event/${encodeURIComponent(d.slug)}`; });
    document.getElementById('n').textContent = rows.length.toLocaleString('en-US');
  }

  function show(d) {
    document.getElementById('sel').innerHTML = `
      <p class="cat" style="color:${cssVar(catVar(d.cat))}">${esc(d.cat)}</p>
      <p class="tt">${esc(d.title)}</p>
      <p class="meta">${esc([d.venue, d.city].filter(Boolean).join('　'))}</p>
      <p class="time tabular">${d.ts > now ? relTime(d.ts, now) : '展期中'}</p>
      <p><a href="/event/${encodeURIComponent(d.slug)}">看活動 →</a></p>`;
  }

  const counts = new Map();
  pts.forEach((d) => counts.set(d.cat, (counts.get(d.cat) ?? 0) + 1));
  const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 7);
  function chips() {
    document.getElementById('chips').innerHTML =
      `<button type="button" class="chip${pick === null ? ' on' : ''}" data-all="1">全部</button>` +
      cats.map(([c, n]) => `<button type="button" class="chip${pick === c ? ' on' : ''}" data-c="${esc(c)}" style="--c:${cssVar(catVar(c))}">${esc(c || '未分類')} ${n}</button>`).join('');
    document.querySelectorAll('#chips .chip').forEach((b) =>
      b.addEventListener('click', () => { pick = b.dataset.all ? null : (b.dataset.c ?? ''); chips(); draw(); }));
  }
  chips(); draw();
</script>

<style>
  .wrap { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 4%;
          padding-block: var(--space-6) var(--space-8); align-items: start; }
  .mapcol { min-height: 0; }
  #map { width: 100%; height: 72vh; }
  .mk { font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.06em; color: var(--seh-coral-deep); }
  .mhd h1 { margin-top: var(--space-2); font-size: var(--text-2xl); letter-spacing: -0.02em; line-height: 1.2; }
  .mstat { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-4); padding: var(--space-4);
    border-radius: var(--seh-radius); background: var(--seh-forest); color: var(--seh-card); }
  .mstat b { font-size: var(--text-xl); font-weight: 800; }
  .mstat span { font-size: var(--text-xs); color: var(--seh-forest-weak); }
  .sel { margin-top: var(--space-5); padding: var(--space-5); border-radius: var(--seh-radius); background: var(--seh-card); box-shadow: var(--seh-shadow); }
  .sel :global(.hint) { color: var(--text-muted); font-size: var(--text-sm); }
  .sel :global(.cat) { font-family: var(--font-mono); font-size: var(--text-xs); }
  .sel :global(.tt) { font-size: var(--text-base); font-weight: 500; margin-top: 0.5rem; }
  .sel :global(.meta) { font-size: var(--text-sm); color: var(--text-muted); margin-top: 0.4rem; }
  .sel :global(.time) { font-size: var(--text-sm); color: var(--color-link); margin-top: 0.4rem; }
  @media (max-width: 900px) { .wrap { grid-template-columns: 1fr; } #map { height: 56vh; } }
</style>
