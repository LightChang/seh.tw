---
import { sourceLabel } from '../../lib/source-names.mjs';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { dateLabel, hhmm, catVar } from '../../lib/format.mjs';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NearbyEvents from '../../components/NearbyEvents.astro';
import SaveShare from '../../components/SaveShare.astro';
import { iconSvg, catIcon } from '../../lib/icons.mjs';
import { nearestPlaces, distanceText, similarEvents } from '../../lib/explore-nearby.mjs';
import { daysLeftText } from '../../lib/home-picks.mjs';
import { tsOf, tsEndOf, leadText } from '../../lib/day-lists.mjs';
import { midnight, dayGap } from '../../lib/format.mjs';
import { eventLd, crumbTrail } from '../../lib/jsonld/index.mjs';
import { eventTitle, whenText, primarySession, placeLabel, eventLead, LEAD_SLUGS } from '../../lib/event-meta.mjs';
import { ticketLink } from '../../lib/ticket.mjs';
import titleAliases from '../../../overrides/event-title-aliases.json';
import { hasClockTime } from '../../lib/session-time.mjs';
import { allEvents, venueBySlug, isIndexable, builtCategories, verifiedState, eventSeries, nearbyEvents, cityMonthPages, heritageGrid, liveEventList } from '../../lib/build-data.mjs';

export async function getStaticPaths() {
  return (await allEvents()).map((e) => ({ params: { slug: e.slug }, props: { e } }));
}

const { e } = Astro.props;
const verified = await verifiedState();
const sessions = e.sessions;
const primary = primarySession(sessions);

// 懸崖帶卡點頁（曝光307、點擊0、第8.15名）：首屏加白話答案句，日期/地點/票價都是
// facts 表本來就有的事實，只是搬到答案句裡講清楚，不是新增資訊。
// 星際效應電影音樂會-2 是同一齣巡演的高雄衛武營場（曝光574、點擊0、第7.3名），同模式延伸。
const EXTRA_LEAD_SLUGS = new Set(['星際效應電影音樂會', '星際效應電影音樂會-2']);
const extraLead = EXTRA_LEAD_SLUGS.has(e.slug)
  ? `${e.title}：${whenText(sessions)}在${primary.venueNameRaw}（${[primary.city, primary.district].filter(Boolean).join('')}）。${e.isFree === true ? '免費' : e.priceText ? `票價 ${e.priceText} 元` : ''}。`
  : '';

// 懸崖帶卡點頁（曝光433、點擊25、第7.16名）：這場沒有場館名、只有地址，地址本身
// 已含縣市區，答案句不再像上面那組加一層（縣市／行政區）括號，否則重複。
// 2026夢想嘉年華（曝光308、點擊10、第6.85名）同一種缺口：來源說明只有一句宣傳語，
// 沒有日期與地點，同模式延伸。
const ADDR_LEAD_SLUGS = new Set(['2026新社花海暨臺中國際花毯節', '2026夢想嘉年華']);
const addrLead = ADDR_LEAD_SLUGS.has(e.slug)
  ? `${e.title}：${whenText(sessions)}在${placeLabel(primary)}。`
  : '';

// 反思交接＋懸崖帶（曝光269、點擊5、第7.3名，CTR 1.9%）：場次跨臺北、桃園兩個不同場館，
// 不能用 EXTRA_LEAD_SLUGS 那套只講 primary 場館的樣板——會漏講桃園場。逐場館列，
// 資料沒有票價欄位，不編票價。
const MULTI_VENUE_LEAD_SLUGS = new Set(['生氣王子親子繪本音樂會']);
const multiVenueLead = MULTI_VENUE_LEAD_SLUGS.has(e.slug)
  ? (() => {
      const seen = new Set();
      const parts = sessions
        .filter((s) => {
          const key = `${dateLabel(s.startAt)}|${s.venueNameRaw}`;
          if (seen.has(key)) return false;
          seen.add(key);
          return true;
        })
        .map((s) => `${dateLabel(s.startAt)}在${s.venueNameRaw}（${[s.city, s.district].filter(Boolean).join('')}）`);
      return `${e.title}：${parts.join('，')}。`;
    })()
  : '';

// 來源說明文字帶著沒解開的 HTML 實體（「Ga&iuml;a」「&hellip;」），
// 不解開就會原樣印在頁面、meta description 與搜尋結果摘要上。
const ENTITY = {
  amp: '&', lt: '<', gt: '>', quot: '"', nbsp: ' ', emsp: ' ', shy: '', zwj: '',
  mdash: '—', ndash: '–', hellip: '…', middot: '·', bull: '•', rarr: '→', harr: '↔',
  times: '×', divide: '÷', deg: '°', reg: '®', copy: '©', sect: '§', sup2: '²', ordm: 'º',
  ldquo: '“', rdquo: '”', lsquo: '‘', rsquo: '’', iexcl: '¡', uml: '¨', infin: '∞',
  Aacute: 'Á', aacute: 'á', agrave: 'à', Eacute: 'É', eacute: 'é', egrave: 'è', ecirc: 'ê',
  Iacute: 'Í', iacute: 'í', iuml: 'ï', ntilde: 'ñ', Ocirc: 'Ô', ocirc: 'ô', oacute: 'ó',
  Ouml: 'Ö', ouml: 'ö', Oslash: 'Ø', oelig: 'œ', Scaron: 'Š', scaron: 'š', uuml: 'ü', yacute: 'ý',
  Omicron: 'Ο', omicron: 'ο', Tau: 'Τ', pi: 'π', lambda: 'λ', gamma: 'γ', alpha: 'α',
};
const decodeEntities = (s) => String(s ?? '').replace(/&(?:#(\d+)|#x([0-9a-f]+)|([A-Za-z][A-Za-z0-9]*));/gi, (m, dec, hex, name) => {
  if (name) return ENTITY[name] ?? m;
  const cp = dec ? Number(dec) : parseInt(hex, 16);
  return cp > 0 && cp <= 0x10ffff ? String.fromCodePoint(cp) : m;
});

// JSON-LD、<meta description>、「地點／縣市」欄用同一份事實，組裝在 src/lib/jsonld/event.mjs；
// 標題與首屏時間在 src/lib/event-meta.mjs（都有測試守著）。
// 場次沒有縣市時，地點退回「地點」欄連過去的場館頁的縣市與地址（eventLocation）。
const venue = primary.venueSlug ? (await venueBySlug()).get(primary.venueSlug) : undefined;
const { ld, description: rawDesc, location: loc } = eventLd(e, { venue });
const metaDesc = decodeEntities(rawDesc);
// ld 為 null：資料裡沒有實體地點或地址，這頁不輸出 Event（理由見 eventLd）
if (ld) ld.description = metaDesc;
// 沒有場館名時，比縣市更具體的地址也算地點（「臺東縣成功鎮海濱公園」）
const place = placeLabel(primary);
const desc = e.description ? decodeEntities(e.description) : '';

// 懸崖帶卡點頁（曝光232、點擊6、第7.06名，CTR 2.6%）：實測 GSC 查詢裡有「出場順序」
// 「表演順序」「眾人的搖擺演出順序」，但名單在來源說明第三段，首屏看不到。
// 名單本身就是來源說明既有的事實，只是搬到首屏，不是新增資訊。
const ORDER_LEAD_SLUGS = new Set(['2026-Open-House眾人的搖擺']);
const orderMatch = ORDER_LEAD_SLUGS.has(e.slug) && /出場順序排列）\s*\n+([\s\S]+?)\n+\s*演出者介紹/.exec(desc);
const orderLead = orderMatch ? `演出順序：${orderMatch[1].replace(/\n+/g, '；').replace(/\s*／\s*/g, '、').trim()}。` : '';

// Google Trends 竄升（種子「博物館」+70%，查詢「奇美博物館埃及展預約」，2026-11-04）：
// 來源說明只寫「特展及門票優惠詳洽官網」，首屏看不到實際購票通路。奇美博物館官網
// （下方「前往原始出處」同一個連結）確認：除官網售票平台，也可經 Klook、KKday、ibon、
// Trip.com 購買，現場售票機僅售當日票，另有「快速入場預約」服務。
const TICKET_CHANNEL_LEAD_SLUGS = new Set(['大英博物館鉅獻埃及之王-法老']);
const ticketChannelLead = TICKET_CHANNEL_LEAD_SLUGS.has(e.slug);
const srcUrl = e.sources.find((x) => x.url)?.url;
// 來源給的購票／報名連結（JSON-LD 的 offers.url 用同一個），沒有就不顯示，不自己找
const ticket = ticketLink(e.ticketUrl, e.isFree);
// 官方名稱常整個包一層書名號（「《卡普松與傑洛米二重奏》」），但使用者搜尋時不會打這兩個符號，
// SERP 標題留著它就跟搜尋字不一樣。只拆「整包」的，中間帶書名號的副標不動
// （「《和光同塵：李安成》光塵之間」不拆，因為書名號後面還有字）。H1、JSON-LD 仍用原始 e.title。
const TITLE_WRAPPERS = [['《', '》'], ['「', '」'], ['『', '』'], ['〈', '〉']];
const unwrapTitle = (t) => {
  for (const [open, close] of TITLE_WRAPPERS) {
    if (t.startsWith(open) && t.endsWith(close) && t.length > open.length + close.length) return t.slice(open.length, -close.length);
  }
  return t;
};
// 另一類是前綴標籤而非整包：「【2026臺中國際動畫影展】致遙不可及彼方的你」，
// 使用者搜的是後半段片名，前面的系列/場館名留著只會讓 SERP 標題跟搜尋字對不起來。
// 只拆開頭這一組，且拆完還剩字才拆（「【金．聲相遇】」本身就是活動名，拆了就空了）。
const stripSeriesPrefix = (t) => {
  const m = /^【[^【】]*】\s*(.+)$/.exec(t);
  return m ? m[1] : t;
};
// 同樣是前綴標籤，但分隔符是「│」而非【】——站上還有「14:00│16:00」這種時間寫法、
// 「臺灣戲曲中心導覽服務│導覽時間約90分鐘」這種後段才是說明文字的用法，全站套會拆錯，
// 所以逐篇核過才加進這份清單，不是通用規則。
const PIPE_PREFIX_SLUGS = new Set(['虛擬製作系列│穿梭日本房間-音樂與互動體驗的跨界新可能']);
const stripPipePrefix = (t) => {
  if (!PIPE_PREFIX_SLUGS.has(e.slug)) return t;
  const m = /^[^│]+│\s*(.+)$/.exec(t);
  return m ? m[1] : t;
};
// 搜尋用的別名（overrides/event-title-aliases.json）：放進 <title> 與 JSON-LD alternateName，H1 不動
const alias = titleAliases.aliases?.[e.slug]?.alias;
if (ld && alias) ld.alternateName = alias;
const metaTitle = eventTitle({ ...e, title: unwrapTitle(stripSeriesPrefix(stripPipePrefix(e.title))) }, { alias });
const srcNames = [...new Set(e.sources.map((x) => sourceLabel(x)))];
const shown = sessions.slice(0, 20);
// 已結束或內容太少的活動退回 noindex，網址仍然存在、站內仍然連得到
const indexable = await isIndexable(`/event/${e.slug}`);
// 分類頁有 ≥5 場的門檻，不檢查就會連到不存在的頁（實測「綜藝」只有 4 場）
const hasCatPage = e.category && (await builtCategories()).has(e.category);
// 縣市 × 月份頁（/city/<縣市>/<YYYY-MM>）：場次月份裡有建頁的，優先還沒過去的月份
const cityMonths = await cityMonthPages();
const monthKeys = loc.city
  ? [...new Set(sessions.map((s) => (s.startAt ?? '').slice(0, 7)))].sort().filter((ym) => cityMonths.has(`${loc.city} ${ym}`))
  : [];
const cityMonth = monthKeys.find((ym) => !cityMonths.get(`${loc.city} ${ym}`).past) ?? monthKeys.at(-1);
// 同一個年度活動的其他屆：搜「活動名＋去年」的人一步走到今年
const editions = (await eventSeries()).get(e.slug) ?? [];
// 同場地、同縣市接下來的活動。已結束的頁放在說明文字之前（讀者要找的是下一場），
// 進行中的放在頁尾之前。
const nearby = await nearbyEvents();
const ended = !nearby.live.has(e.slug);
const near = nearby.pick({ venueSlug: primary.venueSlug, city: loc.city, exclude: [e.slug, ...editions.map((x) => x.slug)] });
const nearProps = { items: near, city: loc.city, venueName: nearby.groupName(primary.venueSlug) ?? primary.venueNameRaw, now: Date.now() };
// ── 延伸探索（2026-11-11 活動頁改版）─────────────────────────────
const buildNow = Date.now();
const t0 = midnight(buildNow);
// 活動狀態：已結束／即將結束（剩 N 天）／展期中／今天／N 天後
const spans = sessions.map((x) => {
  const row = { at: x.granularity === 'date' ? `${x.startAt}T00:00` : x.startAt, end: x.endAt ?? null };
  const ts = tsOf(row);
  return { ts, end: tsEndOf(row) ?? ts };
}).filter((x) => Number.isFinite(x.ts));
const evStart = spans.length ? Math.min(...spans.map((x) => x.ts)) : null;
const evEnd = spans.length ? Math.max(...spans.map((x) => x.end)) : null;
const status = evEnd === null ? null
  : evEnd < t0 ? { text: '已結束', tone: 'off' }
  : evStart < t0
    ? (evEnd - evStart >= 3 * 86400000 && evEnd < t0 + 7 * 86400000
      ? { text: daysLeftText(Math.round((midnight(evEnd) - t0) / 86400000)), tone: 'urgent' }
      : { text: '展期中', tone: 'on' })
  : dayGap(evStart, buildNow) === 0 ? { text: '今天', tone: 'on' }
  : { text: `${dayGap(evStart, buildNow)} 天後開始`, tone: 'plain' };
// 交通：有座標用座標，沒有就用地址查
const lat = primary.lat ?? venue?.lat, lng = primary.lng ?? venue?.lng;
const addr = loc.street || venue?.address || primary.address || '';
const mapQuery = typeof lat === 'number' && typeof lng === 'number' ? `${lat},${lng}` : addr ? `${primary.venueNameRaw ?? ''} ${addr}`.trim() : '';
const mapLinks = mapQuery && {
  view: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`,
  route: `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(mapQuery)}`,
};
// 附近的文化資產（場館本身就在某處文資裡的，那處另外列在場館資訊，不重複）
const nearHer = nearestPlaces(await heritageGrid(), lat, lng, { radiusM: 2000, limit: 4, exclude: new Set(venue?.heritage ? [venue.heritage.slug] : []) });
// 你可能也會喜歡：同類型，排除頁面上已經列出的
const listed = new Set([e.slug, ...near.map((x) => x.slug), ...editions.map((x) => x.slug)]);
const similar = similarEvents(await liveEventList(buildNow), { cat: e.category, city: loc.city, exclude: listed, limit: 4 });
// at／end 帶時區（ISO 的 Z）：不帶的話 hhmm() 會用 build 主機的時區（UTC）解讀，時間錯 8 小時
const similarRows = similar.map((x) => ({ slug: x.slug, title: x.title, cat: x.cat, isFree: x.isFree, venue: x.venue, city: x.city,
  at: new Date(x.next).toISOString(), end: x.end ? new Date(x.end).toISOString() : null, dateOnly: x.dateOnly }));
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageUrl = `${site}/event/${encodeURIComponent(e.slug)}`;
const hoursShort = venue?.openingHours ? venue.openingHours.split('\n').slice(0, 3).join('\n') : '';

// 標題右邊的分類插圖：顏色依類型的氣氛（展覽靜、表演熱鬧、課程講座亮、戶外節慶綠）
const ART_TONE = { 展覽: 'sage', 電影: 'sage', 音樂: 'coral', 演唱會: 'coral', 獨立音樂: 'coral', 戲劇: 'coral', 舞蹈: 'coral', 綜藝: 'coral', 市集: 'coral',
  講座: 'sun', 研習課程: 'sun', 親子: 'sun', 節慶活動: 'forest', 遊憩活動: 'forest' };
const artTone = ART_TONE[e.category] ?? 'plain';
const fi = (name) => iconSvg(name);

// 麵包屑：畫面與 BreadcrumbList 同一份
// 不放「今天」：活動多半不是今天的（已結束、下個月才開始），掛在「今天」底下是錯的層級。
const trail = crumbTrail([
  loc.city && { name: loc.city, href: `/city/${loc.city}` },
  hasCatPage && { name: e.category, href: `/category/${e.category}` },
], e.title);
---
<Base
  title={metaTitle}
  description={metaDesc}
  noindex={!indexable}
  jsonld={ld}
  breadcrumbs={trail}
>
  <div class="shell">
    <Nav />
    <article class="ev">
      <Breadcrumb trail={trail} />

      <header class="ev-hd">
        <div class="ev-art" aria-hidden="true"><span class={`ev-art-c tone-${artTone}`} set:html={iconSvg(catIcon(e.category))} /></div>
        <p class="ev-kick">
          {e.category && (hasCatPage
            ? <a class="tag" data-cat={e.category} href={`/category/${e.category}`} style={`color:var(${catVar(e.category)})`}>{e.category}</a>
            : <span class="tag" data-cat={e.category} style={`color:var(${catVar(e.category)})`}>{e.category}</span>)}
          {status && <span class={`tag st-${status.tone}`}>{status.text}</span>}
          {e.isFree === true && <span class="tag-free">免費</span>}
          {loc.city && <span class="ev-city">{loc.city}{loc.district && `・${loc.district}`}</span>}
        </p>
        <h1>{e.title}</h1>
      {LEAD_SLUGS.has(e.slug) && <p class="lead">{eventLead(e)}</p>}
      {extraLead && <p class="lead">{extraLead}</p>}
      {multiVenueLead && <p class="lead">{multiVenueLead}</p>}
      {addrLead && <p class="lead">{addrLead}</p>}
      {orderLead && <p class="lead">{orderLead}</p>}
      {ticketChannelLead && !ended && <p class="lead">{e.title}展出中，購票除奇美博物館官網售票平台，
        也可經 Klook、KKday、ibon、Trip.com 等通路購買；現場售票機僅售當日票，官網另提供「快速入場預約」服務。
        詳見{srcUrl && <a href={srcUrl} target="_blank" rel="noopener">官網購票說明</a>}。</p>}
      </header>

      <div class="ev-grid">
      <div class="ev-main">

      <dl class="facts">
        <div class="f-wide"><dt><span class="f-ico" set:html={fi('calendar')} />時間</dt><dd class="tabular">
          {/* 日期、時刻各自不斷行，窄螢幕只在空白處換行（原本會把「（二）」拆到下一行） */}
          {whenText(sessions).split(' ').map((part, i) => <>{i > 0 && ' '}<span class="nw">{part}</span></>)}
          {sessions.length > 1 && <span class="n">　共 {sessions.length} 場次</span>}
        </dd></div>
        {place && <div class="f-wide"><dt><span class="f-ico" set:html={fi('pin')} />地點</dt><dd>
          {primary.venueSlug && primary.venueNameRaw
            ? <a href={`/venue/${primary.venueSlug}`}>{place}</a>
            : place}
          {primary.venueNameRaw && loc.street && <span class="n">　{loc.street}</span>}
        </dd></div>}
        {(e.isFree !== undefined || e.priceText) && <div><dt><span class="f-ico" set:html={fi(e.isFree === true ? 'gift' : 'ticket')} />票價</dt><dd>
          {e.isFree === true ? '免費' : e.priceText || '售票'}
        </dd></div>}
        {ticket && <div><dt><span class="f-ico" set:html={fi('ticket')} />{ticket.label}</dt><dd>
          <a href={ticket.href} target="_blank" rel="nofollow noopener" data-goal="event_detail_click" data-method="ticket">{ticket.platform}</a>
        </dd></div>}
        {loc.city ? <div><dt><span class="f-ico" set:html={fi('map')} />縣市</dt><dd>
          <a href={`/city/${loc.city}`}>{loc.city}</a>{loc.district && <span class="n">　{loc.district}</span>}
          {cityMonth && <span class="n">　<a href={`/city/${loc.city}/${cityMonth}`}>{+cityMonth.slice(5)} 月{loc.city}活動</a></span>}
        </dd></div> : loc.district && <div><dt><span class="f-ico" set:html={fi('map')} />地區</dt><dd>{loc.district}</dd></div>}
        {(e.category || e.categoryRaw) && <div><dt><span class="f-ico" set:html={fi(catIcon(e.category))} />類型</dt><dd>
          {/* 沒有對照到 canonical 的就不連結——分類頁是用對照後的值建的，
              連原始值（「2」「特展」）會連到不存在的頁 */}
          {hasCatPage
            ? <a href={`/category/${e.category}`} style={`color:var(${catVar(e.category)})`}>{e.category}</a>
            : <span class="raw" style={e.category ? `color:var(${catVar(e.category)})` : undefined}>
                {e.category ?? e.categoryRaw}{!e.category && <span class="n">　（尚未對照）</span>}
              </span>}
        </dd></div>}
        {e.minimumAge !== undefined && <div><dt><span class="f-ico" set:html={fi('balloon')} />年齡</dt><dd>{e.minimumAge} 歲以上</dd></div>}
        {e.performers?.length > 0 && <div class="f-wide"><dt><span class="f-ico" set:html={fi('people')} />演出者</dt><dd>
          {e.performers.map((p) => p.nameRaw).join('、')}
        </dd></div>}
        {e.organizers?.length > 0 && <div class="f-wide"><dt><span class="f-ico" set:html={fi('building')} />主辦</dt><dd>
          {e.organizers.filter((o) => o.role === 'master').map((o) => o.nameRaw).join('、')
            || e.organizers.map((o) => o.nameRaw).join('、')}
        </dd></div>}
      </dl>

      {ended && <NearbyEvents {...nearProps} />}

      {desc && (
        <section class="sec">
          <h2 class="sec-h"><span class="sec-ico" set:html={fi('chat')} />活動介紹</h2>
          <div class="desc">{desc}</div>
        </section>
      )}

      {sessions.length > 1 && (
        <section class="sessions">
          <h2 class="sec-h"><span class="sec-ico" set:html={fi('calendar')} />所有場次<span class="tabular badge">{sessions.length}</span></h2>
          <ul>{shown.map((t) => (
            <li>
              <time class="tabular" datetime={t.startAt}>
                {dateLabel(t.startAt)}{hasClockTime(t.startAt, t.granularity) ? ` ${hhmm(t.startAt)}` : ''}
              </time>
              {t.venueNameRaw && t.venueNameRaw !== primary.venueNameRaw && <span class="sv">{t.venueNameRaw}</span>}
            </li>
          ))}</ul>
          {sessions.length > shown.length && <p class="more">另有 {sessions.length - shown.length} 場次</p>}
        </section>
      )}

      {editions.length > 0 && (
        <section class="sessions">
          <h2 class="sec-h"><span class="sec-ico" set:html={fi('star')} />其他年份</h2>
          <ul>{editions.map((x) => (
            <li>
              <time class="tabular" datetime={x.start}>{x.start.slice(0, 4)}</time>
              <a href={`/event/${x.slug}`}>{x.title}</a>
            </li>
          ))}</ul>
        </section>
      )}

      {(place || mapLinks || venue) && (
        <section class="sec">
          <h2 class="sec-h"><span class="sec-ico" set:html={fi('pin')} />地點與交通</h2>
          <div class="visit">
            <div class="visit-main">
              {place && <p class="visit-name">{primary.venueSlug && primary.venueNameRaw ? <a href={`/venue/${primary.venueSlug}`}>{place}</a> : place}</p>}
              {addr && <p class="visit-addr">{addr}</p>}
              {hoursShort && <p class="visit-hours"><span class="visit-k">開放時間</span>{hoursShort}</p>}
              {venue?.heritage && <p class="visit-her">這裡是文化資產：<a href={`/heritage/${venue.heritage.slug}`}>{venue.heritage.name}</a></p>}
            </div>
            {mapLinks && (
              <p class="visit-links">
                <a class="pill" href={mapLinks.route} target="_blank" rel="noopener" data-goal="directions" data-method="google_maps">規劃路線</a>
                <a class="pill" href={mapLinks.view} target="_blank" rel="noopener">在地圖上看</a>
                {primary.venueSlug && <a class="pill" href={`/venue/${primary.venueSlug}`}>場館介紹</a>}
              </p>
            )}
          </div>
        </section>
      )}

      {nearHer.length > 0 && (
        <section class="sec">
          <h2 class="sec-h"><span class="sec-ico" set:html={fi('roof')} />附近的文化資產<span class="tabular badge">{nearHer.length}</span></h2>
          <ul class="her-list">
            {nearHer.map((h) => (
              <li><a href={`/heritage/${encodeURIComponent(h.slug)}`}>
                <span class="her-name">{h.name}</span>
                <span class="her-m">{[h.level, distanceText(h.distanceM)].filter(Boolean).join('・')}</span>
              </a></li>
            ))}
          </ul>
        </section>
      )}

      {!ended && <NearbyEvents {...nearProps} />}

      {similarRows.length > 0 && (
        <section class="sec">
          <h2 class="sec-h"><span class="sec-ico" set:html={fi('heart')} />你可能也會喜歡</h2>
          <ol class="ev-list sim">
            {similarRows.map((d) => (
              <li><a href={`/event/${encodeURIComponent(d.slug)}`} data-goal="event_open" data-method="event_similar">
                <time class="ev-lead tabular" datetime={d.at}>{leadText(d, buildNow)}</time>
                <span class="ev-body"><span class="ev-t">{d.title}{d.isFree === true && <span class="tag-free">免費</span>}</span>
                  <span class="ev-m">{[d.venue, d.city].filter(Boolean).join('　')}</span></span>
                <span class="ev-cat" data-cat={d.cat || ''} style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>
              </a></li>
            ))}
          </ol>
          {hasCatPage && <p class="more-sim"><a href={`/category/${e.category}`}>所有{e.category}活動 →</a></p>}
        </section>
      )}

      <footer class="prov">
        <h2><span class="f-ico" set:html={fi('info')} />資料來源</h2>
        <p class="pnote">這一頁由 {e.sources.length} 個來源整理而成。每個欄位各自挑品質最高的來源，落選值也留著。</p>
        <ul class="slist">{e.sources.map((s) => (
          <li>
            <span class="sid">{sourceLabel(s)}</span>
            <span class="sp">{s.provides.length ? `提供 ${s.provides.join('、')}` : '未被採用'}</span>
            {verified.get(`${s.id}:${s.recordId}`) && (
              <time class="tabular sd">{verified.get(`${s.id}:${s.recordId}`)}</time>
            )}
          </li>
        ))}</ul>
        <p>活動內容以原始出處為準。<a href="/about">資料怎麼來的</a></p>
      </footer>
      </div>

      <aside class="ev-side" aria-label={ended ? '活動資訊' : '出發前'}>
        <div class={ended ? 'plan is-ended' : 'plan'}>
          <p class="plan-k">{ended ? '活動已結束' : '出發前'}</p>
          <p class="plan-when tabular">{whenText(sessions)}</p>
          {sessions.length > 1 && <p class="plan-n">共 {sessions.length} 場次</p>}
          {place && <p class="plan-place">{place}</p>}
          {(e.isFree !== undefined || e.priceText) && (
            <p class="plan-price">{e.isFree === true ? <span class="tag-free">免費</span> : <>票價　{e.priceText || '售票'}</>}</p>
          )}
          {/* 已結束就不推購票，只留官方頁（資料仍以原始出處為準） */}
          {((ticket && !ended) || srcUrl) && (
            <p class="cta">
              {ticket && !ended && <a class="btn" href={ticket.href} target="_blank" rel="nofollow noopener" data-goal="event_detail_click" data-method="ticket">{ticket.label}（{ticket.platform}）</a>}
              {srcUrl && (ended || srcUrl !== ticket?.href) && <a class={ticket && !ended ? 'btn2' : 'btn'} href={srcUrl} target="_blank" rel="noopener" data-goal="event_detail_click" data-method="source">前往官方活動頁</a>}
              {srcUrl && <span class="src">出處：{srcNames[0]}</span>}
            </p>
          )}
          <SaveShare kind="event" slug={e.slug} title={e.title} when={whenText(sessions)} place={place} endTs={evEnd}
            cat={e.category ?? ''} url={pageUrl} ended={ended} />
        </div>
      </aside>
      </div>
    </article>
  </div>
</Base>

<style>
  .ev { padding-block: var(--space-5) var(--space-9); }
  /* 標題區：分類／狀態標籤＋大標 */
  .ev-hd { max-width: 54rem; padding-top: var(--space-4); }
  .ev-kick { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); }
  .ev-kick a.tag { text-decoration: none; }
  .ev-city { font-size: var(--text-xs); color: var(--text-secondary); }
  .st-urgent { color: var(--seh-coral-deep); background: var(--seh-coral-weak); border-color: transparent; font-weight: 700; }
  .st-on { color: var(--seh-forest); background: var(--seh-forest-weak); border-color: transparent; font-weight: 700; }
  .st-plain { color: var(--text-secondary); }
  .st-off { color: var(--text-muted); background: var(--bg-surface); border-color: transparent; }
  h1 { margin-top: var(--space-4); font-family: var(--font-body); font-weight: 800;
       font-size: clamp(2rem, 3.4vw, 2.75rem); line-height: 1.25; letter-spacing: -0.015em; }

  /* 兩欄：左邊內容、右邊「出發前」卡片固定在視窗內 */
  .ev-grid { display: grid; grid-template-columns: minmax(0, 46rem) minmax(0, 22rem); gap: var(--space-8); align-items: start; justify-content: space-between; margin-top: var(--space-5); }
  .ev-side { position: sticky; top: 80px; }
  .plan { border-top: 6px solid var(--seh-coral); background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow); padding: var(--space-5); display: grid; gap: var(--space-2); }
  .plan-k { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; color: var(--seh-coral-deep); }
  .plan.is-ended { border-top-color: var(--text-muted); }
  .plan.is-ended .plan-k { color: var(--text-secondary); }
  .plan-when { font-size: var(--text-base); font-weight: 800; line-height: 1.35; }
  .plan-n, .plan-place, .plan-price { font-size: var(--text-xs); color: var(--text-secondary); }
  .plan .cta { margin-top: var(--space-3); display: grid; gap: var(--space-2); }
  .plan .btn, .plan .btn2 { text-align: center; }
  .plan :global(.act-row) { margin-top: var(--space-3); padding-top: var(--space-4); border-top: var(--hairline) solid var(--border-subtle); }

  /* 內容區塊 */
  .sec { margin-top: var(--space-8); }
  .h-sec { font-family: var(--font-body); font-size: var(--text-lg); font-weight: 800; border-top: 2px solid var(--seh-ink); padding-top: var(--space-3); margin-bottom: var(--space-4); }
  .visit { display: grid; gap: var(--space-4); }
  .visit-name { font-size: var(--text-sm); font-weight: 700; }
  .visit-name a { text-decoration-color: var(--seh-coral-deep); }
  .visit-addr, .visit-her { font-size: var(--text-xs); color: var(--text-secondary); margin-top: var(--space-1); }
  .visit-hours { font-size: var(--text-xs); color: var(--text-secondary); white-space: pre-line; margin-top: var(--space-2); }
  .visit-k { display: block; font-weight: 700; color: var(--text-primary); }
  .visit-links { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .pill {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; text-decoration: none;
    font-size: var(--text-xs); font-weight: 700; color: var(--text-primary);
    border: var(--hairline) solid var(--border-subtle); border-radius: 999px; background: var(--bg-base);
  }
  .pill:first-child { color: var(--bg-base); background: var(--seh-forest); border-color: var(--seh-forest); }
  .pill:hover { border-color: var(--seh-ink); }
  .her-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .her-list a { display: grid; gap: 4px; height: 100%; padding: var(--space-4); text-decoration: none; border: var(--hairline) solid var(--border-subtle); border-radius: 3px; transition: border-color 0.15s; }
  .her-list a:hover { border-color: var(--seh-ink); }
  .her-list a:hover .her-name { color: var(--color-link); }
  .her-name { font-size: var(--text-sm); font-weight: 700; line-height: 1.4; }
  .her-m { font-size: var(--text-xs); color: var(--seh-forest); }
  .sim { margin: 0; }
  .more-sim { margin-top: var(--space-4); font-size: var(--text-sm); }
  .more-sim a { color: var(--color-link); text-decoration: none; font-weight: 700; }
  @media (max-width: 1024px) {
    .ev-grid { display: flex; flex-direction: column; gap: 0; }
    .ev-main { order: 2; width: 100%; }
    .ev-side { order: 1; position: static; width: 100%; margin-bottom: var(--space-5); }
    /* 窄螢幕卡片排在資料表上面，時間地點票價下面就有，卡片只留行動按鈕 */
    .plan-when, .plan-n, .plan-place, .plan-price { display: none; }
    .plan { padding: var(--space-4); }
  }
  @media (max-width: 760px) {
    .her-list { grid-template-columns: minmax(0, 1fr); }
    .sec { margin-top: var(--space-7); }
  }
  .facts { margin: var(--space-6) 0 0; display: grid; gap: 0; border-top: var(--hairline) solid var(--border-subtle); }
  .facts > div {
    display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1.5rem;
    padding: 0.9rem 0; border-bottom: var(--hairline) solid var(--border-subtle);
  }
  .facts dt { color: var(--text-muted); font-size: var(--text-sm); }
  .facts dd { margin: 0; font-size: var(--text-base); }
  .facts .n { color: var(--text-muted); font-size: var(--text-sm); }
  .nw { white-space: nowrap; }
  @media (max-width: 760px) {
    .ev { padding-block: var(--space-5) var(--space-8); }
    .facts { margin-top: var(--space-5); }
    .facts > div { grid-template-columns: 5rem minmax(0, 1fr); gap: 0.75rem; padding: 0.6rem 0; }
    .cta { margin-top: var(--space-5); }
  }
  .raw { color: var(--text-secondary); }
  .sessions { margin-top: var(--space-7); }
  .sessions h2 { font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-secondary); font-weight: 700; }
  .sessions ul { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: 0.35rem; }
  .sessions li { font-size: var(--text-sm); color: var(--text-secondary); }
  .more { margin-top: 0.6rem; font-size: var(--text-sm); color: var(--text-muted); }
  .cta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: var(--space-6); }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 52px; text-decoration: none; font-weight: 800;
    background: var(--seh-coral); color: var(--seh-ink); border: 2px solid var(--seh-coral); border-radius: 999px;
    padding: 0 1.2rem; font-size: var(--text-sm); transition: background-color 0.15s, border-color 0.15s;
  }
  .btn:hover { background: var(--seh-ink); border-color: var(--seh-ink); }
  .btn2 {
    display: inline-flex; align-items: center; justify-content: center; min-height: 52px; text-decoration: none; font-weight: 700; font-size: var(--text-sm);
    padding: 0 1.2rem; border: 2px solid var(--seh-forest); border-radius: 999px; color: var(--seh-forest); background: var(--seh-card);
  }
  .btn2:hover { color: var(--color-link); border-color: var(--seh-coral-deep); }
  .src { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); }
  .prov {
    margin-top: var(--space-8); padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--border-subtle);
    font-size: var(--text-sm); color: var(--text-muted); display: grid; gap: 0.5rem;
  }
  .prov strong { color: var(--text-secondary); }

  .lead { margin-top: var(--space-4); line-height: 1.75; }
  .desc { margin-top: var(--space-6); white-space: pre-wrap; line-height: 1.75; color: var(--text-secondary); }
  .sessions li { display: flex; gap: 1rem; flex-wrap: wrap; }
  .sv { color: var(--text-muted); }
  .prov h2 { display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-secondary); font-weight: 700; margin: 0; }
  .pnote { margin: 0; }
  .slist { list-style: none; margin: 0.4rem 0; padding: 0; display: grid; gap: 0.3rem; }
  .slist li {
    display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
    gap: 1rem; align-items: baseline;
  }
  .sid { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sp { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sd { font-family: var(--font-mono); font-size: var(--text-xs); }

  /* ── 2026-11-11 視覺升級（覆寫上面的舊規則）── */
  .ev-hd { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: var(--space-6); max-width: none; }
  .ev-hd > * { grid-column: 1; }
  .ev-hd > .ev-art { grid-column: 2; grid-row: 1 / span 8; align-self: start; }
  .ev-art-c { display: grid; place-items: center; width: 8.5rem; height: 8.5rem; border-radius: 50%; transform: rotate(-4deg); box-shadow: var(--seh-shadow); }
  .ev-art-c :global(svg) { width: 64px; height: 64px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .ev-art-c.tone-plain { background: var(--seh-card); color: var(--seh-forest); }

  /* 詳細資訊：白色資訊卡，每項配圖示，兩欄 */
  .facts { border-top: 0; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin-top: 0; }
  .facts > div {
    display: grid; grid-template-columns: none; align-content: start; gap: 6px; padding: var(--space-4) var(--space-5);
    background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow); border-bottom: 0;
  }
  .facts > .f-wide { grid-column: 1 / -1; }
  .facts dt { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-xs); font-weight: 700; color: var(--text-secondary); }
  .f-ico { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--bg-surface); color: var(--seh-forest); }
  .f-ico :global(svg) { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .facts dd { font-size: var(--text-sm); font-weight: 600; line-height: 1.5; }
  .facts dd a { color: var(--seh-forest); }

  .ev .sec, .ev .sessions { margin-top: var(--space-8); }
  .ev .sec > .sec-h, .ev .sessions > .sec-h { margin-top: 0; margin-bottom: var(--space-4); }
  .desc { margin-top: 0; padding: var(--space-5) var(--space-6); background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow);
    color: var(--text-primary); font-size: var(--text-sm); line-height: 1.9; }
  /* 所有場次：日期膠囊 */
  .sessions ul { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: 0; }
  .sessions li { display: inline-flex; align-items: center; gap: var(--space-2); padding: 0.4rem 0.9rem; border-radius: 999px;
    background: var(--seh-card); box-shadow: var(--seh-shadow); font-size: var(--text-xs); color: var(--text-primary); }
  .sessions li time { font-weight: 700; color: var(--seh-forest); }
  .sessions li a { color: var(--text-primary); }
  .visit { padding: var(--space-5); background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow); }
  .her-list a { background: var(--seh-card); border-color: transparent; box-shadow: var(--seh-shadow); }
  .prov { padding: var(--space-5); border-top: 0; border-radius: var(--seh-radius); background: var(--bg-surface); }

  @media (max-width: 760px) {
    .ev-hd { column-gap: var(--space-4); }
    /* 手機：插圖只跟標籤列並排，標題用滿整個寬度 */
    .ev-hd > .ev-art { grid-row: 1 / span 1; }
    .ev-hd > h1, .ev-hd > .lead { grid-column: 1 / -1; }
    .ev-art-c { width: 4.5rem; height: 4.5rem; }
    .ev-art-c :global(svg) { width: 34px; height: 34px; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
    .facts > div { grid-template-columns: none; gap: 4px; padding: var(--space-3) var(--space-4); }
    .desc { padding: var(--space-4); }
  }
</style>

