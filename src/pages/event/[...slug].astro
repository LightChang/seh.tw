---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { dateLabel, hhmm, catVar } from '../../lib/format.mjs';
import Breadcrumb from '../../components/Breadcrumb.astro';
import NearbyEvents from '../../components/NearbyEvents.astro';
import { eventLd, crumbTrail } from '../../lib/jsonld/index.mjs';
import { eventTitle, whenText, primarySession, placeLabel, eventLead, LEAD_SLUGS } from '../../lib/event-meta.mjs';
import { ticketLink } from '../../lib/ticket.mjs';
import titleAliases from '../../../overrides/event-title-aliases.json';
import { hasClockTime } from '../../lib/session-time.mjs';
import { allEvents, venueBySlug, isIndexable, builtCategories, verifiedState, eventSeries, nearbyEvents, cityMonthPages } from '../../lib/build-data.mjs';

export async function getStaticPaths() {
  return (await allEvents()).map((e) => ({ params: { slug: e.slug }, props: { e } }));
}

const { e } = Astro.props;
const verified = await verifiedState();
const sessions = e.sessions;
const primary = primarySession(sessions);

// 來源說明文字帶著沒解開的 HTML 實體（「Ga&iuml;a」「&hellip;」），
// 不解開就會原樣印在頁面、meta description 與搜尋結果摘要上。
const ENTITY = {
  amp: '&', lt: '<', gt: '>', quot: '"', nbsp: ' ', emsp: ' ', shy: '', zwj: '',
  mdash: '—', ndash: '–', hellip: '…', middot: '·', bull: '•', rarr: '→', harr: '↔',
  times: '×', divide: '÷', deg: '°', reg: '®', copy: '©', sect: '§', sup2: '²', ordm: 'º',
  ldquo: '“', rdquo: '”', lsquo: '‘', rsquo: '’', iexcl: '¡', uml: '¨', infin: '∞',
  Aacute: 'Á', aacute: 'á', agrave: 'à', Eacute: 'É', eacute: 'é', egrave: 'è', ecirc: 'ê',
  Iacute: 'Í', iacute: 'í', iuml: 'ï', ntilde: 'ñ', Ocirc: 'Ô', ocirc: 'ô', oacute: 'ó',
  Ouml: 'Ö', ouml: 'ö', Oslash: 'Ø', oelig: 'œ', Scaron: 'Š', scaron: 'š', uuml: 'ü', yacute: 'ý',
  Omicron: 'Ο', omicron: 'ο', Tau: 'Τ', pi: 'π', lambda: 'λ', gamma: 'γ', alpha: 'α',
};
const decodeEntities = (s) => String(s ?? '').replace(/&(?:#(\d+)|#x([0-9a-f]+)|([A-Za-z][A-Za-z0-9]*));/gi, (m, dec, hex, name) => {
  if (name) return ENTITY[name] ?? m;
  const cp = dec ? Number(dec) : parseInt(hex, 16);
  return cp > 0 && cp <= 0x10ffff ? String.fromCodePoint(cp) : m;
});

// JSON-LD、<meta description>、「地點／縣市」欄用同一份事實，組裝在 src/lib/jsonld/event.mjs；
// 標題與首屏時間在 src/lib/event-meta.mjs（都有測試守著）。
// 場次沒有縣市時，地點退回「地點」欄連過去的場館頁的縣市與地址（eventLocation）。
const venue = primary.venueSlug ? (await venueBySlug()).get(primary.venueSlug) : undefined;
const { ld, description: rawDesc, location: loc } = eventLd(e, { venue });
const metaDesc = decodeEntities(rawDesc);
// ld 為 null：資料裡沒有實體地點或地址，這頁不輸出 Event（理由見 eventLd）
if (ld) ld.description = metaDesc;
// 沒有場館名時，比縣市更具體的地址也算地點（「臺東縣成功鎮海濱公園」）
const place = placeLabel(primary);
const desc = e.description ? decodeEntities(e.description) : '';

const srcUrl = e.sources.find((x) => x.url)?.url;
// 來源給的購票／報名連結（JSON-LD 的 offers.url 用同一個），沒有就不顯示，不自己找
const ticket = ticketLink(e.ticketUrl, e.isFree);
// 官方名稱常整個包一層書名號（「《卡普松與傑洛米二重奏》」），但使用者搜尋時不會打這兩個符號，
// SERP 標題留著它就跟搜尋字不一樣。只拆「整包」的，中間帶書名號的副標不動
// （「《和光同塵：李安成》光塵之間」不拆，因為書名號後面還有字）。H1、JSON-LD 仍用原始 e.title。
const TITLE_WRAPPERS = [['《', '》'], ['「', '」'], ['『', '』'], ['〈', '〉']];
const unwrapTitle = (t) => {
  for (const [open, close] of TITLE_WRAPPERS) {
    if (t.startsWith(open) && t.endsWith(close) && t.length > open.length + close.length) return t.slice(open.length, -close.length);
  }
  return t;
};
// 另一類是前綴標籤而非整包：「【2026臺中國際動畫影展】致遙不可及彼方的你」，
// 使用者搜的是後半段片名，前面的系列/場館名留著只會讓 SERP 標題跟搜尋字對不起來。
// 只拆開頭這一組，且拆完還剩字才拆（「【金．聲相遇】」本身就是活動名，拆了就空了）。
const stripSeriesPrefix = (t) => {
  const m = /^【[^【】]*】\s*(.+)$/.exec(t);
  return m ? m[1] : t;
};
// 搜尋用的別名（overrides/event-title-aliases.json）：放進 <title> 與 JSON-LD alternateName，H1 不動
const alias = titleAliases.aliases?.[e.slug]?.alias;
if (ld && alias) ld.alternateName = alias;
const metaTitle = eventTitle({ ...e, title: unwrapTitle(stripSeriesPrefix(e.title)) }, { alias });
const srcNames = [...new Set(e.sources.map((x) => x.sourceName || x.id))];
const shown = sessions.slice(0, 20);
// 已結束或內容太少的活動退回 noindex，網址仍然存在、站內仍然連得到
const indexable = await isIndexable(`/event/${e.slug}`);
// 分類頁有 ≥5 場的門檻，不檢查就會連到不存在的頁（實測「綜藝」只有 4 場）
const hasCatPage = e.category && (await builtCategories()).has(e.category);
// 縣市 × 月份頁（/city/<縣市>/<YYYY-MM>）：場次月份裡有建頁的，優先還沒過去的月份
const cityMonths = await cityMonthPages();
const monthKeys = loc.city
  ? [...new Set(sessions.map((s) => (s.startAt ?? '').slice(0, 7)))].sort().filter((ym) => cityMonths.has(`${loc.city} ${ym}`))
  : [];
const cityMonth = monthKeys.find((ym) => !cityMonths.get(`${loc.city} ${ym}`).past) ?? monthKeys.at(-1);
// 同一個年度活動的其他屆：搜「活動名＋去年」的人一步走到今年
const editions = (await eventSeries()).get(e.slug) ?? [];
// 同場地、同縣市接下來的活動。已結束的頁放在說明文字之前（讀者要找的是下一場），
// 進行中的放在頁尾之前。
const nearby = await nearbyEvents();
const ended = !nearby.live.has(e.slug);
const near = nearby.pick({ venueSlug: primary.venueSlug, city: loc.city, exclude: [e.slug, ...editions.map((x) => x.slug)] });
const nearProps = { items: near, city: loc.city, venueName: nearby.groupName(primary.venueSlug) ?? primary.venueNameRaw, now: Date.now() };
// 麵包屑：畫面與 BreadcrumbList 同一份
const trail = crumbTrail([
  { name: '今天', href: '/today' },
  loc.city && { name: loc.city, href: `/city/${loc.city}` },
  hasCatPage && { name: e.category, href: `/category/${e.category}` },
], e.title);
---
<Base
  title={metaTitle}
  description={metaDesc}
  noindex={!indexable}
  jsonld={ld}
  breadcrumbs={trail}
>
  <div class="shell">
    <Nav />
    <article class="ev">
      <Breadcrumb trail={trail} />

      <h1>{e.title}</h1>
      {LEAD_SLUGS.has(e.slug) && <p class="lead">{eventLead(e)}</p>}

      <dl class="facts">
        <div><dt>時間</dt><dd class="tabular">
          {/* 日期、時刻各自不斷行，窄螢幕只在空白處換行（原本會把「（二）」拆到下一行） */}
          {whenText(sessions).split(' ').map((part, i) => <>{i > 0 && ' '}<span class="nw">{part}</span></>)}
          {sessions.length > 1 && <span class="n">　共 {sessions.length} 場次</span>}
        </dd></div>
        {place && <div><dt>地點</dt><dd>
          {primary.venueSlug && primary.venueNameRaw
            ? <a href={`/venue/${primary.venueSlug}`}>{place}</a>
            : place}
          {primary.venueNameRaw && loc.street && <span class="n">　{loc.street}</span>}
        </dd></div>}
        {(e.isFree !== undefined || e.priceText) && <div><dt>票價</dt><dd>
          {e.isFree === true ? '免費' : e.priceText || '售票'}
        </dd></div>}
        {ticket && <div><dt>{ticket.label}</dt><dd>
          <a href={ticket.href} target="_blank" rel="nofollow noopener">{ticket.platform}</a>
        </dd></div>}
        {loc.city ? <div><dt>縣市</dt><dd>
          <a href={`/city/${loc.city}`}>{loc.city}</a>{loc.district && <span class="n">　{loc.district}</span>}
          {cityMonth && <span class="n">　<a href={`/city/${loc.city}/${cityMonth}`}>{+cityMonth.slice(5)} 月{loc.city}活動</a></span>}
        </dd></div> : loc.district && <div><dt>地區</dt><dd>{loc.district}</dd></div>}
        {(e.category || e.categoryRaw) && <div><dt>類型</dt><dd>
          {/* 沒有對照到 canonical 的就不連結——分類頁是用對照後的值建的，
              連原始值（「2」「特展」）會連到不存在的頁 */}
          {hasCatPage
            ? <a href={`/category/${e.category}`} style={`color:var(${catVar(e.category)})`}>{e.category}</a>
            : <span class="raw" style={e.category ? `color:var(${catVar(e.category)})` : undefined}>
                {e.category ?? e.categoryRaw}{!e.category && <span class="n">　（尚未對照）</span>}
              </span>}
        </dd></div>}
        {e.minimumAge !== undefined && <div><dt>年齡</dt><dd>{e.minimumAge} 歲以上</dd></div>}
        {e.performers?.length > 0 && <div><dt>演出者</dt><dd>
          {e.performers.map((p) => p.nameRaw).join('、')}
        </dd></div>}
        {e.organizers?.length > 0 && <div><dt>主辦</dt><dd>
          {e.organizers.filter((o) => o.role === 'master').map((o) => o.nameRaw).join('、')
            || e.organizers.map((o) => o.nameRaw).join('、')}
        </dd></div>}
      </dl>

      {/* 購票／報名與原始出處放在說明文字之前：說明常常很長，放後面就掉出首屏 */}
      {(ticket || srcUrl) && (
        <p class="cta">
          {ticket && <a class="btn" href={ticket.href} target="_blank" rel="nofollow noopener">{ticket.label}（{ticket.platform}）</a>}
          {srcUrl && srcUrl !== ticket?.href && <a class={ticket ? 'btn2' : 'btn'} href={srcUrl} target="_blank" rel="noopener">前往原始出處</a>}
          {srcUrl && <span class="src">{srcNames[0]}</span>}
        </p>
      )}

      {ended && <NearbyEvents {...nearProps} />}

      {desc && <div class="desc">{desc}</div>}

      {sessions.length > 1 && (
        <section class="sessions">
          <h2>所有場次</h2>
          <ul>{shown.map((t) => (
            <li>
              <time class="tabular" datetime={t.startAt}>
                {dateLabel(t.startAt)}{hasClockTime(t.startAt, t.granularity) ? ` ${hhmm(t.startAt)}` : ''}
              </time>
              {t.venueNameRaw && t.venueNameRaw !== primary.venueNameRaw && <span class="sv">{t.venueNameRaw}</span>}
            </li>
          ))}</ul>
          {sessions.length > shown.length && <p class="more">另有 {sessions.length - shown.length} 場次</p>}
        </section>
      )}

      {editions.length > 0 && (
        <section class="sessions">
          <h2>其他年份</h2>
          <ul>{editions.map((x) => (
            <li>
              <time class="tabular" datetime={x.start}>{x.start.slice(0, 4)}</time>
              <a href={`/event/${x.slug}`}>{x.title}</a>
            </li>
          ))}</ul>
        </section>
      )}

      {!ended && <NearbyEvents {...nearProps} />}

      <footer class="prov">
        <h2>資料來源</h2>
        <p class="pnote">這一頁由 {e.sources.length} 個來源整理而成。每個欄位各自挑品質最高的來源，落選值也留著。</p>
        <ul class="slist">{e.sources.map((s) => (
          <li>
            <span class="sid">{s.sourceName || s.id}</span>
            <span class="sp">{s.provides.length ? `提供 ${s.provides.join('、')}` : '未被採用'}</span>
            {verified.get(`${s.id}:${s.recordId}`) && (
              <time class="tabular sd">{verified.get(`${s.id}:${s.recordId}`)}</time>
            )}
          </li>
        ))}</ul>
        <p>活動內容以原始出處為準。<a href="/about">資料怎麼來的</a></p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .ev { padding-block: var(--space-7) var(--space-9); max-width: 46rem; }
  h1 { font-family: var(--font-body); font-weight: 700; font-size: var(--text-xl); line-height: 1.35; letter-spacing: 0; }
  .facts { margin: var(--space-6) 0 0; display: grid; gap: 0; border-top: var(--hairline) solid var(--border-subtle); }
  .facts > div {
    display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1.5rem;
    padding: 0.9rem 0; border-bottom: var(--hairline) solid var(--border-subtle);
  }
  .facts dt { color: var(--text-muted); font-size: var(--text-sm); }
  .facts dd { margin: 0; font-size: var(--text-base); }
  .facts .n { color: var(--text-muted); font-size: var(--text-sm); }
  .nw { white-space: nowrap; }
  @media (max-width: 760px) {
    .ev { padding-block: var(--space-5) var(--space-8); }
    .facts { margin-top: var(--space-5); }
    .facts > div { grid-template-columns: 3rem minmax(0, 1fr); gap: 1rem; padding: 0.6rem 0; }
    .cta { margin-top: var(--space-5); }
  }
  .raw { color: var(--text-secondary); }
  .sessions { margin-top: var(--space-7); }
  .sessions h2 { font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-secondary); font-weight: 700; }
  .sessions ul { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; gap: 0.35rem; }
  .sessions li { font-size: var(--text-sm); color: var(--text-secondary); }
  .more { margin-top: 0.6rem; font-size: var(--text-sm); color: var(--text-muted); }
  .cta { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: var(--space-6); }
  .btn {
    display: inline-block; text-decoration: none; font-weight: 700;
    background: var(--color-link); color: var(--bg-base);
    padding: 0.7rem 1.4rem; font-size: var(--text-base);
  }
  .btn2 {
    display: inline-block; text-decoration: none; font-weight: 700; font-size: var(--text-base);
    padding: 0.7rem 1.4rem; border: var(--hairline) solid var(--color-link); color: var(--color-link);
  }
  .src { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--text-muted); }
  .prov {
    margin-top: var(--space-8); padding-top: var(--space-5);
    border-top: var(--hairline) solid var(--border-subtle);
    font-size: var(--text-sm); color: var(--text-muted); display: grid; gap: 0.5rem;
  }
  .prov strong { color: var(--text-secondary); }

  .lead { margin-top: var(--space-4); line-height: 1.75; }
  .desc { margin-top: var(--space-6); white-space: pre-wrap; line-height: 1.75; color: var(--text-secondary); }
  .sessions li { display: flex; gap: 1rem; flex-wrap: wrap; }
  .sv { color: var(--text-muted); }
  .prov h2 { font-family: var(--font-body); font-size: var(--text-sm); color: var(--text-secondary); font-weight: 700; margin: 0; }
  .pnote { margin: 0; }
  .slist { list-style: none; margin: 0.4rem 0; padding: 0; display: grid; gap: 0.3rem; }
  .slist li {
    display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
    gap: 1rem; align-items: baseline;
  }
  .sid { color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sp { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sd { font-family: var(--font-mono); font-size: var(--text-xs); }
</style>

