---
// 首頁：台灣文化探索。雜誌式的閱讀動線，由上往下：
//   主視覺（一句話＋搜尋）｜今日值得探索（右欄，前端用當下時間重算）
//   本週編輯選讀（overrides/editor-picks.json，沒填就自動挑）
//   熱門展覽｜近期即將結束
//   依縣市探索
//   主題策展（這週末、免費、親子、文化資產、月曆、地圖）
//   頁尾：品牌說明＋縣市／類型／排行程索引（兼作 SEO 內部連結）
//
// 各區塊的挑選邏輯在 src/lib/home-picks.mjs（有測試）；這裡只排版。
// 除了「今日」以外都在 build 時算好寫進 HTML——搜尋引擎不保證執行 JS，
// 而站每天重建，「本週」「7 天內」這種粒度不會過期。
import { readFile } from 'node:fs/promises';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { newListings, builtHubs, flatSessions, indexableEvent } from '../lib/build-data.mjs';
import { homeGraph } from '../lib/jsonld/index.mjs';
import { liveEvents, editorPicks, popularExhibitions, endingSoon, cityHighlights, countActive, daysLeftText } from '../lib/home-picks.mjs';
import { todaySessions, mergeRuns } from '../lib/day-lists.mjs';
import { eventsIn, weekendOf, cityShort } from '../lib/hubs.mjs';
import { hhmm, fmtNum, catVar, WD, midnight, mdShort, twYear } from '../lib/format.mjs';

const buildNow = Date.now();
const root = process.cwd();
const stats = JSON.parse(await readFile(`${root}/public/home-stats.json`, 'utf-8'));
let pickConfig = {};
try { pickConfig = JSON.parse(await readFile(`${root}/overrides/editor-picks.json`, 'utf-8')); } catch { /* 沒有設定檔就全自動 */ }

const rows = await flatSessions();
const keep = await indexableEvent();
const events = liveEvents(rows, buildNow, keep);

const picks = editorPicks(events, pickConfig, buildNow);
const popular = popularExhibitions(events, buildNow);
const ending = endingSoon(events, buildNow);
const cities = cityHighlights(events, buildNow);
const activeWeek = countActive(events, buildNow, 7);

const wk = weekendOf(buildNow);
const weekendN = eventsIn(rows, wk.from, wk.to, keep).length;
const freeN = events.filter((e) => e.isFree === true && e.next < midnight(buildNow) + 30 * 86400000).length;
const newThisWeek = (await newListings({ days: 7, limit: 1e6 })).length;

// 今日：build 時先寫一份（沒有 JS 也看得到），前端載入後用當下時間重畫
const todayRows = mergeRuns(todaySessions(rows, buildNow).filter((d) => d.status !== 'cancelled' && keep(d.slug)));
const todayN = new Set(todayRows.map((d) => d.slug)).size;
const todayNext = todayRows.filter((d) => d.dateOnly || d.ts > buildNow).slice(0, 5);

const hubs = await builtHubs();
const yearPages = hubs.year.filter((p) => !p.city && p.year === hubs.thisYear);
const builtCats = new Set(stats.cats.map((c) => c.name));
const ym = new Date(buildNow + 8 * 3600e3).toISOString().slice(0, 7);
const tw0 = new Date(midnight(buildNow) + 12 * 3600e3);
const dayText = `${tw0.getUTCMonth() + 1} 月 ${tw0.getUTCDate()} 日・週${WD[tw0.getUTCDay()]}`;

const href = (slug) => `/event/${encodeURIComponent(slug)}`;
const md = (t) => { const d = new Date(t + 8 * 3600e3); return `${d.getUTCMonth() + 1}/${d.getUTCDate()}（${WD[d.getUTCDay()]}）`; };
/** 活動卡上的時間說法：進行中寫「展至 12/31」，還沒開始寫「11/14（六） 14:30」 */
const when = (e) => {
  if (e.running) return `展至 ${mdShort(e.end, twYear(e.end) !== twYear(buildNow))}`;
  return `${md(e.next)}${e.dateOnly ? '' : ` ${hhmm(e.next)}`}`;
};
const where = (e) => [e.venue, e.city && cityShort(e.city)].filter(Boolean).join('・');
const no = (i) => String(i + 1).padStart(2, '0');

const themes = [
  { k: '這週末', d: `${wk.label} 有 ${fmtNum(weekendN)} 場活動`, u: '/weekend', tone: 'warm', big: true },
  { k: '免費活動', d: `${fmtNum(freeN)} 場不用買票`, u: '/free', tone: 'green' },
  builtCats.has('親子') && { k: '親子藝術', d: '適合帶小孩去的展演與工作坊', u: '/category/親子', tone: 'plain' },
  { k: '文化資產', d: `${fmtNum(stats.heritage)} 處古蹟、歷史建築與聚落`, u: '/heritage', tone: 'plain' },
  { k: '文化活動月曆', d: '用一個月的跨度安排行程', u: `/calendar/${ym}`, tone: 'plain' },
  { k: '文化探索地圖', d: '全台 22 縣市，看今天哪裡最熱鬧', u: '/map', tone: 'ink', wide: true },
].filter(Boolean);
---
<Base
  title="seh — 開始探索台灣文化"
  description="台灣各地正在發生的文化活動、場館、城市與文化資產。從「今天去哪裡」開始探索。"
  jsonld={homeGraph()}
>
  <div class="shell">
    <Nav />

    <!-- 主視覺：一句話、一個搜尋框；右欄是今天 -->
    <header class="hero">
      <div class="hero-main">
        <p class="kicker">台灣文化探索・<span id="day-text">{dayText}</span></p>
        <h1>台灣，<br />正在發生什麼？</h1>
        <p class="lede">展覽、演出、講座、市集與老建築——把散在 {stats.sources} 個公開資料來源裡的文化活動收在一起，從「今天去哪裡」開始探索。</p>
        <form class="search" id="search-form" role="search">
          <input id="q" type="search" autocomplete="off"
            placeholder="想找什麼？台中歌劇院、九月展覽、親子"
            aria-label="搜尋活動、場館、城市" />
          <button type="submit">搜尋</button>
        </form>
        <p class="hint" id="hint">收錄 <b class="tabular">{fmtNum(stats.events)}</b> 場活動、<b class="tabular">{fmtNum(stats.venues)}</b> 個場館、<b class="tabular">{fmtNum(stats.heritage)}</b> 項文化資產{newThisWeek > 0 && <>　<a href="/today#new">本週新上架 <b class="tabular">{newThisWeek}</b> 場 →</a></>}</p>
      </div>

      <aside class="today" aria-labelledby="today-h">
        <p class="kicker" id="today-h">今日值得探索</p>
        <p class="today-n"><b class="tabular" id="n-today">{todayN}</b><span>場活動・現在 <span class="tabular" id="now-h">—</span></span></p>
        <ol class="today-list" id="today-list">
          {todayNext.map((d) => (
            <li><a href={href(d.slug)}>
              <time class="tabular" datetime={d.at}>{d.dateOnly ? '整天' : hhmm(d.ts)}</time>
              <span><span class="t">{d.title}</span><span class="m">{[d.venue, d.city && cityShort(d.city)].filter(Boolean).join('・')}</span></span>
            </a></li>
          ))}
        </ol>
        <p class="today-more"><a href="/today">看今天全部 →</a><a href="/tonight">今晚</a><a href="/nearby">我附近</a></p>
      </aside>
    </header>

    <!-- 本週編輯選讀 -->
    {picks.items.length > 0 && (
      <section class="sec picks" aria-labelledby="picks-h">
        <div class="sec-hd">
          <p class="kicker">{picks.curated ? '本週編輯選讀' : '本週精選'}</p>
          <h2 id="picks-h">{picks.title || '這週值得專程去一趟的'}</h2>
          <p class="sec-intro">{picks.intro || (picks.curated ? '' : `${fmtNum(activeWeek)} 場七天內看得到的活動裡，依登錄來源數與關注度挑出，每個類型一檔。`)}</p>
        </div>
        <ol class="pick-grid">
          {picks.items.map((e, i) => (
            <li><a class="pick" href={href(e.slug)}>
              <span class="pick-no tabular" aria-hidden="true">{no(i)}</span>
              {e.cat && <span class="tag" style={`color:var(${catVar(e.cat)})`}>{e.cat}</span>}
              <h3>{e.title}</h3>
              <p class="pick-when tabular">{when(e)}</p>
              <p class="pick-where">{where(e)}</p>
              {e.note && <p class="pick-note">{e.note}</p>}
            </a></li>
          ))}
        </ol>
      </section>
    )}

    <!-- 熱門展覽｜近期即將結束 -->
    <div class="duo">
      {popular.length > 0 && (
        <section class="sec" aria-labelledby="pop-h">
          <div class="sec-hd">
            <p class="kicker">熱門展覽</p>
            <h2 id="pop-h">正在展、值得看</h2>
          </div>
          <ol class="rank">
            {popular.map((e, i) => (
              <li><a href={href(e.slug)}>
                <span class="rank-no tabular" aria-hidden="true">{i + 1}</span>
                <span class="rank-body"><span class="t">{e.title}</span><span class="m">{where(e)}</span></span>
                <span class="rank-side tabular">{when(e)}</span>
              </a></li>
            ))}
          </ol>
          <p class="sec-more"><a href="/category/展覽">所有展覽 →</a></p>
        </section>
      )}
      {ending.length > 0 && (
        <section class="sec" aria-labelledby="end-h">
          <div class="sec-hd">
            <p class="kicker">近期即將結束</p>
            <h2 id="end-h">把握最後幾天</h2>
          </div>
          <ol class="rank">
            {ending.map((e) => (
              <li><a href={href(e.slug)}>
                <span class="tag tag-urgent">{daysLeftText(e.daysLeft)}</span>
                <span class="rank-body"><span class="t">{e.title}</span><span class="m">{where(e)}</span></span>
                <span class="rank-side tabular">{when(e)}</span>
              </a></li>
            ))}
          </ol>
        </section>
      )}
    </div>

    <!-- 依縣市探索 -->
    {cities.length > 0 && (
      <section class="sec" aria-labelledby="city-h">
        <div class="sec-hd">
          <p class="kicker">依縣市探索</p>
          <h2 id="city-h">這週，各地在忙什麼</h2>
        </div>
        <ul class="city-grid">
          {cities.map((c) => (
            <li><a href={`/city/${c.city}`}>
              <span class="city-k">{cityShort(c.city)}</span>
              <span class="city-n tabular">{fmtNum(c.n)} 場・7 天內</span>
              {c.top && <span class="city-top">{c.top.title}</span>}
            </a></li>
          ))}
        </ul>
        <p class="sec-more"><a href="/city">全部 {stats.cities.length} 個縣市 →</a></p>
      </section>
    )}

    <!-- 主題策展 -->
    <section class="sec" aria-labelledby="theme-h">
      <div class="sec-hd">
        <p class="kicker">主題策展</p>
        <h2 id="theme-h">換個方式逛</h2>
      </div>
      <ul class="theme-grid">
        {themes.map((t) => (
          <li class={t.big ? 'big' : t.wide ? 'wide' : ''}><a class={`theme tone-${t.tone}`} href={t.u}>
            <span class="theme-k">{t.k}</span>
            <span class="theme-d">{t.d}</span>
            <span class="theme-go" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ul>
    </section>
  </div>

  <!-- 頁尾：品牌說明＋索引連結（兼作 SEO 內部連結） -->
  <footer class="site-ft">
    <div class="shell ft-in">
      <div class="ft-brand">
        <p class="ft-logo">seh<span>.tw</span></p>
        <p>seh 整理台灣各地正在發生的文化活動，以及活動所在的場館、城市、人物與文化資產。資料來自 {stats.sources} 個政府與館所的公開資料，每天更新。</p>
        <p><a href="/about">資料怎麼來的 →</a></p>
      </div>
      <nav class="ft-col" aria-label="縣市">
        <h2>台灣各地</h2>
        <ul>
          {stats.cities.slice(0, 8).map((c) => <li><a href={`/city/${c.name}`}>{c.name}</a></li>)}
          <li><a href="/city">全部 {stats.cities.length} 縣市</a></li>
        </ul>
      </nav>
      <nav class="ft-col" aria-label="類型">
        <h2>探索</h2>
        <ul>
          {stats.cats.slice(0, 8).map((c) => <li><a href={`/category/${c.name}`}>{c.name}</a></li>)}
          <li><a href="/venues">場館</a></li>
          <li><a href="/heritage">文化資產</a></li>
        </ul>
      </nav>
      <nav class="ft-col" aria-label="排行程">
        <h2>排行程</h2>
        <ul>
          <li><a href="/today">今天</a></li>
          <li><a href="/tonight">今晚</a></li>
          <li><a href="/weekend">這週末</a></li>
          <li><a href="/free">免費活動</a></li>
          <li><a href={`/calendar/${ym}`}>月曆</a></li>
          {yearPages.map((p) => <li><a href={`/year/${p.year}/${p.group.key}`}>{p.year} {p.group.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </footer>
</Base>

<script>
  import { loadSessions } from '../lib/index-client.mjs';
  import { midnight, hhmm, WD } from '../lib/format.mjs';

  // ── 今日值得探索：用當下時間重算（build 之後時間就前進了） ──
  const now = Date.now();
  const today = new Date(midnight(now) + 8 * 3600000).toISOString().slice(0, 10);
  const nowH = document.getElementById('now-h');
  if (nowH) nowH.textContent = hhmm(now);
  const tw = new Date(midnight(now) + 12 * 3600000);
  const dayText = document.getElementById('day-text');
  if (dayText) dayText.textContent = `${tw.getUTCMonth() + 1} 月 ${tw.getUTCDate()} 日・週${WD[tw.getUTCDay()]}`;

  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const shortCity = (c) => (/^(新竹|嘉義)/.test(c) ? c : c.replace(/[市縣]$/, ''));

  // 首頁只抓今天開始的場次（src/pages/day/[date].json.js），不載全部場次的 /index.json
  fetch(`/day/${today}.json`).then((r) => (r.ok ? r.json() : [])).then((rows) => {
    const list = rows.map(([ev, , , , start, slug, title, venue, city]) => {
      const dateOnly = start.length <= 10;
      const ts = Date.parse(dateOnly ? `${start}T00:00:00+08:00` : `${start.replace(' ', 'T').slice(0, 16)}:00+08:00`);
      return { ev, slug, title, venue, city, dateOnly, ts };
    });
    document.getElementById('n-today').textContent = String(new Set(list.map((d) => d.ev)).size);
    // 還沒開始的依時刻，整天型排在後面；同一活動只列一次
    const seen = new Set();
    const next = list
      .filter((d) => d.dateOnly || d.ts > now)
      .sort((a, b) => (a.dateOnly - b.dateOnly) || a.ts - b.ts)
      .filter((d) => d.slug && !seen.has(d.slug) && seen.add(d.slug))
      .slice(0, 5);
    const ol = document.getElementById('today-list');
    if (!ol) return;
    ol.innerHTML = next.length
      ? next.map((d) => `<li><a href="/event/${encodeURIComponent(d.slug)}">
          <time class="tabular">${d.dateOnly ? '整天' : hhmm(d.ts)}</time>
          <span><span class="t">${esc(d.title)}</span><span class="m">${esc([d.venue, d.city && shortCity(d.city)].filter(Boolean).join('・'))}</span></span>
        </a></li>`).join('')
      : '<li class="today-empty">今天剩下的場次都開始了，<a href="/weekend">看看這週末</a>。</li>';
  }).catch(() => { /* 抓不到就留 build 時的版本 */ });

  // ── 搜尋：打字時才載全文索引，並提示載入中 ──
  const q = document.getElementById('q');
  const hint = document.getElementById('hint');
  const base = hint.innerHTML;
  let idx = null;
  q.addEventListener('input', async () => {
    const v = q.value.trim();
    if (!v) { hint.innerHTML = base; return; }
    if (!idx) { hint.textContent = '載入搜尋索引中⋯'; q.setAttribute('aria-busy', 'true'); idx = await loadSessions(); q.removeAttribute('aria-busy'); }
    if (q.value.trim() !== v) return;
    const hits = idx.filter((d) => (d.title + d.venue + (d.city ?? '')).includes(v));
    hint.innerHTML = hits.length
      ? `找到 <b class="tabular">${hits.length.toLocaleString('en-US')}</b> 場：${hits.slice(0, 2).map((h) => esc(h.title.slice(0, 16))).join('、')}⋯　按 Enter 看全部`
      : '找不到相符的活動，換個說法試試';
  });
  document.getElementById('search-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (q.value.trim()) location.href = `/search?q=${encodeURIComponent(q.value.trim())}`;
  });
</script>

<style>
  /* ── 共用：區塊 ─────────────────────────────── */
  .sec { padding-block: var(--space-8) 0; }
  .sec-hd { border-top: 2px solid var(--seh-ink); padding-top: var(--space-4); margin-bottom: var(--space-5); }
  .sec-hd h2 { margin-top: var(--space-2); font-size: var(--text-xl); }
  .sec-intro { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--text-secondary); max-width: 46em; }
  .sec-intro:empty { display: none; }
  .sec-more { margin-top: var(--space-4); font-size: var(--text-sm); }
  .sec-more a { color: var(--color-link); text-decoration: none; font-weight: 700; }
  .sec-more a:hover { text-decoration: underline; }

  /* ── 主視覺 ─────────────────────────────────── */
  .hero {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8); padding-block: var(--space-8) var(--space-4); align-items: start;
  }
  .hero h1 {
    margin-top: var(--space-4);
    font-size: clamp(2.75rem, 5.6vw, 4.75rem); line-height: 1.08; letter-spacing: -0.03em;
  }
  .lede { margin-top: var(--space-5); font-size: var(--text-base); line-height: 1.7; color: var(--text-secondary); max-width: 30em; }
  .search { display: flex; gap: var(--space-3); margin-top: var(--space-6); }
  .search input {
    flex: 1; min-width: 0; font: inherit; font-size: var(--text-base); min-height: 60px;
    padding: 0 var(--space-5); background: var(--bg-base); color: var(--text-primary);
    border: 2px solid var(--seh-ink); border-radius: 2px;
  }
  .search input::placeholder { color: var(--text-muted); }
  .search input:focus { outline: 3px solid var(--seh-terracotta-weak); outline-offset: 0; border-color: var(--seh-terracotta); }
  .search input[aria-busy="true"] { cursor: progress; }
  .search button {
    flex: none; font: inherit; font-size: var(--text-base); font-weight: 800; cursor: pointer;
    min-height: 60px; padding: 0 var(--space-6); border-radius: 2px;
    background: var(--seh-terracotta); color: var(--bg-base); border: 2px solid var(--seh-terracotta);
    transition: background-color 0.15s, border-color 0.15s;
  }
  .search button:hover { background: var(--seh-ink); border-color: var(--seh-ink); }
  .hint { margin-top: var(--space-3); font-size: var(--text-xs); color: var(--text-secondary); max-width: none; }
  .hint b { color: var(--text-primary); }
  .hint a { color: var(--color-link); text-decoration: none; white-space: nowrap; }

  /* 今日：右欄，墨線框住 */
  .today { border-top: 6px solid var(--seh-terracotta); background: var(--bg-surface); padding: var(--space-5) var(--space-5) var(--space-4); }
  .today-n { display: flex; align-items: baseline; gap: var(--space-3); margin-top: var(--space-2); }
  .today-n b { font-size: var(--text-2xl); line-height: 1; color: var(--seh-terracotta); }
  .today-n > span { font-size: var(--text-sm); color: var(--text-secondary); }
  .today-list { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .today-list :global(li) { border-top: var(--hairline) solid var(--border-subtle); }
  .today-list :global(a) {
    display: grid; grid-template-columns: 4.2rem minmax(0, 1fr); gap: var(--space-3);
    padding: var(--space-3) 0; text-decoration: none; align-items: baseline;
  }
  .today-list :global(time) { font-size: var(--text-sm); font-weight: 700; color: var(--seh-terracotta); }
  .today-list :global(.t) { display: block; font-size: var(--text-xs); font-weight: 600; line-height: 1.45;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .today-list :global(.m) { display: block; font-size: var(--text-xs); color: var(--text-muted); margin-top: 2px; }
  .today-list :global(a:hover .t) { color: var(--color-link); }
  .today-list :global(.today-empty) { padding: var(--space-3) 0; font-size: var(--text-xs); color: var(--text-secondary); }
  .today-more { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); margin-top: var(--space-3); border-top: var(--hairline) solid var(--border-subtle); }
  .today-more a { display: inline-flex; align-items: center; min-height: 44px; font-size: var(--text-xs); text-decoration: none; color: var(--text-secondary); }
