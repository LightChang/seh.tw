---
import Base from '../layouts/Base.astro';

const SITE_URL = 'https://seh.tw';
// 首頁的實體識別（GEO：AI 助理要知道「seh 是誰」才敢引用）。只填站上查得到的事實：
// name/description 取自 README 與 <meta description>，logo 用真的存在的 icon-512.png，
// potentialAction 對應 /search?q= 這個真的能用的搜尋功能（src/pages/search.astro 有讀
// ?q 參數），不是為了湊欄位虛構的能力。沒有法人登記資訊（地址/電話/統編）可查證，不填。
const organizationNode = {
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: 'seh',
  url: SITE_URL,
  logo: `${SITE_URL}/icon-512.png`,
  description: 'seh 整理台灣各地正在發生的文化活動，以及活動所在的場館、城市與文化資產，資料來自公開政府開放資料。',
};
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'seh',
  url: SITE_URL,
  inLanguage: 'zh-Hant-TW',
  publisher: { '@id': `${SITE_URL}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
const homeLd = { '@context': 'https://schema.org', '@graph': [organizationNode, websiteNode] };
---
<Base
  title="seh — 開始探索台灣文化"
  description="台灣各地正在發生的文化活動、場館、城市與文化資產。從「今天去哪裡」開始探索。"
>
  <script type="application/ld+json" set:html={JSON.stringify(homeLd)} slot="head" />
  <main class="page">
    <!-- 上：一個問題 ＋ 一個輸入框 -->
    <header class="ask">
      <p class="label">seh.tw</p>
      <h1>台灣，正在發生什麼？</h1>
      <form class="search" id="search-form" role="search">
        <input id="q" type="search" autocomplete="off"
          placeholder="想找什麼？　台中歌劇院、九月展覽、親子"
          aria-label="搜尋活動、場館、城市" />
        <button type="submit">搜尋</button>
      </form>
      <p class="hint" id="hint">收錄 <b class="tabular" id="n-all">—</b> 場活動、<b class="tabular" id="n-venue">—</b> 個場館、<b class="tabular" id="n-her">—</b> 項文化資產，來自 <b class="tabular" id="n-src">—</b> 個公開資料來源</p>
    </header>

    <!-- 中左：四個門 -->
    <nav class="doors" aria-label="主要入口">
      <a class="door" href="/today">
        <span class="door-k">今天</span>
        <span class="door-d">我今天想出去</span>
        <svg class="viz" id="viz-today" aria-hidden="true"></svg>
        <span class="door-n tabular"><b id="n-today">—</b> 場・現在 <b id="now-h">—</b></span>
      </a>
      <a class="door" href="/nearby">
        <span class="door-k">附近</span>
        <span class="door-d">我這附近有什麼</span>
        <svg class="viz" id="viz-near" aria-hidden="true"></svg>
        <span class="door-n">1／3／5 公里</span>
      </a>
      <a class="door" href="/map">
        <span class="door-k">地圖</span>
        <span class="door-d">我只是想逛逛</span>
        <svg class="viz" id="viz-map" preserveAspectRatio="xMidYMid meet" aria-hidden="true"></svg>
        <span class="door-n tabular">全台 22 縣市</span>
      </a>
      <a class="door" href="/search">
        <span class="door-k">搜尋</span>
        <span class="door-d">我想找特定的</span>
        <svg class="viz" id="viz-cat" aria-hidden="true"></svg>
        <span class="door-n">場館・團體・主題</span>
      </a>
    </nav>

    <!-- 中右：不知道要找什麼的人 -->
    <section class="qwrap">
      <h2 class="h-sm">不知道去哪裡？從這些問題開始</h2>
      <ul class="qs" id="qs"></ul>
    </section>

    <!-- 下：地方與類型，兼作 SEO 內部連結 -->
    <footer class="ft">
      <div class="ft-row">
        <h2 class="h-sm">台灣各地正在發生</h2>
        <ul class="cities" id="cities"></ul>
      </div>
      <div class="ft-row">
        <h2 class="h-sm">探索</h2>
        <ul class="cats" id="cats"></ul>
      </div>
      <p class="about">
        <span>seh.tw 整理台灣各地正在發生的文化活動，以及活動所在的場館、城市、人物與文化資產。</span>
        <a href="/about">資料怎麼來的 →</a>
      </p>
    </footer>
  </main>
</Base>

<script>
  import { loadSessions } from '../lib/index-client.mjs';
  import { midnight, twHour, hhmm } from '../lib/format.mjs';
  import { select } from 'd3-selection';
  import { scaleLinear } from 'd3-scale';
  import { geoMercator, geoPath } from 'd3-geo';
  import { timer } from 'd3-timer';

  const css = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  // 顏色帶語意：每個類型固定一色，全站一致。色票取自設計系統既有的功能色彩。
  const CAT_COLOR = {
    展覽: '--color-indigo', 音樂: '--color-cyan', 戲劇: '--color-pink',
    講座: '--color-low', 電影: '--color-purple', 節慶: '--color-high',
    舞蹈: '--color-medium', 親子: '--color-pass', 表演: '--color-pink',
  };
  const catColor = (n) => css(CAT_COLOR[n] ?? '--text-muted');

  const [s, sessions] = await Promise.all([
    (await fetch('/home-stats.json')).json(),
    loadSessions(),
  ]);
  // 「今天」「今晚」跟當下時間有關，不能是 build 時算好的靜態值——那隔天就過期了。
  // 只有 dateOnly=false 的場次才判得出 19:00 之後（常設展的時刻是不存在不是零點）。
  const _d0 = new Date(midnight(Date.now()));   // 台灣的今天，不看訪客時區
  const _d1 = _d0.getTime() + 86400000;
  const _inToday = (d) => { const t = new Date(d.at).getTime(); return t >= _d0.getTime() && t < _d1; };
  s.today = new Set(sessions.filter(_inToday).map((d) => d.slug)).size;
  s.tonight = new Set(sessions.filter((d) => !d.dateOnly && _inToday(d)
    && twHour(d.at) >= 19).map((d) => d.slug)).size;

  const fmt = (n) => n.toLocaleString('en-US');
  // 這些數字每天都會變，寫死就會過期——實測寫死的「2,376 個場館、70 個來源」
  // 在場館變成 10,609、來源變成 80 之後整整錯了一輪。
  for (const [id, v] of [['n-all', s.events], ['n-venue', s.venues],
                         ['n-her', s.heritage], ['n-src', s.sources],
                         ['n-today', s.today]]) {
    const el = document.getElementById(id);
    if (el && v != null) el.textContent = fmt(v);
  }
  const catN = s.catsAll ?? {};
  const topCity = s.cities[0];

  // 問句就是入口，數字是真實答案。少於 20 場的問句不放首頁——
  // 點進去只有個位數會讓人失望，門檻由資料每天決定，不寫死。
  const MIN = 20;
  const pool = [
    { q: '最近有哪些展覽？', n: catN['展覽'], u: '/category/展覽', c: '展覽' },
    { q: '今晚哪裡有表演？', n: s.tonight, u: '/tonight' },
    { q: '這週有什麼音樂活動？', n: catN['音樂'], u: '/category/音樂', c: '音樂' },
    { q: '有哪些戲劇演出？', n: catN['戲劇'], u: '/category/戲劇', c: '戲劇' },
    { q: '有哪些適合帶小孩的？', n: catN['親子'], u: '/category/親子', c: '親子' },
    { q: `看看${topCity.name}最近發生什麼`, n: topCity.n, u: `/city/${topCity.name}` },
    { q: '附近有哪些文化場館？', n: s.venues, u: '/venues' },
    { q: '有哪些講座可以聽？', n: catN['講座'], u: '/category/講座', c: '講座' },
  ].filter((x) => (x.n ?? 0) >= MIN).slice(0, 6);

  document.getElementById('qs').innerHTML = pool.map((x) => `
    <li><a href="${x.u}">
      <span class="q-t">${x.q}</span>
      <span class="q-n tabular" style="color:${x.c ? catColor(x.c) : css('--color-link')}">${fmt(x.n)}</span>
    </a></li>`).join('');

  document.getElementById('cities').innerHTML = s.cities.slice(0, 6).map((c) => `
    <li><a href="/city/${c.name}">${c.name}<span class="tabular">${fmt(c.n)}</span></a></li>`).join('')
    + `<li><a class="all" href="/city">全部 ${s.cities.length} 縣市 →</a></li>`;

  document.getElementById('cats').innerHTML = s.cats.slice(0, 6).map((c) => `
    <li><a href="/category/${c.name}"><span class="c-name" style="color:${catColor(c.name)}">${c.name}</span><span class="tabular">${fmt(c.n)}</span></a></li>`).join('');

  // ── 四個門的底圖視覺 ──────────────────────────
  // viewBox 用容器的實際像素，圖形才會填滿整塊區域又不變形
  function canvas(sel) {
    const el = document.querySelector(sel);
    const r = el.getBoundingClientRect();
    const W = Math.max(1, Math.round(r.width));
    const H = Math.max(1, Math.round(r.height));
    return { svg: select(sel).attr('viewBox', `0 0 ${W} ${H}`), W, H };
  }

  const up = await loadSessions();
  const geo = await (await fetch('/tw-counties.json')).json();
  const now = new Date();
  // 台灣的日期與時刻。toISOString() 是 UTC，台灣 00:00–08:00 會變成前一天。
  const today = new Date(midnight(now) + 8 * 3600000).toISOString().slice(0, 10);
  document.getElementById('now-h').textContent = hhmm(now);
  const [nowH, nowM] = hhmm(now).split(':').map(Number);

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // 每個效果回傳自己的播放函式，接受 0–1 的進度；skip=true 時直接畫最終狀態
  const scenes = [];

  // 今天：24 小時密度，游標掃到現在
  {
    const { svg, W, H } = canvas('#viz-today');
    const per = new Array(24).fill(0);
    const cat = new Array(24).fill(null);
    up.filter((d) => d.at.slice(0, 10) === today).forEach((d) => {
      const h = +d.at.slice(11, 13);
      per[h]++; if (!cat[h]) cat[h] = d.cat;
    });
    const maxV = Math.max(...per, 1);
    const w = W / 24;
    const bars = svg.selectAll('rect').data(per).join('rect')
      .attr('x', (v, i) => i * w + 0.5).attr('width', Math.max(1, w - 1))
      .attr('y', H).attr('height', 0)
      .attr('fill', (v, i) => (cat[i] ? catColor(cat[i]) : css('--border-subtle')))
      .attr('opacity', 0.55);
    const nowX = (nowH + nowM / 60) * w;
    const cursor = svg.append('line').attr('y1', 0).attr('y2', H)
      .attr('stroke', css('--text-primary')).attr('stroke-width', 1.5)
      .attr('opacity', 0.5).attr('x1', 0).attr('x2', 0);
    scenes.push((k) => {
      const e = 1 - Math.pow(1 - k, 3);
      cursor.attr('x1', e * nowX).attr('x2', e * nowX);
      bars.attr('height', (v, i) => (i * w <= e * nowX ? (v / maxV) * (H - 10) : 0))
          .attr('y', (v, i) => (i * w <= e * nowX ? H - (v / maxV) * (H - 10) : H));
    });
  }

  // 附近：1／3／5 公里同心圓由內往外
  {
    const { svg, W, H } = canvas('#viz-near');
    const g = svg.append('g').attr('transform', `translate(${W / 2},${H / 2})`);
    const R = W / 2 - 2;
    const rings = [R, R * 0.66, R * 0.33].map((r, i) =>
      ({ r, el: g.append('circle').attr('r', 0).attr('fill', 'none')
        .attr('stroke', css('--color-link')).attr('stroke-width', 1.4)
        .attr('opacity', 0.18 + i * 0.14) }));
    const core = g.append('circle').attr('r', 0).attr('fill', css('--color-link')).attr('opacity', 0.65);
    scenes.push((k) => {
      const e = 1 - Math.pow(1 - k, 3);
      core.attr('r', 5 * Math.min(1, k * 3));
      rings.forEach((x, i) => {
        const kk = Math.max(0, Math.min(1, (e - i * 0.12) / 0.88));
        x.el.attr('r', x.r * kk);
      });
    });
  }

  // 地圖：台灣輪廓＋今日活動點，右側縣市橫條
  {
    const { svg, W, H } = canvas('#viz-map');
    const main = { type: 'FeatureCollection',
      features: geo.features.filter((f) => !['金門縣', '連江縣'].includes(f.properties.name)) };
    const proj = geoMercator().fitExtent([[10, 6], [W - 10, H - 6]], main);
    svg.append('g').selectAll('path').data(main.features).join('path')
      .attr('d', geoPath(proj)).attr('fill', css('--bg-overlay')).attr('stroke', 'none').attr('opacity', 0.9);
    // 投影可能回 [NaN, NaN]（不是 null），?? 接不到，SVG 會噴 attribute error。
    // 先投影過濾掉算不出座標的，再畫。
    const pts = up
      .filter((d) => d.lat != null && d.lng != null && d.at.slice(0, 10) === today)
      .map((d) => ({ ...d, xy: proj([d.lng, d.lat]) }))
      .filter((d) => d.xy && Number.isFinite(d.xy[0]) && Number.isFinite(d.xy[1]));
    const dots = svg.append('g').selectAll('circle').data(pts).join('circle')
      .attr('cx', (d) => d.xy[0])
      .attr('cy', (d) => d.xy[1])
      .attr('r', 0).attr('fill', (d) => catColor(d.cat)).attr('opacity', 0.6);
    scenes.push((k) => {
      dots.attr('r', (d, i) => (i / pts.length <= k ? 3.6 : 0));
    });
  }

  // 搜尋：六個類型的場次柱
  {
    const { svg, W, H } = canvas('#viz-cat');
    const top = s.cats.slice(0, 6);
    const h = scaleLinear().domain([0, top[0].n]).range([0, H - 16]);
    const slot = W / top.length;
    const bw = Math.max(6, slot * 0.5);
    const rects = svg.selectAll('rect').data(top).join('rect')
      .attr('x', (d, i) => i * slot + (slot - bw) / 2).attr('width', bw)
      .attr('y', H).attr('height', 0)
      .attr('fill', (d) => catColor(d.name)).attr('opacity', 0.5);
    scenes.push((k) => {
      const e = 1 - Math.pow(1 - k, 3);
      rects.attr('height', (d) => h(d.n) * e).attr('y', (d) => H - h(d.n) * e);
    });
  }

  // 遮罩範圍用量測的文字右邊界決定，不用估算的百分比。
  // 字型載入前後寬度會變，所以等 fonts.ready；視窗改變也要重算。
  function fitMasks() {
    const range = document.createRange();
    document.querySelectorAll('.door').forEach((door) => {
      const box = door.getBoundingClientRect();
      let right = 0;
      door.querySelectorAll('.door-k, .door-d, .door-n').forEach((t) => {
        // 元素是 flex 子項會撐滿容器寬，要用 Range 量文字實際佔的矩形
        range.selectNodeContents(t);
        const r = range.getBoundingClientRect();
        if (r.width) right = Math.max(right, r.right - box.left);
      });
      const pct = (right / box.width) * 100;
      door.style.setProperty('--mask-solid', `${Math.min(96, pct + 1).toFixed(1)}%`);
      door.style.setProperty('--mask-mid', `${Math.min(98, pct + 12).toFixed(1)}%`);
      door.style.setProperty('--mask-end', `${Math.min(100, pct + 26).toFixed(1)}%`);
    });
  }
  fitMasks();
  if (document.fonts?.ready) document.fonts.ready.then(fitMasks);
  addEventListener('resize', () => { clearTimeout(window.__mt); window.__mt = setTimeout(fitMasks, 120); });

  // 依序播放，一格畫完才輪到下一格
  if (still) {
    scenes.forEach((play) => play(1));
  } else {
    const EACH = 900, GAP = 220;
    scenes.forEach((play, i) => {
      setTimeout(() => {
        const t = timer((el) => {
          const k = Math.min(1, el / EACH);
          play(k);
          if (k === 1) t.stop();
        });
      }, i * (EACH + GAP));
    });
  }

  const q = document.getElementById('q');
  const hint = document.getElementById('hint');
  const base = hint.innerHTML;
  let idx = null;
  q.addEventListener('input', async () => {
    const v = q.value.trim();
    if (!v) { hint.innerHTML = base; return; }
    if (!idx) idx = await loadSessions();
    const hits = idx.filter((d) => (d.title + d.venue + (d.city ?? '')).includes(v));
    hint.innerHTML = hits.length
      ? `找到 <b class="tabular">${fmt(hits.length)}</b> 場：${hits.slice(0, 2).map((h) => h.title.slice(0, 16)).join('、')}⋯`
      : '找不到相符的活動，換個說法試試';
  });
  document.getElementById('search-form').addEventListener('submit', (e) => {
    e.preventDefault();
    if (q.value.trim()) location.href = `/search?q=${encodeURIComponent(q.value.trim())}`;
  });
</script>

<style>
  .page {
    height: 100vh; height: 100dvh;
    display: grid;
    grid-template-columns: 44% 1fr;
    grid-template-rows: 33% minmax(0, 1fr) 25%;
    grid-template-areas: "ask ask" "doors qs" "ft ft";
    column-gap: 5%;
    padding-inline: 4%;
    overflow: hidden;
  }

  /* ── 上：問題與輸入 ─────────────────────────── */
  .ask { grid-area: ask; padding-block: 2.2% 1.2%; align-self: center; }
  .ask h1 { font-size: clamp(1.75rem, 3.4vw, 2.75rem); margin: 0.25rem 0 1.1rem; }
  .search { display: flex; gap: 0.75rem; width: 100%; }
  .search input {
    flex: 1; min-width: 0; font: inherit; font-size: var(--text-base);
    padding: 0.7rem 1.05rem; background: var(--bg-surface);
    border: var(--hairline) solid var(--border-subtle); color: var(--text-primary);
  }
  .search input::placeholder { color: var(--text-muted); }
  .search input:focus { outline: 2px solid var(--color-link); outline-offset: 2px; }
  .search button {
    font: inherit; font-size: var(--text-base); font-weight: 700; cursor: pointer;
    padding: 0.7rem 1.4rem; background: var(--color-link); color: var(--bg-base);
    border: var(--hairline) solid var(--color-link);
  }
  .hint { font-size: var(--text-sm); color: var(--text-secondary); margin-top: 0.7rem; max-width: none; }
  .hint b { color: var(--text-primary); }

  /* ── 中左：四個門 ───────────────────────────── */
  .doors {
    grid-area: doors; align-self: stretch; min-height: 0; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr;
    border-top: var(--hairline) solid var(--border-subtle);
  }
  .door {
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center; gap: 0.3rem;
    padding: 1.1rem 1.2rem; text-decoration: none;
    border-bottom: var(--hairline) solid var(--border-subtle);
  }
  /* 視覺當底圖：從格子左側 1/3 一路鋪到最右邊，文字疊在上層 */
  .viz {
    position: absolute; inset: 0 0 0 33%;
    width: auto; height: 100%; display: block;
    z-index: 0; pointer-events: none; opacity: 0.95;
  }
  /* 由左而右淡出的遮罩：讓文字區的底圖退到背景，右側保持清晰 */
  .door::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(
      to right,
      var(--bg-base) 0%,
      var(--bg-base) var(--mask-solid, 36%),
      color-mix(in oklch, var(--bg-base) 45%, transparent) var(--mask-mid, 52%),
      transparent var(--mask-end, 66%)
    );
  }
  .door-k, .door-d, .door-n { position: relative; z-index: 2; }
  .door:nth-child(odd) { padding-left: 0; border-right: var(--hairline) solid var(--border-subtle); }
  .door:hover .door-k { color: var(--color-link); }
  .door-k { font-family: var(--font-display); font-weight: 800; font-size: var(--text-xl); }
  .door-d { font-size: var(--text-sm); color: var(--text-secondary); white-space: nowrap; }

  .door-n { font-size: var(--text-xs); color: var(--text-muted); font-family: var(--font-mono); white-space: nowrap; }
  .door-n b { color: var(--color-link); }

  /* ── 中右：問句 ─────────────────────────────── */
  .h-sm {
    font-family: var(--font-body); font-weight: 700; font-size: var(--text-sm);
    letter-spacing: 0; color: var(--text-secondary);
  }
  .qwrap { grid-area: qs; align-self: stretch; min-width: 0; min-height: 0; overflow: hidden; }
  .qs { list-style: none; margin: 0.7rem 0 0; padding: 0; }
