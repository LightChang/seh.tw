---
// 首頁：seh. 生活探索誌——「不知道去哪裡，就打開 seh。」
//
// 給忙碌、突然有一段空閒、不想花時間搜尋比較的人：打開就有人替他挑好。
// 比重約 70% 生活靈感推薦 + 20% 個人化探索 + 10% 資料搜尋：
//   主視覺＋今日靈感（每天換）               ← 靈感
//   你有多少時間 × 想要什麼感覺（＋定位）    ← 個人化
//   今晚去哪裡？／週末不無聊／即將結束／主題   ← 靈感
//   深入探索（搜尋、縣市、場館、文化資產）    ← 資料
//
// 推薦邏輯在 src/lib/inspire.mjs（有測試）。卡片 build 時先畫一份，前端再用當下時間重算。
// 每張卡片的點擊都帶 data-goal="event_open" data-method="<入口>"，Base.astro 送 GA 事件，
// 用來比較各推薦入口的轉換率（指標定義見 docs/METRICS.md）。
import { readFile } from 'node:fs/promises';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import InspirePicker from '../components/InspirePicker.astro';
import { inspirePool, liveEventList, builtHubs, flatSessions } from '../lib/build-data.mjs';
import { todaySessions, mergeRuns, runningToday } from '../lib/day-lists.mjs';
import { homeGraph } from '../lib/jsonld/index.mjs';
import { editorPicks, endingSoon, daysLeftText } from '../lib/home-picks.mjs';
import { match, cardHtml, MOODS, whenLabel } from '../lib/inspire.mjs';
import { iconSvg, catIcon, MOOD_ICON } from '../lib/icons.mjs';
import { weekendOf, cityShort } from '../lib/hubs.mjs';
import { fmtNum, midnight, WD } from '../lib/format.mjs';

const buildNow = Date.now();
const t0 = midnight(buildNow);
const root = process.cwd();
const stats = JSON.parse(await readFile(`${root}/public/home-stats.json`, 'utf-8'));
let pickConfig = {};
try { pickConfig = JSON.parse(await readFile(`${root}/overrides/editor-picks.json`, 'utf-8')); } catch { /* 全自動 */ }

const pool = await inspirePool(buildNow);
const live = await liveEventList(buildNow);
// build 在清晨跑，「現在」的窗口沒意義；SSR 先用當天中午的快照，前端載入後用真正的現在重算
const snap = Math.max(buildNow, t0 + 11 * 3600e3);

// 今日靈感：每種心情各挑一個，不一定最熱門——在前幾名裡依日期輪替，每天看到的不一樣
const daySeed = Math.floor(t0 / 86400000);
const todayPool = match(pool, { time: 'halfday', mood: 'now', now: snap });
const inspo = [];
const used = new Set();
for (const [i, m] of ['solo', 'friends', 'escape', 'different'].entries()) {
  const cands = todayPool.filter((r) => r.it.m.includes(m) && !used.has(r.it.s)).slice(0, 6);
  if (!cands.length) continue;
  const r = cands[(daySeed + i) % cands.length];
  used.add(r.it.s);
  inspo.push({ r, mood: MOODS.find((x) => x.key === m), tone: { solo: 'sage', friends: 'coral', escape: 'forest', different: 'sun' }[m] });
}

const tonight = match(pool, { time: 'tonight', mood: 'now', now: snap }).filter((r) => !used.has(r.it.s)).slice(0, 8);
const wk = weekendOf(buildNow);
const weekendAll = match(pool, { time: 'weekend', mood: 'now', now: buildNow });
// 週末：各種心情輪流挑，不要整排都是展覽
const weekend = [];
const perMood = new Map();
for (const r of weekendAll) {
  const k = r.it.m[0];
  if ((perMood.get(k) ?? 0) >= 2) continue;
  perMood.set(k, (perMood.get(k) ?? 0) + 1);
  weekend.push(r);
  if (weekend.length >= 8) break;
}

const picks = editorPicks(live, pickConfig, buildNow);
const ending = endingSoon(live, buildNow, { limit: 4 });
const hubs = await builtHubs();
const yearPages = hubs.year.filter((p) => !p.city && p.year === hubs.thisYear);
const ym = new Date(buildNow + 8 * 3600e3).toISOString().slice(0, 7);
const tw0 = new Date(t0 + 12 * 3600e3);
const dayText = `${tw0.getUTCMonth() + 1} 月 ${tw0.getUTCDate()} 日・週${WD[tw0.getUTCDay()]}`;
// 「今天有幾個活動」與 /today 頁首同一套算法（day-lists.mjs）：今天開始的＋展期跨過今天的。
// 數字連到 /today，點進去看到的總數就是這兩個加起來。
const allSessions = await flatSessions();
const todayCount = mergeRuns(todaySessions(allSessions, buildNow)).length + runningToday(allSessions, buildNow).length;

const cards = (list, entry) => list.map((r) => cardHtml(r, { entry, now: snap })).join('');
const href = (slug) => `/event/${encodeURIComponent(slug)}`;
const md = (t) => { const d = new Date(t + 8 * 3600e3); return `${d.getUTCMonth() + 1}/${d.getUTCDate()}`; };

const themes = [
  { k: '一個人也很好', d: '看展、電影、書店、散步', u: '/explore?mood=solo&time=halfday', tone: 'sage', icon: MOOD_ICON.solo },
  { k: '找朋友一起玩', d: '市集、音樂、節慶、表演', u: '/explore?mood=friends&time=weekend', tone: 'coral', icon: MOOD_ICON.friends },
  { k: '逃離日常一下', d: '戶外、節慶、文化小旅行', u: '/explore?mood=escape&time=weekend', tone: 'forest', icon: MOOD_ICON.escape },
  { k: '想做點不一樣的', d: '手作、工作坊、講座', u: '/explore?mood=different&time=weekend', tone: 'sun', icon: MOOD_ICON.different },
  { k: '帶小孩出門', d: '親子展演與工作坊', u: '/category/親子', tone: 'plain', icon: MOOD_ICON.kids },
  { k: '不花錢也很好玩', d: '免費的展覽與活動', u: '/free', tone: 'plain', icon: MOOD_ICON.free },
];
---
<Base
  title="seh — 不知道去哪裡，就打開 seh"
  description="突然有空，卻不知道去哪？告訴 seh 你有多少時間、想要什麼感覺，馬上推薦台灣各地現在可以去的展覽、表演、市集與文化小旅行。"
  jsonld={homeGraph()}
>
  <div class="shell">
    <Nav current="home" />

    <!-- 主視覺：一句話＋幫我決定；右邊是今日靈感 -->
    <header class="hero">
      <div class="hero-main">
        <p class="hero-k"><span class="sticker">給生活一點意外的精彩</span><span class="day" id="day-text">{dayText}</span></p>
        <h1>不知道去哪裡，<br />就打開 <span class="logo-in">seh</span>。</h1>
        <p class="lede">不必事先規劃，也不必知道自己想去哪裡。今天有 <a class="today-n" href="/today" data-goal="nav" data-method="hero_today"><b class="tabular">{fmtNum(todayCount)}</b> 個活動</a>可以去，挑一個出門吧。</p>
        <p class="hero-acts">
          <button type="button" class="btn-go big" data-decide data-entry="home_hero"><span class="bi" set:html={iconSvg('dice')} />幫我決定！</button>
          <a class="btn-ghost" href="#pick" data-goal="nav" data-method="hero_pick">我自己挑</a>
        </p>
        <p class="hero-note">A little spontaneity in everyday life.</p>
      </div>

      {inspo.length > 0 && (
        <aside class="inspo" aria-labelledby="inspo-h">
          <p class="inspo-k" id="inspo-h">今日靈感</p>
          <ol class="inspo-list">
            {inspo.map(({ r, mood, tone }) => (
              <li><a class="ins" href={r.it.k === 'heritage' ? `/heritage/${encodeURIComponent(r.it.s)}` : href(r.it.s)} data-goal="event_open" data-method="home_inspo">
                <span class={`ins-ico tone-${tone}`} set:html={iconSvg(r.it.k === 'heritage' ? 'roof' : catIcon(r.it.c))} />
                <span class="ins-body">
                  <span class="ins-mood">{mood.label}</span>
                  <span class="ins-t">{r.it.t}</span>
                  <span class="ins-m">{[whenLabel(r.av, snap), r.it.v, r.it.ci && cityShort(r.it.ci)].filter(Boolean).join('・')}</span>
                </span>
              </a></li>
            ))}
          </ol>
        </aside>
      )}
    </header>

    <!-- 個人化：時間 × 心情 -->
    <section class="sec pick" id="pick" aria-labelledby="pick-h">
      <div class="sec-hd">
        <h2 id="pick-h">告訴 seh 你現在的狀態</h2>
        <p class="sec-sub">兩個問題，馬上給你現在可以去的地方。</p>
      </div>
      <InspirePicker ssr={cards(match(pool, { time: 'soon', mood: 'now', now: snap }).slice(0, 8), 'home_picker_soon_now')} limit={8} time="soon" mood="now" weekendHint={wk.label} />
    </section>

    <!-- 今晚去哪裡？ -->
    <section class="sec" aria-labelledby="tonight-h">
      <div class="sec-hd row">
        <div><p class="kicker">下班後</p><h2 id="tonight-h">今晚去哪裡？</h2></div>
        <a class="sec-more" href="/tonight">看今晚全部 →</a>
      </div>
      <div class="spot-row" id="row-tonight" set:html={cards(tonight, 'home_tonight') || '<p class="spot-empty">今晚的場次都開始了，看看明天或這週末？</p>'} />
    </section>

    <!-- 週末不無聊 -->
    {weekend.length > 0 && (
      <section class="sec" aria-labelledby="wk-h">
        <div class="sec-hd row">
          <div><p class="kicker">{wk.label}</p><h2 id="wk-h">週末不無聊</h2></div>
          <a class="sec-more" href="/weekend">這週末全部 →</a>
        </div>
        <div class="spot-row" set:html={cards(weekend, 'home_weekend')} />
      </section>
    )}

    <!-- 本週編輯選讀：只有人工挑的才出（自動挑的由今日靈感承擔） -->
    {picks.curated && (
      <section class="sec editor" aria-labelledby="ed-h">
        <div class="sec-hd">
          <p class="kicker">本週編輯選讀</p>
          <h2 id="ed-h">{picks.title || '這週值得專程去一趟的'}</h2>
          {picks.intro && <p class="sec-sub">{picks.intro}</p>}
        </div>
        <ol class="ed-list">
          {picks.items.map((e, i) => (
            <li><a href={href(e.slug)} data-goal="event_open" data-method="home_editor">
              <span class="ed-no tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="ed-t">{e.title}</span>
              {e.note && <span class="ed-note">{e.note}</span>}
              <span class="ed-p">{[e.venue, e.city && cityShort(e.city)].filter(Boolean).join('・')}</span>
            </a></li>
          ))}
        </ol>
      </section>
    )}

    <!-- 近期即將結束 -->
    {ending.length > 0 && (
      <section class="sec" aria-labelledby="end-h">
        <div class="sec-hd"><p class="kicker">別錯過</p><h2 id="end-h">快要結束了</h2></div>
        <ul class="end-list">
          {ending.map((e) => (
            <li><a href={href(e.slug)} data-goal="event_open" data-method="home_ending">
              <span class="end-left">{daysLeftText(e.daysLeft)}</span>
              <span class="end-t">{e.title}</span>
              <span class="end-p">{[e.venue, e.city && cityShort(e.city)].filter(Boolean).join('・')}・展至 {md(e.end)}</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    <!-- 主題 -->
    <section class="sec" aria-labelledby="theme-h">
      <div class="sec-hd"><p class="kicker">換個方式逛</p><h2 id="theme-h">今天是哪一種心情？</h2></div>
      <ul class="themes">
        {themes.map((t) => (
          <li><a class={`theme tone-${t.tone}`} href={t.u} data-goal="nav" data-method="home_theme">
            <span class="theme-k">{t.k}</span><span class="theme-d">{t.d}</span>
            <span class="theme-ico" set:html={iconSvg(t.icon)} />
            <span class="theme-go" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ul>
    </section>

    <!-- 深入探索（資料搜尋，約一成） -->
    <section class="sec deep" aria-labelledby="deep-h">
      <h2 id="deep-h" class="deep-h">已經知道要找什麼？</h2>
      <form class="deep-search" action="/search" role="search">
        <input name="q" type="search" placeholder="場館、表演團體、活動名稱" aria-label="搜尋" />
        <button type="submit">搜尋</button>
      </form>
      <p class="deep-links">
        <a href="/city">依縣市</a><a href="/venues">場館</a><a href="/heritage">文化資產</a>
        <a href={`/calendar/${ym}`}>月曆</a><a href="/map">地圖</a><a href="/free">免費活動</a>
      </p>
    </section>
  </div>

  <footer class="site-ft">
    <div class="shell ft-in">
      <div class="ft-brand">
        <p class="ft-logo">seh<span>.</span></p>
        <p class="ft-slogan">不知道去哪裡，就打開 seh。</p>
        <p>seh 是生活探索誌：每天從 {stats.sources} 個政府與館所的公開資料裡，整理台灣各地正在發生的展覽、表演、市集與文化景點。</p>
        <p><a href="/about">資料怎麼來的 →</a></p>
      </div>
      <nav class="ft-col" aria-label="縣市">
        <h2>台灣各地</h2>
        <ul>
          {stats.cities.slice(0, 8).map((c) => <li><a href={`/city/${c.name}`}>{c.name}</a></li>)}
          <li><a href="/city">全部 {stats.cities.length} 縣市</a></li>
        </ul>
      </nav>
      <nav class="ft-col" aria-label="類型">
        <h2>類型</h2>
        <ul>
          {stats.cats.slice(0, 8).map((c) => <li><a href={`/category/${c.name}`}>{c.name}</a></li>)}
          <li><a href="/venues">場館</a></li>
          <li><a href="/heritage">文化資產</a></li>
        </ul>
      </nav>
      <nav class="ft-col" aria-label="排行程">
        <h2>排行程</h2>
        <ul>
          <li><a href="/explore">探索</a></li>
          <li><a href="/today">今天</a></li>
          <li><a href="/tonight">今晚</a></li>
          <li><a href="/weekend">這週末</a></li>
          <li><a href="/free">免費活動</a></li>
          <li><a href={`/calendar/${ym}`}>月曆</a></li>
          {yearPages.map((p) => <li><a href={`/year/${p.year}/${p.group.key}`}>{p.year} {p.group.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </footer>
</Base>

<script>
  import { loadPool, results, bindDecide } from '../lib/inspire-client.mjs';
  import { cardHtml } from '../lib/inspire.mjs';
  import { midnight, WD } from '../lib/format.mjs';

  bindDecide();
  const now = Date.now();
  const tw = new Date(midnight(now) + 12 * 3600000);
  const day = document.getElementById('day-text');
  if (day) day.textContent = `${tw.getUTCMonth() + 1} 月 ${tw.getUTCDate()} 日・週${WD[tw.getUTCDay()]}`;

  // 「今晚」用真正的現在重算（build 是清晨跑的）
  loadPool().then((pool) => {
    const row = document.getElementById('row-tonight');
    if (!row) return;
    const list = results(pool, { time: 'tonight', mood: 'now', loc: null, now }).slice(0, 8);
    row.innerHTML = list.length
      ? list.map((r) => cardHtml(r, { entry: 'home_tonight', now })).join('')
      : '<p class="spot-empty">今晚的場次都開始了，看看明天或這週末？</p>';
  });
</script>

<style>
  .sec { padding-top: var(--space-9); }
  .sec-hd { margin-bottom: var(--space-5); }
  .sec-hd.row { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); }
  .sec-hd h2 { font-size: clamp(2rem, 3.2vw, 2.75rem); letter-spacing: -0.02em; margin-top: var(--space-1); }
  .sec-sub { margin-top: var(--space-2); font-size: var(--text-sm); color: var(--text-secondary); }
  .kicker { color: var(--seh-coral-deep); }
  .sec-more { display: inline-flex; align-items: center; min-height: 44px; white-space: nowrap; font-size: var(--text-xs); font-weight: 800; color: var(--seh-forest); text-decoration: none; }
  .sec-more:hover { text-decoration: underline; }

  /* ── 主視覺 ── */
  /* 電腦上左右兩欄同高、一個畫面放得下（1366×768 實測不必往下捲） */
  .hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-8); align-items: stretch; padding-top: var(--space-7); }
  .hero-main { display: flex; flex-direction: column; justify-content: center; }
  .hero-k { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .sticker { display: inline-block; padding: 0.3em 0.9em; border-radius: 999px; background: var(--seh-sun); font-size: var(--text-xs); font-weight: 800; transform: rotate(-2deg); }
  .day { font-size: var(--text-xs); color: var(--text-secondary); }
  .today-n { color: var(--seh-forest); }
  .hero h1 { margin-top: var(--space-4); font-size: clamp(2.75rem, 5.2vw, 4.5rem); line-height: 1.1; letter-spacing: -0.035em; }
  .logo-in { color: var(--seh-forest); position: relative; white-space: nowrap; z-index: 0; }
  .logo-in::after { content: ''; position: absolute; left: -2%; right: -2%; bottom: 0.06em; height: 0.28em; background: var(--seh-coral); opacity: 0.55; z-index: -1; border-radius: 4px; }
  .lede { margin-top: var(--space-5); font-size: var(--text-base); line-height: 1.7; color: var(--text-secondary); max-width: 28em; }
  .lede b { color: var(--seh-forest); }
  .hero-acts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  .btn-go.big { min-height: 64px; padding: 0 2rem; font-size: var(--text-base); }
  .btn-go.big .bi :global(svg) { width: 1.4em; height: 1.4em; }
  .hero-note { margin-top: var(--space-4); font-size: var(--text-xs); color: var(--text-muted); font-style: italic; }

  .inspo { position: relative; display: flex; flex-direction: column; padding: var(--space-6) var(--space-4) var(--space-4); background: var(--seh-forest); border-radius: calc(var(--seh-radius) * 1.6); }
  .inspo-k { position: absolute; top: -0.9em; left: var(--space-5); padding: 0.25em 0.9em; border-radius: 999px; background: var(--seh-sun); font-size: var(--text-sm); font-weight: 800; transform: rotate(-3deg); }
  /* 四個一樣高，平均分配右欄高度 */
  .inspo-list { flex: 1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: 1fr; gap: var(--space-3); }
  .ins {
    display: grid; grid-template-columns: 76px minmax(0, 1fr); align-items: center; gap: var(--space-4); height: 100%;
    padding: var(--space-3); border-radius: var(--seh-radius); background: var(--seh-card); text-decoration: none; color: var(--text-primary);
    transition: transform 0.2s;
  }
  .ins:hover { transform: translateX(4px); }
  .ins:hover .ins-t { color: var(--color-link); }
  .ins-ico { display: grid; place-items: center; width: 76px; height: 76px; border-radius: var(--seh-radius-sm); }
  .ins-ico :global(svg) { width: 40px; height: 40px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ins-body { display: grid; gap: 2px; min-width: 0; }
  .ins-mood { font-size: var(--text-xs); font-weight: 700; color: var(--seh-coral-deep); }
  .ins-t { font-size: var(--text-xs); font-weight: 800; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .ins-m { font-size: var(--text-xs); color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* ── 個人化 ── */
  .pick { scroll-margin-top: 80px; }

  /* ── 編輯選讀 ── */
  .ed-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-4); }
  .ed-list a { display: grid; gap: var(--space-2); height: 100%; padding: var(--space-5); text-decoration: none; background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow); }
  .ed-no { font-size: var(--text-2xl); font-weight: 800; color: var(--seh-coral); line-height: 1; }
  .ed-t { font-size: var(--text-sm); font-weight: 800; line-height: 1.4; }
  .ed-note { font-size: var(--text-xs); border-left: 3px solid var(--seh-coral); padding-left: var(--space-3); }
  .ed-p { font-size: var(--text-xs); color: var(--text-muted); }

  /* ── 即將結束 ── */
  .end-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
