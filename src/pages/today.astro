---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { flatSessions } from '../lib/build-data.mjs';
import { todaySessions, mergeRuns } from '../lib/day-lists.mjs';
import { hhmm, dateLabel, fmtNum, catVar } from '../lib/format.mjs';

// 清單在 build 時就寫進 HTML：搜尋引擎與答案引擎不保證會執行 JS，
// 只留空清單等前端填，它們看到的就是一頁沒有內容的頁面。
// 下面的 <script> 載入後會用當下時間重畫（build 之後日期就前進了），
// 兩邊共用 day-lists.mjs，邏輯不會分岔。
const buildNow = Date.now();
const rows = todaySessions(await flatSessions(), buildNow);
const merged = mergeRuns(rows);

// ItemList／Event 結構化資料（GEO：/today 是常青樞紐，AI 問「今天台灣有什麼活動」
// 最可能引用這頁）。只用畫面上真的會列出來的 merged，資料來源與可見內容同一份，
// 不會有「結構化資料講得比畫面多」的問題。name/startDate/location 都缺才整筆丟掉
// （schema.org Event 三個必填欄位，寧缺勿濫）。
const withTz = /[Z+]|-\d{2}:\d{2}$/;
const isoStart = (at) => (withTz.test(at.slice(11)) ? at : `${at}:00+08:00`);
// citation：同一份邏輯 event-ld.mjs 也有一份（沒有 url 的來源整筆丟棄，陣列空就不輸出
// 屬性）——這裡資料來源是 flatSessions() 的 d.sources，跟活動明細頁同一份 e.sources。
const citationOf = (d) => (d.sources ?? [])
  .filter((s) => s.url)
  .map((s) => ({ '@type': 'CreativeWork', name: s.sourceName || s.id, url: s.url }));
const itemListElement = merged
  .filter((d) => d.title && d.at && (d.venue || d.city))
  .map((d, i) => {
    const citation = citationOf(d);
    return {
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Event',
        name: d.title,
        startDate: isoStart(d.at),
        location: { '@type': 'Place', name: d.venue || d.city },
        url: `https://seh.tw/event/${encodeURIComponent(d.slug)}`,
        ...(citation.length ? { citation } : {}),
      },
    };
  });
const todayLd = itemListElement.length ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '今天台灣的文化活動',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: itemListElement.length,
  itemListElement,
} : null;
---
<Base title="今天有什麼｜seh" description="今天台灣各地正在發生的文化活動，依開始時間排列。">
  {todayLd && <script type="application/ld+json" set:html={JSON.stringify(todayLd)} slot="head" />}
  <div class="shell">
    <Nav current="today" />
    <header class="page-hd">
      <h1>今天</h1>
      <p class="sub" id="sub">{dateLabel(buildNow)}　{fmtNum(merged.length)} 個活動、{fmtNum(rows.length)} 場次</p>
      <nav class="chips" id="chips" aria-label="類型篩選"></nav>
    </header>
    <ol class="ev-list" id="list">
      {merged.map((d) => (
        <li>
          <a href={`/event/${encodeURIComponent(d.slug)}`}>
            <time class="ev-lead tabular" datetime={d.at}>{d.dateOnly ? '整天' : hhmm(d.ts)}</time>
            <span class="ev-body"><span class="ev-t">{d.title}</span>
              <span class="ev-m">{[d.venue, d.city].filter(Boolean).join('　')}</span></span>
            <span class="ev-cat" style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>
            {d.times.length > 1 && <span class="ev-x">今天還有 {d.times.length - 1} 場</span>}
          </a>
        </li>
      ))}
    </ol>
    <p class="empty-note" id="empty" hidden={merged.length > 0}>今天這個類型沒有活動，<a href="/">看看其他時段</a>。</p>
  </div>
</Base>

<script>
  import { relTime, dateLabel, fmtNum, catVar, midnight } from '../lib/format.mjs';
  import { todaySessions, mergeRuns } from '../lib/day-lists.mjs';
  import { loadSessions } from '../lib/index-client.mjs';
  const css = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const all = await loadSessions();
  const now = Date.now();
  // build 時已經畫過一份（日期停在 build 當天），這裡用當下時間重畫
  const today = todaySessions(all, now);
  const merged = mergeRuns(today);

  document.getElementById('sub').textContent =
    `${dateLabel(midnight(now))}　${fmtNum(merged.length)} 個活動、${fmtNum(today.length)} 場次`;

  const counts = new Map();
  merged.forEach((d) => counts.set(d.cat, (counts.get(d.cat) ?? 0) + 1));
  const cats = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
  let pick = null;

  function chips() {
    document.getElementById('chips').innerHTML =
      `<button type="button" class="chip${pick === null ? ' on' : ''}" data-c="">全部 ${merged.length}</button>` +
      cats.map(([c, n]) => `<button type="button" class="chip${pick === c ? ' on' : ''}" data-c="${c}" style="--c:${css(catVar(c))}">${c || '未分類'} ${n}</button>`).join('');
    document.querySelectorAll('#chips .chip').forEach((b) =>
      b.addEventListener('click', () => { pick = b.dataset.c || null; chips(); draw(); }));
  }

  const row = (d) => {
    const extra = d.times.length > 1 ? `<span class="ev-x">今天還有 ${d.times.length - 1} 場</span>` : '';
    return `<li class="${d.ts <= now ? 'past' : ''}">
      <a href="/event/${encodeURIComponent(d.slug)}">
        <time class="ev-lead tabular" datetime="${d.at}">${relTime(d.ts, now)}</time>
        <span class="ev-body"><span class="ev-t">${d.title}</span>
          <span class="ev-m">${[d.venue, d.city].filter(Boolean).join('　')}</span></span>
        <span class="ev-cat" style="color:${css(catVar(d.cat))}">${d.cat ?? ''}</span>
        ${extra}
      </a></li>`;
  };

  function draw() {
    const rows = pick ? merged.filter((d) => d.cat === pick) : merged;
    document.getElementById('empty').hidden = rows.length > 0;
    let split = false;
    document.getElementById('list').innerHTML = rows.map((d) => {
      let sep = '';
      if (d.ts <= now && !split) { split = true; sep = `<li class="sep">以下為今天稍早已開始</li>`; }
      return sep + row(d);
    }).join('');
  }
  chips(); draw();
</script>
