---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VenueFacts from '../../components/VenueFacts.astro';
import { venueNode, crumbTrail } from '../../lib/jsonld/index.mjs';
import { catVar } from '../../lib/format.mjs';
import { allVenues, flatSessions, isIndexable, venueNames } from '../../lib/build-data.mjs';
import { upcomingSessions, pastSessions, leadText } from '../../lib/day-lists.mjs';
import { toSchemaSpec } from '../../lib/opening-hours.mjs';

export async function getStaticPaths() {
  const all = await flatSessions();
  const venues = await allVenues();
  const vn = await venueNames();
  const rowsOf = new Map();
  for (const d of all) {
    if (!d.venueSlug) continue;
    if (!rowsOf.has(d.venueSlug)) rowsOf.set(d.venueSlug, []);
    rowsOf.get(d.venueSlug).push(d);
  }
  const bySlug = new Map(venues.map((v) => [v.slug, v]));

  // 館區：自己的場次加上底下每個廳的場次。同一場次同時掛在館區與廳的，只算一次。
  const withHalls = (slug, group) => {
    if (!group) return rowsOf.get(slug) ?? [];
    const seen = new Set();
    const out = [];
    for (const s of [slug, ...group.children]) {
      for (const d of rowsOf.get(s) ?? []) {
        const k = `${d.slug}|${d.at}`;
        if (seen.has(k)) continue;
        seen.add(k);
        out.push(d);
      }
    }
    return out.sort((a, b) => a.at.localeCompare(b.at));
  };
  const hallsOf = (group) => group?.children.map((c) => {
    const h = bySlug.get(c);
    return { slug: c, name: h?.name ?? c, rows: rowsOf.get(c) ?? [] };
  }) ?? [];
  const parentInfo = (slug) => {
    const p = vn.parent.get(slug);
    if (!p) return undefined;
    const g = vn.groups.get(p);
    // 廳頁要連回館區與同館其他廳，所以把館區的全部場次與各廳一起帶過去
    return { slug: p, name: g.name, rows: withHalls(p, g), halls: hallsOf(g).filter((h) => h.slug !== slug) };
  };

  const paths = venues.map((v) => {
    const group = vn.groups.get(v.slug);
    return {
      params: { slug: v.slug },
      props: {
        v, rows: withHalls(v.slug, group), halls: hallsOf(group),
        parent: parentInfo(v.slug), aliases: vn.aliases(v.slug, v.name),
      },
    };
  });

  // 沒有自己場館頁的館區（臺中國家歌劇院只有各廳的頁）另外建一頁。
  // 地址與座標借用底下第一個有街道地址的廳——同一棟建築。
  for (const g of vn.groups.values()) {
    if (g.hasVenuePage) continue;
    const halls = g.children.map((c) => bySlug.get(c)).filter(Boolean);
    const at = halls.find((h) => h.addressPrecision === 'street' && h.lat) ?? halls.find((h) => h.address) ?? halls[0];
    const rows = withHalls(g.slug, g);
    const v = {
      venueId: `grp_${g.slug}`, slug: g.slug, name: g.name, origin: 'group',
      city: at?.city ?? g.city, district: at?.district,
      address: at?.address, addressPrecision: at?.addressPrecision, lat: at?.lat, lng: at?.lng,
      eventCount: new Set(rows.map((d) => d.slug)).size,
    };
    paths.push({
      params: { slug: g.slug },
      props: { v, rows, halls: hallsOf(g), parent: undefined, aliases: vn.aliases(g.slug, g.name) },
    });
  }
  return paths;
}

const { v, rows: allRows, halls, parent, aliases } = Astro.props;
// 「近期活動」就要是近期的：進行中或還沒開始。館區頁收的廳多，上限放寬。
const buildNow = Date.now();
const LIMIT = halls.length ? 80 : 40;
const rows = upcomingSessions(allRows, buildNow).slice(0, LIMIT);
// 這個站大多數場館手上只有已結束的活動（2026-09-18 實測 10,478 個場館頁有 9,822 個沒有近期活動）。
// 只列近期會讓那些頁整頁空白，對讀者與搜尋引擎都更糟，所以沒有近期活動時退而列已結束的，
// 並在標題講清楚是已結束——列表的第一欄會連年份一起印，不會再看起來像今年的活動。
const past = rows.length ? [] : pastSessions(allRows, buildNow).slice(0, 20);
// 開放時間的最後查核日期：超過 30 天沒重新查核（每週排程抓不到或看不懂館方頁），
// 提醒讀者時間可能已變。以建置當下判斷，每次部署都會重算。
const hoursCheckedAt = v.openingHoursSource?.checkedAt;
const hoursStale = hoursCheckedAt
  ? (buildNow - Date.parse(`${hoursCheckedAt}T00:00:00+08:00`)) / 86400000 > 30
  : false;
const totalEvents = halls.length ? new Set(allRows.map((d) => d.slug)).size : v.eventCount;
// 館區與廳的主從：館區頁列各廳、廳頁連回館區與同館其他廳，都放在標題下方（第一屏）。
// 兩邊各自是獨立的節目表（廳頁是館區的子集，不是重複頁），所以不用 canonical 指來指去，靠標題與互連分工。
const upcomingIn = (h) => upcomingSessions(h.rows, buildNow).length;
const short = (name, base) => (name.startsWith(base) && name.length > base.length ? name.slice(base.length).replace(/^[-－・\s]+/, '') : name);
const hallList = halls.map((h) => ({ slug: h.slug, name: h.name, upcoming: upcomingIn(h) }));
const hallNav = (parent ? parent.halls : halls).map((h) => ({ slug: h.slug, name: short(h.name, parent ? parent.name : v.name), upcoming: upcomingIn(h) }))
  .filter((h) => h.upcoming > 0).sort((a, b) => b.upcoming - a.upcoming);
const parentUpcoming = parent ? upcomingSessions(parent.rows, buildNow).length : 0;

// 館區頁（沒有自己 md 的）不在 page-state 裡，isIndexable 會當成可收錄；
// 有 md 的館區由 score-pages 把底下各廳的活動數一起算進去。
const indexable = await isIndexable(`/venue/${v.slug}`);

// 表演場地：名稱看得出來，或收錄的活動過半是演出類。這類場地搜尋的人找的是「節目表」。
const PERFORM_CATS = new Set(['音樂', '戲劇', '舞蹈', '演唱會', '獨立音樂', '綜藝']);
const perfShare = allRows.length ? allRows.filter((d) => PERFORM_CATS.has(d.cat)).length / allRows.length : 0;
const isPerform = /演藝廳|劇場|劇院|音樂廳|演奏廳|表演廳|表演藝術中心|藝術文化中心|中山堂|至德堂|至善廳|惠蓀堂|演藝中心/.test(v.name)
  || (allRows.length >= 3 && perfShare >= 0.5);
const isLibrary = /圖書館|分館$|親子館$|書院$/.test(v.name);

// 近期活動依類型分組。只有一種類型或筆數很少時分組沒有意義，照時間排一條。
const byCat = new Map();
for (const d of rows) {
  const k = d.cat || '其他';
  if (!byCat.has(k)) byCat.set(k, []);
  byCat.get(k).push(d);
}
const catGroups = [...byCat].sort((a, b) => b[1].length - a[1].length);
// 表演場地照日期排一條就是節目表（搜的人要的是「哪天演什麼」），不依類型拆開
const grouped = !isPerform && catGroups.length >= 2 && rows.length >= 6;
// 節目表先列有日期的場次，「展期中」的長期活動排到最後
const todayTW = new Date(buildNow + 8 * 3600e3).toISOString().slice(0, 10);
const listRows = isPerform ? [...rows.filter((d) => d.at.slice(0, 10) >= todayTW), ...rows.filter((d) => d.at.slice(0, 10) < todayTW)] : rows;

const place = [v.city, v.district].filter(Boolean).join('');
const aliasText = aliases.length ? `（又稱${aliases.slice(0, 3).join('、')}）` : '';
const catSummary = catGroups.slice(0, 4).map(([c, list]) => `${c} ${list.length} 場`).join('、');
// 場館全名帶園區前綴時，實際搜尋常只打子場地名（如「蓬萊B4倉庫」不含「高雄駁二藝術特區」），
// title 用短名把它帶到前面，H1／描述仍用全名不縮短。
const SHORT_TITLE_NAMES = new Map([
  ['高雄駁二藝術特區-蓬萊區B4倉庫', '蓬萊區B4倉庫（高雄駁二）'],
]);
const titleName = SHORT_TITLE_NAMES.get(v.slug) ?? v.name;
const title = isPerform
  ? `${titleName}節目表｜${halls.length ? '各廳近期演出總覽' : parent ? '近期演出' : '近期演出與活動'}｜seh`
  : `${titleName}｜近期活動${isLibrary ? '、開放時間' : ''}｜seh`;
const h1 = isPerform ? `${v.name}節目表` : v.name;
const description = [
  `${v.name}${aliasText}`,
  parent ? `，位於${parent.name}。` : '',
  rows.length ? `近期${isPerform ? '節目' : '活動'} ${rows.length} 場${catSummary ? `：${catSummary}` : ''}。` : '。',
  halls.length && hallNav.length ? `各廳：${hallNav.slice(0, 3).map((h) => `${h.name} ${h.upcoming} 場`).join('、')}。` : '',
  v.address ? `地址：${v.address}。` : place ? `${place}。` : '',
  v.openingHours ? `開放時間：${v.openingHours.split('\n')[0]}。` : '',
].join('').replace('。。', '。').replace('。，', '，').slice(0, 160);

// 結構化資料在 src/lib/jsonld/pages.mjs（venueNode）：只有 street 精度才輸出 streetAddress，
// Library 沒有任何地址欄位時退回 Place。
const ldType = isLibrary ? 'Library' : isPerform ? 'PerformingArtsTheater'
  : /博物館|美術館|文物館|紀念館/.test(v.name) ? 'Museum' : 'Place';
const ld = venueNode({
  type: ldType, v, aliases, parent, halls,
  openingHoursSpecification: v.openingHoursSpec?.length ? toSchemaSpec(v.openingHoursSpec) : undefined,
});
// 麵包屑：畫面與 BreadcrumbList 同一份
const trail = crumbTrail([
  { name: '場館', href: '/venues' },
  v.city && { name: v.city, href: `/city/${v.city}` },
  parent && { name: parent.name, href: `/venue/${parent.slug}` },
], h1);
const schedFirst = isPerform && rows.length > 0;
const catId = (c) => `t-${encodeURIComponent(c).replace(/%/g, '')}`;
---
<Base title={title} noindex={!indexable} description={description} jsonld={ld} breadcrumbs={trail}>
  <div class="shell">
    <Nav />
    <header class="page-hd">
      <Breadcrumb trail={trail} />
      <h1 class="vname">{h1}</h1>
      {aliases.length > 0 && <p class="aka">又稱　{aliases.join('、')}</p>}
      <p class="sub"><strong class="tabular">{rows.length}</strong> 個近期{isPerform ? '節目' : '活動'}<span class="orig">　收錄 {totalEvents} 個</span>
        <span class="orig">{v.origin === 'group' ? `　${halls.length} 個廳與場地` : v.origin === 'derived' ? '　場地資料由活動資料建立' : '　來自場館名錄'}</span></p>
      {parent && <p class="hall-nav">位於 <a href={`/venue/${parent.slug}`}>{parent.name}</a><span class="orig">（全館近期 {parentUpcoming} 場）</span>
        {hallNav.length > 0 && <>　同館：{hallNav.map((h) => <><a href={`/venue/${h.slug}`}>{h.name}</a><span class="orig tabular"> {h.upcoming} 場</span>{' '}</>)}</>}</p>}
      {!parent && halls.length > 0 && hallNav.length > 0 && <p class="hall-nav">各廳：{hallNav.map((h) => <><a href={`/venue/${h.slug}`}>{h.name}</a><span class="orig tabular"> {h.upcoming} 場</span>{' '}</>)}</p>}
    </header>

    {!schedFirst && <VenueFacts v={v} parent={parent} halls={hallList} hoursCheckedAt={hoursCheckedAt} hoursStale={hoursStale} />}

    {grouped ? (
      <>
        <h2 class="h-sm">{isPerform ? '近期節目' : '近期活動'}（依類型）</h2>
        <p class="catrow">{catGroups.map(([c, list]) => (
          <a href={`#${catId(c)}`} style={`color:var(${catVar(c)})`}>{c}<b class="tabular">{list.length}</b></a>
        ))}</p>
        {catGroups.map(([c, list]) => (
          <section class="catsec" id={catId(c)}>
            <h3 class="h-cat" style={`color:var(${catVar(c)})`}>{c}</h3>
            <ol class="ev-list">
              {list.map((d) => (
                <li><a href={`/event/${d.slug}`}>
                  <time class="ev-lead tabular" datetime={d.at}>{leadText(d, buildNow)}</time>
                  <span class="ev-body"><span class="ev-t">{d.title}</span>
                    {halls.length > 0 && d.venue && <span class="ev-m">{d.venue}</span>}</span>
                </a></li>
              ))}
            </ol>
          </section>
        ))}
      </>
    ) : (
      <>
        {(rows.length > 0 || past.length > 0) && (
          <h2 class="h-sm">{rows.length ? (isPerform ? '近期節目' : '近期活動') : '已結束的活動'}</h2>
        )}
        <ol class="ev-list">
          {(rows.length ? listRows : past).map((d) => (
            <li><a href={`/event/${d.slug}`}>
              <time class="ev-lead tabular" datetime={d.at}>{leadText(d, buildNow)}</time>
              <span class="ev-body"><span class="ev-t">{d.title}</span>
                {halls.length > 0 && d.venue && <span class="ev-m">{d.venue}</span>}</span>
              <span class="ev-cat" style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>
            </a></li>
          ))}
        </ol>
      </>
    )}
    {rows.length === 0 && past.length === 0 && <p class="empty-note">目前沒有收錄到這個場館的活動。</p>}
    {schedFirst && <VenueFacts v={v} parent={parent} halls={hallList} hoursCheckedAt={hoursCheckedAt} hoursStale={hoursStale} />}
  </div>
</Base>
<style>
  .vname { font-family: var(--font-body); font-weight: 700; font-size: var(--text-xl); letter-spacing: 0; line-height: 1.35; }
  .aka { margin-top: 0.5rem; color: var(--text-secondary); font-size: var(--text-sm); }
  .orig { color: var(--text-muted); font-size: var(--text-sm); }
  .h-sm { font-family: var(--font-body); font-weight: 700; font-size: var(--text-sm);
          color: var(--text-secondary); margin-top: var(--space-7); }
  .hall-nav { margin-top: 0.8rem; font-size: var(--text-sm); color: var(--text-secondary); }
  .catrow { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: var(--space-4); max-width: none; }
  .catrow a { display: inline-flex; gap: 0.5rem; text-decoration: none; font-size: var(--text-sm); }
  .catrow b { color: var(--text-muted); font-weight: 400; }
  .catsec { margin-top: var(--space-6); }
  .h-cat { font-family: var(--font-body); font-weight: 700; font-size: var(--text-base); letter-spacing: 0; }
  .catsec .ev-list { margin-top: var(--space-3); margin-bottom: 0; }
</style>
