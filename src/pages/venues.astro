---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import { iconSvg } from '../lib/icons.mjs';
import { catVar } from '../lib/format.mjs';
import { allVenues } from '../lib/build-data.mjs';
const venues = (await allVenues()).sort((a, b) => b.eventCount - a.eventCount || a.name.localeCompare(b.name));
const withGeo = venues.filter((v) => v.lat).length;
const derived = venues.filter((v) => v.origin === 'derived').length;
const top = venues.filter((v) => v.eventCount > 0).slice(0, 12);
const cityN = new Set(venues.map((v) => v.city).filter(Boolean)).size;
---
<Base title={`全台${venues.length}個藝文場館總覽｜seh`} description={`全台 ${venues.length} 個正在舉辦活動的藝文場館，依活動數由多到少排列，標示所在縣市與地區。`}>
  <div class="shell">
    <Nav current="venues" />
    <PageHero kicker="出門的目的地" title="全台藝文場館" icon="building" tone="sage"
      art="美術館・劇場"
      stats={[
        { icon: 'building', n: venues.length.toLocaleString('en-US'), label: '個場館', main: true },
        { icon: 'pin', n: withGeo.toLocaleString('en-US'), label: '個有座標，可以導航' },
        { icon: 'compass', n: String(cityN), label: '個縣市' },
      ]}>
      <p class="vsub"><strong class="tabular">{venues.length}</strong> 個場館有活動，{withGeo} 個有座標，
        {derived} 個是從活動資料長出來的（名錄裡查不到）</p>
    </PageHero>

    {top.length > 0 && (
      <section>
        <h2 class="sec-h"><span class="sec-ico" set:html={iconSvg('star')} />最常辦活動的場館</h2>
        <ul class="vtop">
          {top.map((v, i) => (
            <li><a href={`/venue/${v.slug}`}>
              <span class="vtop-no tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="vtop-t">{v.name}</span>
              <span class="vtop-m">{[v.city, v.district].filter(Boolean).join('・')}</span>
              <span class="vtop-n tabular">{v.eventCount} 個活動</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    <h2 class="sec-h"><span class="sec-ico" set:html={iconSvg('building')} />全部場館<span class="tabular badge">{venues.length.toLocaleString('en-US')}</span></h2>
    <ol class="ev-list">
      {venues.map((v) => (
        <li><a href={`/venue/${v.slug}`}>
          <span class="ev-lead tabular">{v.eventCount} 個</span>
          <span class="ev-body">
            <span class="ev-t">{v.name}</span>
            <span class="ev-m">{[v.city, v.district].filter(Boolean).join('　')}</span>
          </span>
          <span class="vsrc">{v.origin === 'derived' ? '活動資料' : '名錄'}</span>
        </a></li>
      ))}
    </ol>
  </div>
</Base>

<style is:global>
  /* is:global：一萬多列，scoped 會讓每列多一個屬性 */
  .vsub { grid-column: 1 / -1; margin-top: var(--space-4); font-size: var(--text-xs); color: var(--text-muted); max-width: var(--measure); }
  .vtop { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); gap: var(--space-3); }
  .vtop a { display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: var(--space-3); row-gap: 2px; height: 100%;
    padding: var(--space-4); text-decoration: none; background: var(--seh-card); border-radius: var(--seh-radius); box-shadow: var(--seh-shadow); transition: box-shadow 0.2s, transform 0.2s; }
  .vtop a:hover { box-shadow: var(--seh-shadow-hover); transform: translateY(-2px); }
  .vtop a:hover .vtop-t { color: var(--color-link); }
  .vtop-no { grid-row: 1 / 4; font-size: var(--text-xl); font-weight: 800; color: var(--seh-coral); line-height: 1; }
  .vtop-t { font-size: var(--text-xs); font-weight: 800; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .vtop-m { font-size: var(--text-xs); color: var(--text-muted); }
  .vtop-n { font-size: var(--text-xs); font-weight: 700; color: var(--seh-forest); }
  .vsrc { font-size: var(--text-xs); color: var(--text-muted); white-space: nowrap; }
</style>
