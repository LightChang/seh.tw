---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import { iconSvg } from '../lib/icons.mjs';
---
<Base title="附近｜seh" description="用你的位置找附近正在發生、7 天內看得到的文化活動。" noindex={true}>
  <div class="shell">
    <Nav current="nearby" />
    <PageHero kicker="就在你附近" title="附近有什麼" icon="pin" tone="coral"
      sub="需要你的位置才能算距離。位置只在瀏覽器裡使用，不會傳給任何人。" subId="sub"
      art="找附近" artId="art"
      stats={[
        { icon: 'pin', n: '—', label: '個活動在範圍內', id: 'count', main: true },
        { icon: 'compass', n: '—', label: '最近的一個', id: 'nearest' },
        { icon: 'gift', n: '—', label: '免費', id: 'free' },
      ]}>
      <div class="ctl">
        <button type="button" id="ask" class="btn-go"><span class="bi" set:html={iconSvg('pin')} />用我的位置</button>
        <div class="radii chips" id="radii" hidden style="margin-top:0">
          <button type="button" class="chip on" data-r="1">1 公里</button>
          <button type="button" class="chip" data-r="3">3 公里</button>
          <button type="button" class="chip" data-r="5">5 公里</button>
          <button type="button" class="chip" data-r="10">10 公里</button>
        </div>
      </div>
    </PageHero>
    <ol class="ev-list cols-4" id="list"></ol>
  </div>
</Base>

<script>
  import { relTime, catVar, fmtNum, esc } from '../lib/format.mjs';
  import { loadSessions } from '../lib/index-client.mjs';
  import { tsOf, tsEndOf } from '../lib/day-lists.mjs';
  import { distanceM } from '../lib/explore-nearby.mjs';
  import { distText } from '../lib/inspire.mjs';
  import { quietLocation, askLocation } from '../lib/inspire-client.mjs';
  import { cssVar, setStat } from '../lib/dom.mjs';

  const now = Date.now();
  const HORIZON = now + 7 * 86400000;
  // 「附近正在發生」：還沒結束（展期中的展覽也算），而且 7 天內看得到。一律當台灣時間，不看訪客時區。
  // 同一活動只留一列（最早還看得到的那一場）。
  const bySlug = new Map();
  for (const d of await loadSessions()) {
    if (!d.lat || !d.lng) continue;
    const ts = tsOf(d), end = tsEndOf(d) ?? ts + 3 * 3600000;
    if (end < now || ts >= HORIZON) continue;
    const prev = bySlug.get(d.slug);
    if (!prev || ts < prev.ts) bySlug.set(d.slug, { ...d, ts, end });
  }
  const all = [...bySlug.values()];
  const lead = (d) => (d.ts > now ? relTime(d.ts, now) : d.end - d.ts > 20 * 3600000 ? '展期中' : '進行中');
  let me = null, radius = 1;
  const sub = document.getElementById('sub');

  function draw() {
    if (!me) return;
    const rows = all.map((d) => ({ ...d, m: distanceM(me.lat, me.lng, d.lat, d.lng) }))
      .filter((d) => d.m <= radius * 1000)
      .sort((a, b) => a.m - b.m);
    setStat('count', fmtNum(rows.length));
    setStat('nearest', rows.length ? distText(rows[0].m) : '—');
    setStat('free', fmtNum(rows.filter((d) => d.isFree).length));
    document.getElementById('art').textContent = `${radius} 公里內`;
    sub.innerHTML = rows.length
      ? `${radius} 公里內有 <strong class="tabular">${rows.length}</strong> 個活動`
      : `${radius} 公里內沒有活動，試試更大的範圍`;
    document.getElementById('list').innerHTML = rows.slice(0, 30).map((d) => `
      <li><a href="/event/${encodeURIComponent(d.slug)}">
        <span class="ev-lead tabular">${distText(d.m)}</span>
        <span class="ev-body"><span class="ev-t">${esc(d.title)}${d.isFree ? '<span class="tag-free">免費</span>' : ''}</span><span class="ev-m">${esc([d.venue, d.city].filter(Boolean).join('　'))}</span></span>
        <span class="ev-x">${lead(d)}</span>
        <span class="ev-cat" data-cat="${esc(d.cat)}" style="color:${cssVar(catVar(d.cat))}">${esc(d.cat)}</span>
      </a></li>`).join('');
  }

  const use = (loc) => {
    me = loc;
    document.getElementById('radii').hidden = false;
    document.getElementById('ask').hidden = true;
    draw();
  };
  document.getElementById('ask').addEventListener('click', async () => {
    if (!navigator.geolocation) { sub.textContent = '這個瀏覽器不支援定位。'; return; }
    sub.textContent = '取得位置中⋯';
    const loc = await askLocation(10000);
    if (loc) use(loc);
    else sub.textContent = '取不到位置（可能沒有允許定位）。可以改用「地圖」瀏覽全台活動。';
  });
  // 這次瀏覽已經給過位置、或瀏覽器記得「已允許」就直接用（不會跳詢問）
  quietLocation().then((loc) => loc && use(loc));

  document.querySelectorAll('#radii .chip').forEach((b) =>
    b.addEventListener('click', () => {
      radius = +b.dataset.r;
      document.querySelectorAll('#radii .chip').forEach((x) => x.classList.toggle('on', x === b));
      draw();
    }));
</script>

<style>
  .ctl { grid-column: 1 / -1; margin-top: var(--space-5); display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
  .ctl [hidden] { display: none; }
  .radii { display: flex; gap: 0.45rem; flex-wrap: wrap; }
</style>

