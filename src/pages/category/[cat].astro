---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { crumbTrail } from '../../lib/jsonld/index.mjs';
import { catVar, dateLabel, hhmm } from '../../lib/format.mjs';
import { flatSessions, countBy, CATEGORY_MIN, builtCatCities, builtHubs } from '../../lib/build-data.mjs';
import { upcomingSessions, leadText } from '../../lib/day-lists.mjs';

export async function getStaticPaths() {
  const all = await flatSessions();
  // cat 是對照過的 canonical 值，來源不明的已經在 emit-md 被擋掉了。
  // 仍然設 5 場門檻——只有兩三場的分類頁沒有內容價值。
  return countBy(all, 'cat').filter(([, n]) => n >= CATEGORY_MIN).map(([cat]) => ({
    params: { cat }, props: { cat, rows: all.filter((d) => d.cat === cat) },
  }));
}
const { cat, rows: allRows } = Astro.props;
// 頁面列的是「近期」＝進行中或還沒開始的場次。分類頁本身仍以全部場次是否達門檻決定要不要生成
// （網址穩定優先），但畫面上的數字與清單一律只算近期，否則標題的「近期活動」名不副實
// ——2026-09-18 實測這裡列的是 1998／2000 年的展覽。
const buildNow = Date.now();
const rows = upcomingSessions(allRows, buildNow);
const catCities = await builtCatCities();
const PERFORM = new Set(['音樂', '戲劇', '舞蹈', '演唱會', '獨立音樂', '綜藝']);
const year = new Date(buildNow + 8 * 3600e3).getUTCFullYear();
const title = PERFORM.has(cat) ? `${cat}節目表｜${year} 台灣近期${cat}演出｜seh` : `${cat}活動｜${year} 台灣近期${cat}｜seh`;
const cities = [...rows.reduce((m, d) => (d.city ? m.set(d.city, (m.get(d.city) ?? 0) + 1) : m), new Map())]
  .sort((a, b) => b[1] - a[1]).slice(0, 8);
// 麵包屑：畫面與 BreadcrumbList 同一份（src/lib/jsonld/pages.mjs）
const trail = crumbTrail([{ name: '今天', href: '/today' }], cat);
// 這個類型有年度時間表的話連過去（src/lib/hubs.mjs 的 YEAR_GROUPS）
const hubs = await builtHubs();
const yearPage = hubs.year.find((p) => !p.city && p.year === hubs.thisYear && p.group.cats.includes(cat));
---
<Base title={title} description={`台灣近期的${cat}活動，共 ${rows.length} 場，可依縣市篩選。`} breadcrumbs={trail}>
  <div class="shell">
    <Nav />
    <header class="page-hd">
      <Breadcrumb trail={trail} />
      <h1 style={`color:var(${catVar(cat)})`}>{cat}</h1>
      <p class="sub"><strong class="tabular">{rows.length}</strong> 場近期活動{yearPage && <>　<a href={`/year/${yearPage.year}/${yearPage.group.key}`}>{yearPage.year} {yearPage.group.label}時間表</a></>}</p>
    </header>

    {cities.length > 0 && (
      <p class="cityrow">{cities.map(([c, n]) => <a href={catCities.has(`${cat}|${c}`) ? `/category/${cat}/${c}` : `/city/${c}`}>{c}<b class="tabular">{n}</b></a>)}</p>
    )}

    <ol class="ev-list">
      {rows.slice(0, 40).map((d) => (
        <li><a href={`/event/${d.slug}`}>
          <time class="ev-lead tabular" datetime={d.at}>{leadText(d, buildNow)}</time>
          <span class="ev-body"><span class="ev-t">{d.title}</span>
            <span class="ev-m">{[d.venue, d.city].filter(Boolean).join('　')}</span></span>
        </a></li>
      ))}
    </ol>
    {rows.length === 0 && <p class="empty-note">這個分類目前沒有活動。</p>}
  </div>
</Base>
<style>
  .warn { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--color-warn);
          background: var(--bg-surface); padding: 0.7rem 1rem; max-width: var(--measure); }
  .cityrow { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: var(--space-5); max-width: none; }
  .cityrow a { display: inline-flex; gap: 0.5rem; text-decoration: none; font-size: var(--text-sm); }
  .cityrow b { color: var(--text-muted); font-weight: 400; }
</style>
