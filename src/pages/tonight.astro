---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import { flatSessions } from '../lib/build-data.mjs';
import { tonightSessions } from '../lib/day-lists.mjs';
import { hhmm, dateLabel, fmtNum, catVar } from '../lib/format.mjs';

// 清單在 build 時就寫進 HTML，理由與作法見 today.astro。
const buildNow = Date.now();
const rows = tonightSessions(await flatSessions(), buildNow);
---
<Base title="今晚哪裡有活動｜seh" description="今晚 19:00 之後開始的文化活動。">
  <div class="shell">
    <Nav current="tonight" />
    <PageHero kicker="下班後" title="今晚去哪裡" icon="moon" tone="forest"
      sub={`${dateLabel(buildNow)} 19:00 之後　${fmtNum(rows.length)} 場`} subId="sub"
      art="19:00 以後"
      stats={[
        { icon: 'moon', n: fmtNum(rows.length), label: '場今晚開演', id: 'total', main: true },
        { icon: 'compass', n: fmtNum(new Set(rows.map((d) => d.city).filter(Boolean)).size), label: '個縣市', id: 'cities' },
        { icon: 'gift', n: fmtNum(rows.filter((d) => d.isFree === true).length), label: '免費', id: 'free', href: '/free' },
      ]}>
      <p class="note">只列出有明確開始時刻的活動。部分來源只提供日期，那些活動無法判斷是否為夜間場次。</p>
    </PageHero>
    <ol class="ev-list" id="list">
      {rows.map((d) => (
        <li>
          <a href={`/event/${encodeURIComponent(d.slug)}`}>
            <time class="ev-lead tabular" datetime={d.at}>{hhmm(d.ts)}</time>
            <span class="ev-body"><span class="ev-t">{d.title}{d.isFree === true && <span class="tag-free">免費</span>}</span>
              <span class="ev-m">{[d.venue, d.city].filter(Boolean).join('　')}</span></span>
            <span class="ev-cat" data-cat={d.cat || ''} style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="empty-note" id="empty" hidden={rows.length > 0}>今晚沒有收錄到活動，<a href="/today">看看今天其他時段</a>。</p>
    <p class="also">也可以看<a href="/weekend">這週末</a>或<a href="/free">免費活動</a>。</p>
  </div>
</Base>
<script>
  import { dateLabel, fmtNum, catVar, midnight, esc } from '../lib/format.mjs';
  import { tonightSessions, startedBy, todayLead } from '../lib/day-lists.mjs';
  import { loadSessions } from '../lib/index-client.mjs';
  import { cssVar, setStat } from '../lib/dom.mjs';
  const all = await loadSessions();
  const now = Date.now();
  // build 時已經畫過一份（日期停在 build 當天），這裡用當下時間重畫
  const rows = tonightSessions(all, now);
  document.getElementById('sub').textContent =
    `${dateLabel(midnight(now) + 19 * 3600000)} 19:00 之後　${fmtNum(rows.length)} 場`;
  document.getElementById('empty').hidden = rows.length > 0;
  setStat('total', fmtNum(rows.length));
  setStat('cities', fmtNum(new Set(rows.map((d) => d.city).filter(Boolean)).size));
  setStat('free', fmtNum(rows.filter((d) => d.isFree).length));
  document.getElementById('list').innerHTML = rows.map((d) => `
    <li class="${startedBy(d, now) ? 'past' : ''}"><a href="/event/${encodeURIComponent(d.slug)}">
      <time class="ev-lead tabular" datetime="${d.at}">${todayLead(d, now)}</time>
      <span class="ev-body"><span class="ev-t">${esc(d.title)}${d.isFree ? '<span class="tag-free">免費</span>' : ''}</span>
        <span class="ev-m">${esc([d.venue, d.city].filter(Boolean).join('　'))}</span></span>
      <span class="ev-cat" data-cat="${esc(d.cat)}" style="color:${cssVar(catVar(d.cat))}">${esc(d.cat)}</span>
    </a></li>`).join('');
</script>
<style>
  .also { margin-bottom: var(--space-9); font-size: var(--text-sm); color: var(--text-muted); }
  .note { grid-column: 1 / -1; margin-top: var(--space-4); font-size: var(--text-xs); color: var(--text-muted); max-width: var(--measure); }
  .also a { color: var(--seh-forest); }
</style>
