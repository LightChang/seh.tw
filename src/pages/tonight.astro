---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { flatSessions } from '../lib/build-data.mjs';
import { tonightSessions } from '../lib/day-lists.mjs';
import { hhmm, dateLabel, fmtNum, catVar } from '../lib/format.mjs';

// 清單在 build 時就寫進 HTML，理由與作法見 today.astro。
const buildNow = Date.now();
const rows = tonightSessions(await flatSessions(), buildNow);
---
<Base title="今晚哪裡有活動｜seh" description="今晚 19:00 之後開始的文化活動。">
  <div class="shell">
    <Nav />
    <header class="page-hd">
      <h1>今晚</h1>
      <p class="sub" id="sub">{dateLabel(buildNow)} 19:00 之後　{fmtNum(rows.length)} 場</p>
      <p class="note">只列出有明確開始時刻的活動。部分來源只提供日期，那些活動無法判斷是否為夜間場次。</p>
    </header>
    <ol class="ev-list" id="list">
      {rows.map((d) => (
        <li>
          <a href={`/event/${encodeURIComponent(d.slug)}`}>
            <time class="ev-lead tabular" datetime={d.at}>{hhmm(d.ts)}</time>
            <span class="ev-body"><span class="ev-t">{d.title}</span>
              <span class="ev-m">{[d.venue, d.city].filter(Boolean).join('　')}</span></span>
            <span class="ev-cat" style={`color:var(${catVar(d.cat)})`}>{d.cat}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="empty-note" id="empty" hidden={rows.length > 0}>今晚沒有收錄到活動，<a href="/today">看看今天其他時段</a>。</p>
  </div>
</Base>
<script>
  import { relTime, dateLabel, fmtNum, catVar, midnight } from '../lib/format.mjs';
  import { tonightSessions } from '../lib/day-lists.mjs';
  import { loadSessions } from '../lib/index-client.mjs';
  const css = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const all = await loadSessions();
  const now = Date.now();
  // build 時已經畫過一份（日期停在 build 當天），這裡用當下時間重畫
  const rows = tonightSessions(all, now);
  document.getElementById('sub').textContent =
    `${dateLabel(midnight(now) + 19 * 3600000)} 19:00 之後　${fmtNum(rows.length)} 場`;
  document.getElementById('empty').hidden = rows.length > 0;
  document.getElementById('list').innerHTML = rows.map((d) => `
    <li class="${d.ts <= now ? 'past' : ''}"><a href="/event/${encodeURIComponent(d.slug)}">
      <time class="ev-lead tabular">${relTime(d.ts, now)}</time>
      <span class="ev-body"><span class="ev-t">${d.title}</span>
        <span class="ev-m">${[d.venue, d.city].filter(Boolean).join('　')}</span></span>
      <span class="ev-cat" style="color:${css(catVar(d.cat))}">${d.cat ?? ''}</span>
    </a></li>`).join('');
</script>
<style>
  .note { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--text-muted); max-width: var(--measure); }
</style>
