---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { crumbTrail } from '../../../lib/jsonld/index.mjs';
import { catVar } from '../../../lib/format.mjs';
import { flatSessions, builtCategories, cityMonthPages } from '../../../lib/build-data.mjs';

// 一個路由涵蓋兩種子頁：/city/臺北市/中正區 與 /city/臺北市/2026-10。
// 兩者都是縣市底下的單一路徑段，分成兩個 [param] 路由會撞在一起，
// 所以合成一個，靠資料本身分辨。
export async function getStaticPaths() {
  // 常數要放在函式裡。Astro 會把 getStaticPaths 抽成獨立的 chunk，
  // 只帶著 import，不帶模組層的其他宣告——放外面會 ReferenceError。
  const MIN = 5;   // 少於 5 場的行政區頁沒有內容價值，不建
  const all = await flatSessions();
  const today = new Date(Date.now() + 8 * 3600e3).toISOString().slice(0, 10);
  // 只看還沒結束的。已結束的活動撐不起「這一區現在有什麼」。
  const live = all.filter((d) => (d.end ?? d.at).slice(0, 10) >= today);

  const byDistrict = new Map();
  for (const d of live) {
    if (!d.city || !d.district) continue;
    const k = `${d.city} ${d.district}`;
    if (!byDistrict.has(k)) byDistrict.set(k, []);
    byDistrict.get(k).push(d);
  }
  // 網址一旦發出就不能變（CLAUDE.md）。行政區頁原本在還沒結束的場次掉到 5 場以下時就不建、變 404。
  // 站 2026-09-15 上線起有過場次的行政區一律建頁；不到 5 場（含 0 場）的 noindex，
  // 沒有還沒結束的場次就列最近結束的場次。
  const LAUNCH = '2026-09-15';
  const recent = new Map();
  for (const d of all) {
    if (!d.city || !d.district || (d.end ?? d.at).slice(0, 10) < LAUNCH) continue;
    const k = `${d.city} ${d.district}`;
    if (!recent.has(k)) recent.set(k, []);
    recent.get(k).push(d);
  }
  // 月份頁（含過去月份）的建頁規則在 build-data.mjs 的 cityMonthPages，活動頁連過來也用它
  const months = await cityMonthPages();

  // 側欄要互相連結，但只能連到**真的有建**的頁——月份頁只做當月往後一年、
  // 而且兩種都有門檻。不先算出實際建了哪些，側欄會連出 404
  // （實測抽驗 400 頁就有 223 條這種連結）。側欄只連還沒過去的月份。
  const built = new Set();
  for (const [k, rows] of byDistrict) if (rows.length >= MIN) built.add(`district ${k}`);
  for (const [k, v] of months) if (!v.past) built.add(`month ${k}`);

  const paths = [];
  for (const k of new Set([...byDistrict.keys(), ...recent.keys()])) {
    const liveRows = byDistrict.get(k) ?? [];
    const thin = liveRows.length < MIN;
    const rows = liveRows.length ? liveRows : recent.get(k).slice(-40);
    const [city, sub] = k.split(' ');
    paths.push({ params: { city, sub }, props: { city, sub, rows, mode: 'district', built: [...built], past: false, thin, ended: !liveRows.length } });
  }
  for (const [k, { rows, past, ongoing }] of months) {
    const [city, sub] = k.split(' ');
    paths.push({ params: { city, sub }, props: { city, sub, rows, ongoing, mode: 'month', built: [...built], past } });
  }
  return paths;
}

const { city, sub, rows, ongoing = [], mode, built, past, thin = false, ended = false } = Astro.props;
const catPages = await builtCategories();
const has = (m, k) => built.includes(`${m} ${city} ${k}`);
const isMonth = mode === 'month';
const events = new Set(rows.map((d) => d.slug)).size;
const title = isMonth ? `${city} ${sub.slice(0, 4)} 年 ${+sub.slice(5)} 月` : `${city}${sub}`;

const count = (key) => [...rows.reduce((m, d) => (d[key] ? m.set(d[key], (m.get(d[key]) ?? 0) + 1) : m), new Map())]
  .sort((a, b) => b[1] - a[1]).slice(0, 8);
const cats = count('cat');
const venues = count('venue');

// 行政區頁看月份、月份頁看行政區——互為對方的下一層入口
const others = (isMonth
  ? count('district')
      .filter(([v]) => has('district', v))
      .map(([v, n]) => ({ label: v, href: `/city/${city}/${v}`, n }))
  : [...new Set(rows.map((d) => d.at.slice(0, 7)))].sort()
      .filter((m) => has('month', m))
      .map((m) => ({ label: `${m.slice(0, 4)} / ${m.slice(5)}`, href: `/city/${city}/${m}`,
                     n: rows.filter((d) => d.at.slice(0, 7) === m).length })));

const sorted = rows.slice().sort((a, b) => a.at.localeCompare(b.at));
// 更早開始、這個月還在展的（build-data.mjs cityMonthPages 的 ongoing），一個活動列一次，先結束的排前面
const longRun = [...new Map(ongoing.map((d) => [d.slug, d])).values()].sort((a, b) => a.end.localeCompare(b.end));
// 上個月／下個月：只連有建、還沒過去的月份頁，月份往前走就自動換成下一組
const shift = (n) => new Date(Date.UTC(+sub.slice(0, 4), +sub.slice(5) - 1 + n, 1)).toISOString().slice(0, 7);
const monthNav = isMonth ? [[-1, '上個月'], [1, '下個月']].map(([n, label]) => ({ label, ym: shift(n) }))
  .filter((o) => has('month', o.ym)) : [];
const md = (iso) => `${+iso.slice(5, 7)}/${+iso.slice(8, 10)}`;
// 麵包屑：畫面與 BreadcrumbList 同一份（src/lib/jsonld/pages.mjs）
const trail = crumbTrail([{ name: '全部縣市', href: '/city' }, { name: city, href: `/city/${city}` }], title);
---
<Base
  title={`${title}有什麼文化活動｜seh`}
  description={past
    ? `${title}的文化活動、展覽與演出，共 ${events} 個活動。這個月份已經過去。`
    : ended
      ? `${title}最近的文化活動、展覽與演出，共 ${events} 個活動，目前都已結束。`
      : `${title}正在發生的文化活動、展覽與演出，共 ${events} 個活動${longRun.length ? `，另有 ${longRun.length} 個更早開始、這個月仍在進行的活動` : ''}。`
        + (venues.length ? `場地：${venues.slice(0, 3).map(([v]) => v).join('、')}。` : '')}
  noindex={past || thin}
  breadcrumbs={trail}
>
  <div class="shell">
    <Nav />
    <header class="page-hd">
      <Breadcrumb trail={trail} />
      <h1>{title}活動</h1>
      <p class="sub">
        <strong class="tabular">{events}</strong> 個活動、
        <span class="tabular">{rows.length}</span> 場次{isMonth ? '' : ended ? '，都已結束' : '正在或即將發生'}{longRun.length > 0 && `，另有 ${longRun.length} 個更早開始、這個月仍在進行的活動`}
      </p>
      {ended && <p class="sub">這一區目前沒有還沒結束的活動。<a href={`/city/${city}`}>看{city}接下來的活動</a></p>}
      {past && <p class="sub">這個月份已經過去。<a href={`/city/${city}`}>看{city}接下來的活動</a></p>}
      {monthNav.length > 0 && <p class="month-nav">{monthNav.map((o) => (
        <a href={`/city/${city}/${o.ym}`}>{o.label}：{+o.ym.slice(5)} 月</a>
      ))}</p>}
    </header>

    <div class="cols">
      <section>
        <h2 class="h-sm">活動</h2>
        <ol class="ev-list">
          {sorted.slice(0, 40).map((d) => (
            <li><a href={`/event/${d.slug}`}>
              <time class="ev-lead tabular" datetime={d.at}>
                {d.at.slice(5, 10).replace('-', '/')}{d.dateOnly ? '' : ` ${d.at.slice(11, 16)}`}
              </time>
              <span class="ev-body">
                <span class="ev-t">{d.title}</span>
                <span class="ev-m">{isMonth ? [d.district, d.venue].filter(Boolean).join('　') : d.venue}</span>
              </span>
              <span class="ev-cat" style={`color:var(${catVar(d.cat)})`}>{d.cat || ''}</span>
            </a></li>
          ))}
        </ol>
        {sorted.length > 40 && <p class="more">另有 {sorted.length - 40} 場次</p>}
        {sorted.length === 0 && longRun.length > 0 && <p class="more">這個月開始的活動還沒有收錄，下面是更早開始、這個月仍在進行的。</p>}

        {longRun.length > 0 && <>
          <h2 class="h-sm" style="margin-top:2rem">更早開始、這個月仍在進行</h2>
          <ol class="ev-list">
            {longRun.slice(0, 30).map((d) => (
              <li><a href={`/event/${d.slug}`}>
                <time class="ev-lead tabular" datetime={d.end}>到 {md(d.end)}</time>
                <span class="ev-body">
                  <span class="ev-t">{d.title}</span>
                  <span class="ev-m">{[d.district, d.venue].filter(Boolean).join('　')}</span>
                </span>
                <span class="ev-cat" style={`color:var(${catVar(d.cat)})`}>{d.cat || ''}</span>
              </a></li>
            ))}
          </ol>
          {longRun.length > 30 && <p class="more">另有 {longRun.length - 30} 個</p>}
        </>}
      </section>

      <aside class="side">
        <h2 class="h-sm">類型</h2>
        <ul class="tags">
          {cats.filter(([c]) => catPages.has(c)).map(([c, v]) => (
            <li><a href={`/category/${c}`} style={`color:var(${catVar(c)})`}>{c || '未分類'}<span class="tabular">{v}</span></a></li>
          ))}
        </ul>
        {others.length > 0 && (
          <>
            <h2 class="h-sm" style="margin-top:2rem">{isMonth ? '行政區' : '月份'}</h2>
            <ul class="tags">
              {others.map((o) => (<li><a href={o.href}>{o.label}<span class="tabular">{o.n}</span></a></li>))}
            </ul>
          </>
        )}
        <h2 class="h-sm" style="margin-top:2rem">常見場地</h2>
        <ul class="tags">
          {venues.map(([v, k]) => (<li><span class="vn">{v}<span class="tabular">{k}</span></span></li>))}
        </ul>
      </aside>
    </div>
  </div>
</Base>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 5%; padding-bottom: var(--space-9); }
  .h-sm { font-family: var(--font-body); font-weight: 700; font-size: var(--text-sm); color: var(--text-secondary); }
  .ev-list { margin-top: var(--space-4); }
  .more { margin-top: var(--space-4); font-size: var(--text-sm); color: var(--text-muted); }
  .month-nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: var(--space-4); font-size: var(--text-sm); }
  .tags { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .tags li { border-top: var(--hairline) solid var(--border-subtle); }
  .tags a, .tags .vn {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.55rem 0; text-decoration: none; font-size: var(--text-sm);
  }
  .tags .tabular { color: var(--text-muted); }
  @media (max-width: 860px) { .cols { grid-template-columns: minmax(0, 1fr); gap: var(--space-7); } }
</style>
