---
import Base from '../../layouts/Base.astro';
---
<Base title="方案 B：地圖依時間點亮" noindex={true}>
  <main class="page">
    <header class="hd">
      <p class="label">seh.tw</p>
      <h1>正在發生的台灣文化</h1>
    </header>

    <section class="viz">
      <svg id="map" preserveAspectRatio="xMidYMid meet" role="img" aria-label="今日活動地理分布"></svg>
      <aside class="side">
        <dl class="figs">
          <div><dt class="label">時刻</dt><dd class="fig-v tabular" id="clock">00:00</dd></div>
          <div><dt class="label">已開始</dt><dd class="fig-v tabular" id="lit">0</dd></div>
        </dl>
        <ul class="citylist" id="cities"></ul>
      </aside>
    </section>

    <footer class="ft">
      <div class="bar"><div class="bar-fill" id="bar"></div></div>
      <p class="ft-t" id="latest">—</p>
    </footer>
  </main>
</Base>

<script>
  import { select } from 'd3-selection';
  import { geoMercator, geoPath } from 'd3-geo';
  import { timer } from 'd3-timer';

  const css = (n) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const [geo, data] = await Promise.all([
    fetch('/tw-counties.json').then((r) => r.json()),
    fetch('/today.json').then((r) => r.json()),
  ]);

  // 同一場館多場活動會完全重疊，用標題 hash 產生穩定的微偏移把它們散開，
  // 讓「這裡活動多」看得出來，而不是糊成一個點。
  const jitter = (s, i) => {
    let h = 0;
    for (const ch of s) h = (h * 31 + ch.charCodeAt(0)) | 0;
    const a = ((h >>> i) % 360) * Math.PI / 180;
    const r = 2 + (((h >>> (i + 8)) % 100) / 100) * 5;
    return [Math.cos(a) * r, Math.sin(a) * r];
  };
  const pts = data
    .filter((d) => d.lat && d.lng && /^\d{2}:\d{2}$/.test(d.start))
    .map((d) => ({ ...d, mins: +d.start.slice(0, 2) * 60 + +d.start.slice(3), j: jitter(d.title, 0) }))
    .sort((a, b) => a.mins - b.mins);

  const W = 420, H = 620;
  const svg = select('#map').attr('viewBox', `0 0 ${W} ${H}`).attr('width', '100%');
  // 只用本島與澎湖決定投影範圍，離島不拉大版面
  const main = { type: 'FeatureCollection',
    features: geo.features.filter((f) => !['金門縣', '連江縣'].includes(f.properties.name)) };
  const proj = geoMercator().fitExtent([[24, 24], [W - 24, H - 24]], main);
  const path = geoPath(proj);

  svg.append('g').selectAll('path').data(geo.features).join('path')
    .attr('d', path)
    .attr('fill', css('--bg-surface'))
    .attr('stroke', css('--border-subtle'))
    .attr('stroke-width', 0.8);

  const layer = svg.append('g');
  const dots = layer.selectAll('circle').data(pts).join('circle')
    .attr('cx', (d) => (proj([d.lng, d.lat])?.[0] ?? -99) + d.j[0])
    .attr('cy', (d) => (proj([d.lng, d.lat])?.[1] ?? -99) + d.j[1])
    .attr('r', 0)
    .attr('fill', css('--color-link'))
    .attr('fill-opacity', 0.75);
  dots.append('title').text((d) => `${d.start}　${d.title}`);

  const now = new Date();
  const nowMins = now.getHours() * 60 + now.getMinutes();
  const clockEl = document.getElementById('clock');
  const litEl = document.getElementById('lit');
  const citiesEl = document.getElementById('cities');

  const barEl = document.getElementById('bar');
  const latestEl = document.getElementById('latest');

  function paint(mins) {
    barEl.style.width = `${(mins / 1440) * 100}%`;
    clockEl.textContent = `${String(Math.floor(mins / 60)).padStart(2, '0')}:${String(Math.floor(mins % 60)).padStart(2, '0')}`;
    let n = 0, latest = null;
    const byCity = new Map();
    dots.each(function (d) {
      const on = d.mins <= mins;
      if (on) {
        n++;
        byCity.set(d.city ?? '其他', (byCity.get(d.city ?? '其他') ?? 0) + 1);
        if (!latest || d.mins > latest.mins) latest = d;
      }
      const fresh = on && mins - d.mins < 30;
      select(this)
        .attr('r', on ? (fresh ? 7 : 3.6) : 0)
        .attr('fill', fresh ? css('--color-pass') : css('--color-link'))
        .attr('fill-opacity', on ? (fresh ? 0.9 : 0.4) : 0);
    });
    litEl.textContent = String(n);
    latestEl.textContent = latest ? `${latest.start}　${latest.title.slice(0, 30)}　${latest.venue}` : '—';
    citiesEl.innerHTML = [...byCity.entries()].sort((a, b) => b[1] - a[1]).slice(0, 7)
      .map(([c, v]) => `<li><span>${c}</span><span class="tabular">${v}</span></li>`).join('');
  }

  const DUR = 4200;
  let t = null;
  function play() {
    t?.stop();
    t = timer((el) => {
      const k = Math.min(1, el / DUR);
      paint(k * 1440);            // 跑完整天，軸走到底
      if (k === 1) {
        t.stop();
        setTimeout(() => {         // 再回到「現在」
          const back = timer((e2) => {
            const kk = Math.min(1, e2 / 700);
            paint(1440 - kk * (1440 - nowMins));
            if (kk === 1) { back.stop(); paint(nowMins); }
          });
        }, 700);
      }
    });
  }
  select('#map').on('click', play);

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) paint(nowMins);
  else play();
</script>

<style>
  .page {
    height: 100vh; height: 100dvh;
    display: grid; grid-template-rows: 16% 1fr 14%;
    padding-inline: 4%;
    overflow: hidden;
  }
  .hd { align-self: end; padding-bottom: 1.5%; }
  .hd h1 { font-size: clamp(1.75rem, 4.2vw, 3.5rem); margin-top: 0.6%; }
  .viz {
    min-height: 0;
    display: grid; grid-template-columns: 34% 1fr; gap: 4%;
    border-top: var(--hairline) solid var(--border-subtle);
    padding-top: 2%;
  }
  #map { width: 100%; height: 100%; min-height: 0; }
  .side { min-height: 0; display: flex; flex-direction: column; gap: 6%; }
  .figs { display: grid; grid-template-columns: 1fr 1fr; gap: 4%; margin: 0; max-width: 60%; }
  .fig-v {
    font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.75rem, 3.4vw, 3rem); line-height: 1; margin: 0.4rem 0 0;
  }
  .citylist {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 10%; align-content: start; max-width: 78%;
  }
  /* li 由 JS 插入，沒有 scope 屬性，必須用 :global 才會套到 */
  .citylist :global(li) {
    display: flex; gap: 1rem; width: 100%;
    padding-block: 0.5rem;
    border-top: var(--hairline) solid var(--border-subtle);
    font-size: var(--text-sm); color: var(--text-secondary);
  }
  .citylist :global(li span:last-child) { margin-left: auto; color: var(--text-primary); }
  .ft { align-self: center; }
  .bar { height: 3px; background: var(--bg-surface); }
  .bar-fill { height: 100%; width: 0; background: var(--color-link); }
  .ft-t {
    font-size: var(--text-sm); color: var(--text-secondary);
    margin-top: 2%; max-width: none;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  @media (max-width: 900px) {
    .viz { grid-template-columns: 1fr; grid-template-rows: 1fr auto; }
    .citylist { max-width: none; }
  }
</style>
