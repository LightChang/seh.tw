---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import PageHero from '../../components/PageHero.astro';
import { catVar } from '../../lib/format.mjs';
import { flatSessions } from '../../lib/build-data.mjs';

export async function getStaticPaths() {
  const all = await flatSessions();
  // 資料裡有 2015 年的常設展，全部出月曆頁會產生幾百個空月份。
  // 只出「上個月到一年後」這個區間裡真的有場次的月份。
  const now = new Date();
  const lo = new Date(now.getFullYear(), now.getMonth() - 1, 1).toISOString().slice(0, 7);
  const hi = new Date(now.getFullYear() + 1, now.getMonth(), 1).toISOString().slice(0, 7);
  // 網址一旦發出就不能變（CLAUDE.md）：站 2026-09-15 上線時已出了 2026-08 起的月份，
  // 比「上個月」更早的那些月份照樣建，只是 noindex。
  const FIRST = '2026-08';
  const months = [...new Set(all.map((d) => d.at.slice(0, 7)))]
    .filter((ym) => ym >= FIRST && ym <= hi).sort();
  return months.map((ym) => ({
    params: { ym }, props: { ym, rows: all.filter((d) => d.at.slice(0, 7) === ym), old: ym < lo },
  }));
}
const { ym, rows, old } = Astro.props;
const [y, m] = ym.split('-').map(Number);

const byDay = new Map();
for (const d of rows) {
  const k = d.at.slice(8, 10);
  if (!byDay.has(k)) byDay.set(k, []);
  byDay.get(k).push(d);
}
const first = new Date(y, m - 1, 1);
const days = new Date(y, m, 0).getDate();
const lead = (first.getDay() + 6) % 7; // 週一為首
const cells = [...Array(lead).fill(null), ...Array.from({ length: days }, (_, i) => i + 1)];
const maxN = Math.max(1, ...[...byDay.values()].map((v) => v.length));
const WD = ['一', '二', '三', '四', '五', '六', '日'];
---
<Base title={`${y} 年 ${m} 月活動行事曆｜seh`} description={`${y} 年 ${m} 月台灣的文化活動行事曆，共 ${rows.length} 場次。`} noindex={old}>
  <div class="shell">
    <Nav />
    <PageHero kicker="文化活動月曆" icon={'calendar'} tone="coral">
      <Fragment slot="title">{y} 年 {m} 月</Fragment>
      
      <p class="sub"><strong class="tabular">{rows.length}</strong> 場次</p>
    </PageHero>

    <div class="cal" role="table" aria-label={`${y} 年 ${m} 月行事曆`}>
      {WD.map((w) => <div class="wd" role="columnheader">{w}</div>)}
      {cells.map((d) => {
        if (!d) return <div class="cell empty" />;
        const key = String(d).padStart(2, '0');
        const list = byDay.get(key) ?? [];
        const level = list.length === 0 ? 0 : Math.ceil((list.length / maxN) * 3);
        return (
          <div class={`cell lv${level}`}>
            <span class="dn tabular">{d}</span>
            {list.length > 0 && <span class="cn tabular">{list.length}</span>}
            <ul class="mini">
              {list.slice(0, 2).map((e) => (
                <li><a href={`/event/${e.slug}`} style={`color:var(${catVar(e.cat)})`}>{e.title.slice(0, 10)}</a></li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>
</Base>
<style>
  .cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1px; margin: var(--space-5) 0 var(--space-9);
         background: var(--border-subtle); border-radius: var(--seh-radius); overflow: hidden; box-shadow: var(--seh-shadow); }
  .wd { background: var(--seh-forest); color: var(--seh-card); padding: 0.6rem; text-align: center; font-size: var(--text-xs); font-weight: 700; }
  .wd:nth-child(6), .wd:nth-child(7) { background: var(--seh-coral); color: var(--seh-ink); }
  /* min-width: 0 與 overflow: hidden：長標題不能把格子撐寬（原本會蓋到隔壁格、跑出月曆） */
  .cell { position: relative; min-width: 0; min-height: 7.5rem; padding: 0.55rem 0.6rem; overflow: hidden; background: var(--seh-card); }
  .cell.empty { background: var(--bg-surface); }
  .cell.lv1 { background: var(--seh-card); }
  .cell.lv2 { background: var(--seh-forest-weak); }
  .cell.lv3 { background: var(--seh-sun-weak); }
  .dn { font-size: var(--text-sm); font-weight: 800; color: var(--text-primary); }
  .cn { position: absolute; top: 0.55rem; right: 0.6rem; padding: 0 0.5em; border-radius: 999px;
        font-size: var(--text-xs); font-weight: 700; background: var(--seh-coral-weak); color: var(--seh-coral-deep); }
  .mini { list-style: none; margin: 0.4rem 0 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.2rem; }
  .mini li { min-width: 0; }
  .mini a { display: block; font-size: var(--text-xs); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mini a:hover { text-decoration: underline; }
  @media (max-width: 700px) {
    .cell { min-height: 4.5rem; padding: 0.4rem; }
    .mini { display: none; }
    .cn { position: static; display: inline-block; margin-top: 0.3rem; }
    .wd { padding: 0.4rem 0; }
  }
</style>
