---
// 我的文化收藏。內容全在訪客的瀏覽器（src/lib/saved.mjs），build 時只有外框。
// 每個人看到的不一樣、對搜尋引擎沒有內容，所以 noindex（sitemapNoindex 會把它從 sitemap 拿掉）。
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---
<Base title="我的文化收藏｜seh" description="你在 seh 收藏的活動、場館與文化資產。" noindex={true}>
  <div class="shell">
    <Nav current="saved" />
    <header class="page-hd">
      <p class="kicker">我的文化收藏</p>
      <h1>收藏</h1>
      <p class="sub" id="sub">收藏只存在這個瀏覽器裡，不需要登入；換裝置或清除網站資料就會不見。</p>
    </header>

    <div id="saved-root">
      <noscript><p class="empty-note">收藏功能需要開啟 JavaScript。</p></noscript>
    </div>

    <section class="empty" id="empty" hidden>
      <p class="empty-big">還沒有收藏</p>
      <p>在活動、場館或文化資產頁按「收藏」，就會出現在這裡。</p>
      <p class="empty-go"><a href="/today">看看今天有什麼 →</a><a href="/weekend">這週末</a><a href="/free">免費活動</a></p>
    </section>
  </div>
</Base>

<script>
  import { readSaved, removeSaved, toast } from '../lib/saved.mjs';

  const GROUPS = [
    { kind: 'event', label: '活動', path: '/event/' },
    { kind: 'venue', label: '場館', path: '/venue/' },
    { kind: 'heritage', label: '文化資產', path: '/heritage/' },
  ];
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const root = document.getElementById('saved-root')!;

  function render() {
    const list = readSaved();
    const now = Date.now();
    document.getElementById('empty')!.hidden = list.length > 0;
    root.innerHTML = GROUPS.map((g) => {
      // 還沒結束的在前（依收藏時間新到舊），已結束的沉到最後
      const items = list.filter((x) => x.kind === g.kind)
        .map((x) => ({ ...x, ended: x.endTs && x.endTs < now }))
        .sort((a, b) => (Number(a.ended) - Number(b.ended)) || (b.savedAt ?? 0) - (a.savedAt ?? 0));
      if (!items.length) return '';
      return `<section class="grp">
        <h2 class="grp-h">${g.label}<span class="tabular">${items.length}</span></h2>
        <ol class="saved-list">${items.map((x) => `
          <li class="${x.ended ? 'ended' : ''}">
            <a class="s-main" href="${g.path}${encodeURIComponent(x.slug)}">
              <span class="s-t">${esc(x.title)}</span>
              <span class="s-m">${[x.ended ? '<span class="tag">已結束</span>' : '', esc(x.when), esc(x.place)].filter(Boolean).join('　')}</span>
            </a>
            <button type="button" class="s-rm" data-kind="${esc(x.kind)}" data-slug="${esc(x.slug)}" aria-label="從收藏移除：${esc(x.title)}">移除</button>
          </li>`).join('')}
        </ol>
      </section>`;
    }).join('');
  }

  root.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.s-rm');
    if (!b) return;
    if (removeSaved(b.dataset.kind!, b.dataset.slug!)) { render(); toast('已從收藏移除'); }
  });
  // 別的分頁收藏或移除時同步
  addEventListener('storage', render);
  render();
</script>

<style>
  .grp { margin-top: var(--space-6); }
  .grp-h { display: flex; align-items: baseline; gap: var(--space-3); font-size: var(--text-lg); border-top: 2px solid var(--seh-ink); padding-top: var(--space-3); }
  .grp-h .tabular { font-size: var(--text-sm); color: var(--seh-terracotta); }
  .saved-list { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .saved-list li { display: flex; align-items: center; gap: var(--space-4); border-bottom: var(--hairline) solid var(--border-subtle); }
  .s-main { flex: 1; min-width: 0; padding: var(--space-4) 0; text-decoration: none; }
  .s-main:hover .s-t { color: var(--color-link); }
  .s-t { display: block; font-size: var(--text-sm); font-weight: 700; line-height: 1.45; }
  .s-m { display: block; margin-top: 4px; font-size: var(--text-xs); color: var(--text-secondary); }
  .ended .s-t { color: var(--text-muted); }
  .ended .tag { color: var(--text-muted); }
  .s-rm {
    flex: none; min-height: 44px; padding: 0 0.9rem; font: inherit; font-size: var(--text-xs); cursor: pointer;
    color: var(--text-secondary); background: none; border: var(--hairline) solid var(--border-subtle); border-radius: 999px;
  }
  .s-rm:hover { color: var(--seh-terracotta); border-color: var(--seh-terracotta); }
  .empty { margin-top: var(--space-6); padding: var(--space-7) var(--space-6); background: var(--bg-surface); border-radius: 3px; }
  .empty-big { font-size: var(--text-lg); font-weight: 800; }
  .empty p + p { margin-top: var(--space-2); color: var(--text-secondary); font-size: var(--text-sm); }
  .empty-go { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  .empty-go a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--text-secondary); }
  .empty-go a:first-child { color: var(--color-link); font-weight: 700; }
</style>
