---
// 我的探索：成就、去過的地方、收藏。內容全在訪客的瀏覽器（src/lib/saved.mjs），build 時只有外框。
// 成就由 src/lib/achievements.mjs 算，只看使用者自己按的「我去過了」。
// 每個人看到的不一樣、對搜尋引擎沒有內容，所以 noindex（sitemapNoindex 會把它從 sitemap 拿掉）。
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { ACHIEVEMENTS } from '../lib/achievements.mjs';
import { iconSvg } from '../lib/icons.mjs';
---
<Base title="我的探索｜seh" description="你在 seh 收藏與去過的活動、場館與文化資產，以及解鎖的探索成就。" noindex={true}>
  <div class="shell">
    <Nav current="saved" />
    <header class="page-hd">
      <p class="kicker">我的探索</p>
      <h1>收藏與探索紀錄</h1>
      <p class="sub" id="sub">收藏與打卡只存在這個瀏覽器裡，不需要登入；換裝置或清除網站資料就會不見。</p>
    </header>

    <section class="ach-sec" aria-labelledby="ach-h">
      <h2 class="grp-h" id="ach-h">探索成就<span class="tabular" id="ach-n"></span></h2>
      <p class="ach-note">在活動、場館或文化資產頁按「我去過了」打卡，累積成就。只有你自己按的才算。</p>
      <ul class="ach-grid">
        {ACHIEVEMENTS.map((a) => (
          <li class="ach" data-ach={a.key}>
            <span class="ach-icon" set:html={iconSvg(a.icon)} />
            <span class="ach-name">{a.name}</span>
            <span class="ach-desc">{a.desc}</span>
            <span class="ach-bar" aria-hidden="true"><span></span></span>
            <span class="ach-n tabular">0／{a.goal}</span>
          </li>
        ))}
      </ul>
    </section>

    <div id="visited-root"></div>

    <div id="saved-root">
      <noscript><p class="empty-note">收藏功能需要開啟 JavaScript。</p></noscript>
    </div>

    <section class="empty" id="empty" hidden>
      <p class="empty-big">還沒有收藏的地方</p>
      <p>在活動、場館或文化資產頁按「收藏」，就會出現在這裡。</p>
      <p class="empty-go"><a href="/today">看看今天有什麼 →</a><a href="/weekend">這週末</a><a href="/free">免費活動</a></p>
    </section>
  </div>
</Base>

<script>
  import { readSaved, removeSaved, readVisited, removeVisited, toast } from '../lib/saved.mjs';
  import { progress } from '../lib/achievements.mjs';

  const PATH: Record<string, string> = { event: '/event/', venue: '/venue/', heritage: '/heritage/' };
  const KIND: Record<string, string> = { event: '活動', venue: '場館', heritage: '文化資產' };
  const escV = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const ymd = (t: number) => { const d = new Date(t + 8 * 3600e3); return `${d.getUTCFullYear()}/${d.getUTCMonth() + 1}/${d.getUTCDate()}`; };

  function renderVisited() {
    const v = readVisited();
    // 成就
    const p = progress(v);
    for (const a of p) {
      const li = document.querySelector<HTMLElement>(`[data-ach="${a.key}"]`);
      if (!li) continue;
      li.classList.toggle('done', a.done);
      li.querySelector<HTMLElement>('.ach-bar span')!.style.width = `${(a.n / a.goal) * 100}%`;
      li.querySelector('.ach-n')!.textContent = a.done ? '已解鎖 🏅' : `${a.n}／${a.goal}`;
    }
    document.getElementById('ach-n')!.textContent = `${p.filter((a) => a.done).length}／${p.length}`;
    // 去過的地方
    const root = document.getElementById('visited-root')!;
    root.innerHTML = v.length ? `<section class="grp">
      <h2 class="grp-h">去過的地方<span class="tabular">${v.length}</span></h2>
      <ol class="saved-list">${v.map((x) => `
        <li>
          <a class="s-main" href="${PATH[x.kind] ?? '/'}${encodeURIComponent(x.slug)}">
            <span class="s-t">${escV(x.title)}</span>
            <span class="s-m">${[x.cat ? `<span class="ev-cat" data-cat="${escV(x.cat)}">${escV(x.cat)}</span>` : escV(KIND[x.kind] ?? ''), escV(x.city), `${ymd(x.visitedAt)} 打卡`].filter(Boolean).join('　')}</span>
          </a>
          <button type="button" class="s-rm v-rm" data-kind="${escV(x.kind)}" data-slug="${escV(x.slug)}" aria-label="取消打卡：${escV(x.title)}">取消打卡</button>
        </li>`).join('')}
      </ol></section>` : '';
  }
  document.getElementById('visited-root')!.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.v-rm');
    if (b && removeVisited(b.dataset.kind!, b.dataset.slug!)) { renderVisited(); toast('已取消打卡'); }
  });
  addEventListener('storage', renderVisited);
  renderVisited();

  const GROUPS = [
    { kind: 'event', label: '收藏的活動', path: '/event/' },
    { kind: 'venue', label: '收藏的場館', path: '/venue/' },
    { kind: 'heritage', label: '收藏的文化資產', path: '/heritage/' },
  ];
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const root = document.getElementById('saved-root')!;

  function render() {
    const list = readSaved();
    const now = Date.now();
    document.getElementById('empty')!.hidden = list.length > 0;
    root.innerHTML = GROUPS.map((g) => {
      // 還沒結束的在前（依收藏時間新到舊），已結束的沉到最後
      const items = list.filter((x) => x.kind === g.kind)
        .map((x) => ({ ...x, ended: x.endTs && x.endTs < now }))
        .sort((a, b) => (Number(a.ended) - Number(b.ended)) || (b.savedAt ?? 0) - (a.savedAt ?? 0));
      if (!items.length) return '';
      return `<section class="grp">
        <h2 class="grp-h">${g.label}<span class="tabular">${items.length}</span></h2>
        <ol class="saved-list">${items.map((x) => `
          <li class="${x.ended ? 'ended' : ''}">
            <a class="s-main" href="${g.path}${encodeURIComponent(x.slug)}">
              <span class="s-t">${esc(x.title)}</span>
              <span class="s-m">${[x.ended ? '<span class="tag">已結束</span>' : '', esc(x.when), esc(x.place)].filter(Boolean).join('　')}</span>
            </a>
            <button type="button" class="s-rm" data-kind="${esc(x.kind)}" data-slug="${esc(x.slug)}" aria-label="從收藏移除：${esc(x.title)}">移除</button>
          </li>`).join('')}
        </ol>
      </section>`;
    }).join('');
  }

  root.addEventListener('click', (ev) => {
    const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('.s-rm');
    if (!b) return;
    if (removeSaved(b.dataset.kind!, b.dataset.slug!)) { render(); toast('已從收藏移除'); }
  });
  // 別的分頁收藏或移除時同步
  addEventListener('storage', render);
  render();
</script>

<style is:global>
  .grp { margin-top: var(--space-6); }
  .ach-sec { margin-top: var(--space-5); }
  .ach-note { margin-top: var(--space-2); font-size: var(--text-xs); color: var(--text-secondary); }
  .ach-grid { list-style: none; margin: var(--space-4) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); gap: var(--space-3); }
  .ach { display: grid; gap: 4px; padding: var(--space-4); border-radius: var(--seh-radius); background: var(--seh-card); box-shadow: var(--seh-shadow); color: var(--text-muted); }
  .ach-icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--bg-surface); margin-bottom: var(--space-2); }
  .ach-icon svg { width: 30px; height: 30px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ach-name { font-size: var(--text-sm); font-weight: 800; color: var(--text-secondary); }
  .ach-desc { font-size: var(--text-xs); }
  .ach-bar { height: 8px; margin-top: var(--space-2); border-radius: 999px; background: var(--bg-surface); overflow: hidden; }
  .ach-bar span { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--seh-coral); transition: width 0.4s; }
  .ach-n { font-size: var(--text-xs); font-weight: 700; }
  .ach.done { color: var(--text-primary); }
  .ach.done .ach-icon { background: var(--seh-sun); color: var(--seh-ink); }
  .ach.done .ach-name { color: var(--seh-forest); }
  .ach.done .ach-bar span { background: var(--seh-forest); }
  .ach.done .ach-n { color: var(--seh-forest); }
  .grp-h { display: flex; align-items: baseline; gap: var(--space-3); font-size: var(--text-lg); border-top: 2px solid var(--seh-ink); padding-top: var(--space-3); }
  .grp-h .tabular { font-size: var(--text-sm); color: var(--seh-coral-deep); }
  .saved-list { list-style: none; margin: var(--space-3) 0 0; padding: 0; }
  .saved-list li { display: flex; align-items: center; gap: var(--space-4); border-bottom: var(--hairline) solid var(--border-subtle); }
  .s-main { flex: 1; min-width: 0; padding: var(--space-4) 0; text-decoration: none; }
  .s-main:hover .s-t { color: var(--color-link); }
  .s-t { display: block; font-size: var(--text-sm); font-weight: 700; line-height: 1.45; }
  .s-m { display: block; margin-top: 4px; font-size: var(--text-xs); color: var(--text-secondary); }
  .ended .s-t { color: var(--text-muted); }
  .ended .tag { color: var(--text-muted); }
  .s-rm {
    flex: none; min-height: 44px; padding: 0 0.9rem; font: inherit; font-size: var(--text-xs); cursor: pointer;
    color: var(--text-secondary); background: none; border: var(--hairline) solid var(--border-subtle); border-radius: 999px;
  }
  .s-rm:hover { color: var(--seh-coral-deep); border-color: var(--seh-coral-deep); }
  .empty { margin-top: var(--space-6); padding: var(--space-7) var(--space-6); background: var(--bg-surface); border-radius: 3px; }
  .empty-big { font-size: var(--text-lg); font-weight: 800; }
  .empty p + p { margin-top: var(--space-2); color: var(--text-secondary); font-size: var(--text-sm); }
  .empty-go { display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  .empty-go a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--text-secondary); }
  .empty-go a:first-child { color: var(--color-link); font-weight: 700; }
</style>
